    if (!primero) return
    var izq = primero.getBoundingClientRect().left - b.left
    paneles.forEach(function (p) {
      var ancho = ANCHOS[p.getAttribute("data-pxnav-panel")] || 861
      // Sin salirse de la pantalla en monitores chicos.
      ancho = Math.min(ancho, window.innerWidth - 48)
      var left = izq
      var derAbs = b.left + left + ancho
      if (derAbs > window.innerWidth - 24) left -= derAbs - (window.innerWidth - 24)
      p.style.left = left + "px"
      p.style.width = ancho + "px"
    })
  }

  disparadores.forEach(function (t) {
    t.addEventListener("click", function (e) {
      e.preventDefault()
      e.stopPropagation()
      var id = t.getAttribute("data-pxnav-menu")
      abierto = abierto === id ? null : id
      pintar()
    })
  })

  $$("[data-pxnav-close]").forEach(function (el) {
    el.addEventListener("click", function () { abierto = null; pintar() })
  })

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && abierto !== null) {
      abierto = null
      pintar()
    }
  })

  // ── Segmento del panel de productos (Hoteles / Vacation Rentals) ───────────
  // La esquina de unión del bloque de listas sigue a la tarjeta activa, así el
  // panel se lee como una sola pieza con la tarjeta elegida.
  $$("[data-pxnav-seg]").forEach(function (card) {
    card.addEventListener("click", function (e) {
      e.stopPropagation()
      var seg = card.getAttribute("data-pxnav-seg")
      $$("[data-pxnav-seg]").forEach(function (c) {
        var on = c.getAttribute("data-pxnav-seg") === seg
        c.classList.toggle("--on", on)
        c.classList.toggle("--off", !on)
        c.setAttribute("aria-pressed", on ? "true" : "false")
      })
      $$("[data-pxnav-list]").forEach(function (l) {
        l.hidden = l.getAttribute("data-pxnav-list") !== seg
      })
      var caja = raiz.querySelector("[data-pxnav-join]")
      if (caja) caja.classList.toggle("--join-bottom", seg === "vr")
    })
  })

  // ── Estados de la barra ────────────────────────────────────────────────────
  var claros = []
  function releerClaros() {
    // `[data-nav="light"]` es el contrato explícito del handoff: si una página marca
    // sus secciones, mandan ellas. Es solo un OVERRIDE — el caso normal lo resuelve
    // la detección automática de abajo.
    claros = [].slice.call(document.querySelectorAll('[data-nav="light"]'))
  }

  /**
   * ¿Qué tan claro es lo que se ve DETRÁS de la barra?
   *
   * No se puede depender de que la página marque sus secciones: ninguna lo hace, y
   * el resultado fue un navbar blanco sobre el fondo blanco de las páginas de
   * producto — ilegible, reportado por Sofi el 06/08/2026. Así que se mira el color
   * real: se toman tres puntos y, en cada uno, se busca el primer elemento con
   * fondo opaco.
   *
   * Los puntos van a la ALTURA DEL CONTENIDO de la barra (su línea media), que es
   * donde están el logo y los links y por lo tanto lo único que tiene que ser
   * legible. La primera versión medía 6px POR DEBAJO del borde de la barra, y eso
   * miente en cuanto el hero oscuro no arranca en el borde de la ventana: las
   * páginas migradas llevan el hero con 12px de margen, así que detrás de la barra
   * queda la franja blanca de `.pxsite` mientras el punto de muestreo ya cae dentro
   * del hero. Medido el 08/08/2026 en la página de Agentes de IA
   * (`/ai-agentes-personalizados-para-tu-alojamiento`), que fue donde lo reportó
   * Sofi: detrás de la barra lum 0.97 (el blanco de `.pxsite`) y 6px más abajo lum
   * 0.01 (el hero) — el navbar salía blanco sobre blanco.
   *
   * Sólo cambia el estado de ARRIBA DE TODO: a partir de ~40px de scroll el hero ya
   * ocupa el fondo de la barra y las dos mediciones vuelven a coincidir.
   *
   * Se saltean los elementos del propio header (está fixed y tapa esos puntos) y
   * los fondos transparentes, que no pintan nada.
   */
  function fondoDetrasEsClaro() {
    var b = barra.getBoundingClientRect()
    var y = (b.top + b.bottom) / 2
    var xs = [b.left + 60, (b.left + b.right) / 2, b.right - 60]
    var claros_ = 0
    var vistos = 0
    for (var i = 0; i < xs.length; i++) {
      var lum = luminanciaEn(xs[i], y)
      if (lum === null) continue
      vistos++
      if (lum > 0.62) claros_++
    }
    // Con el borde de una sección clara justo detrás, alcanza con que la mayoría de
    // los puntos lo sea: si no, el header parpadearía en la transición.
    return vistos > 0 && claros_ * 2 >= vistos
  }

  function luminanciaEn(x, y) {
    if (!document.elementsFromPoint) return null
    var pila = document.elementsFromPoint(x, y)
    for (var i = 0; i < pila.length; i++) {
      var el = pila[i]
      if (raiz.contains(el) || el === raiz) continue
      var lum = luminanciaDe(getComputedStyle(el).backgroundColor)
      if (lum !== null) return lum
    }
    // Ninguna capa pinta nada en ese punto: lo que se ve es el lienzo del
    // navegador, o sea el fondo del body, y si tampoco lo pinta, blanco. Sin este
    // fallback la página se contaba como "sin dato" y el estado claro no se
    // activaba: es el caso de /precios, que no tiene ningún contenedor opaco arriba.
    var delBody = luminanciaDe(getComputedStyle(document.body).backgroundColor)
    return delBody === null ? 1 : delBody
  }

  /** Luminancia relativa aproximada de un color CSS; null si no pinta (translúcido). */
  function luminanciaDe(col) {
    var m = /rgba?\(([^)]+)\)/.exec(col)
    if (!m) return null
    var p = m[1].split(",")
    var a = p.length > 3 ? parseFloat(p[3]) : 1
    if (!(a > 0.5)) return null // translúcido: deja ver lo de atrás, no decide
    return (0.2126 * +p[0] + 0.7152 * +p[1] + 0.0722 * +p[2]) / 255
  }

  /**
   * Recoger la barra es lo ÚNICO que se resuelve en todos los frames: comparar
   * `scrollY` contra dos números y togglear una clase no cuesta nada.
   *
   * Acá NO hay coreografía, y es a propósito. Hubo una versión con una segunda
   * clase para el contenido y un `setTimeout` que lo hacía esperar a la caja:
   * hacía falta porque los dos estados tenían textos de ancho distinto y,
   * mientras la caja se anima, contenido y caja no pueden coincidir. Desde el
   * 29/08/2026 los dos estados dicen lo mismo (ver el comentario del CSS), así
   * que no queda nada que sincronizar: el contenido entra en la caja chica y en
   * la grande, y lo único que cambia además del ancho es el logo, que salta.
   *
   * Si alguna vez vuelven textos distintos en los dos estados, esto deja de
   * alcanzar — lo cuida `navbar-compresion.test.ts`.
   */
  function actualizarPegada() {
    var y = window.scrollY
    var antes = wrap.classList.contains("--stuck")
    if (y > UMBRAL_ENTRADA) wrap.classList.add("--stuck")
    else if (y < UMBRAL_SALIDA) wrap.classList.remove("--stuck")
    return wrap.classList.contains("--stuck") !== antes
  }

  /**
   * El estado claro, en cambio, es CARO: `fondoDetrasEsClaro()` hace tres
   * `elementsFromPoint`, y cada uno obliga al navegador a recalcular el layout de
   * la página entera. Corriéndolo en cada frame de scroll —que es lo que hacía
   * antes— se le come al hilo principal justo los milisegundos en los que la barra
   * tiene que animarse, y la transición sale a los tirones.
   *
   * El color de fondo de una sección no cambia dentro de 100ms de scroll, así que
   * muestrear cada 100ms se ve idéntico y cuesta seis veces menos. Lo que NO puede
   * esperar es el frame en el que la barra se recoge —cambia de alto y de ancho,
   * o sea se mueven los tres puntos de muestreo— ni el arranque: van forzados.
   */
  var MUESTREO_MS = 100
  var ultimoMuestreo = -Infinity
  function actualizarClaro(forzar) {
    var ahora = Date.now()
    if (!forzar && ahora - ultimoMuestreo < MUESTREO_MS) return
    ultimoMuestreo = ahora
    var b = barra.getBoundingClientRect()
    var marcada = claros.some(function (el) {
      var r = el.getBoundingClientRect()
      return r.top < b.bottom - 4 && r.bottom > b.top + 4
    })
    wrap.classList.toggle("--light", marcada || fondoDetrasEsClaro())
  }

  function sincronizar(forzar) {
    var cambio = actualizarPegada()
    actualizarClaro(forzar || cambio)
    // Reubicar los paneles sólo tiene sentido si hay uno abierto. Antes corría
    // siempre, y `ubicar()` ESCRIBE `style.left`/`style.width` en los tres paneles
    // inmediatamente después de leer geometría: leer-escribir-leer en el mismo
    // frame invalida el layout una y otra vez, y encima cada frame de scroll.
    if (abierto !== null) ubicar()
  }

  // Un solo listener de scroll, pasivo y limitado a UN cálculo por frame. Dentro
  // de ese frame va lo barato siempre (recoger la barra) y lo caro con
  // cuentagotas (el muestreo de color) — ver `sincronizar`.
  var pendiente = false
  function alScrollear() {
    if (pendiente) return
    pendiente = true
    requestAnimationFrame(function () {
      pendiente = false
      sincronizar()
    })
  }
  window.addEventListener("scroll", alScrollear, { passive: true })
  window.addEventListener("resize", function () { releerClaros(); sincronizar(true) })
  // Los dos de abajo existen porque el ancho de la barra cambia CON ANIMACIÓN y un
  // offset calculado al abrir queda viejo enseguida. Pero si no hay ningún panel
  // abierto no hay nada que reubicar, y el ResizeObserver disparaba en CADA frame
  // de esa animación: era thrashing de layout compitiendo contra la animación que
  // el navegador estaba tratando de dibujar.
  barra.addEventListener("transitionend", function () { if (abierto !== null) ubicar() })
  if (window.ResizeObserver) {
    new ResizeObserver(function () { if (abierto !== null) ubicar() }).observe(barra)
  }

  releerClaros()
  pintar()
  sincronizar(true)

  /**
   * Las secciones claras hay que volver a buscarlas cuando el body terminó de
   * parsearse.
   *
   * El <script> del módulo se inyecta DENTRO del wrapper del header, o sea arriba
   * de todo: cuando corre, el resto de la página todavía no existe y el
   * querySelectorAll de arriba devuelve CERO. El síntoma es que el estado claro
   * simplemente nunca se activa, sin ningún error en consola — se ve igual que si
   * la detección estuviera mal escrita. Medido en la preview el 06/08/2026:
   * `solapa: true` y aun así la clase --light no se ponía.
   */
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () {
      releerClaros()
      sincronizar(true)
    })
  }
})()
</script></div><main><section class="hero" aria-labelledby="emb-titulo"><div class="foto" aria-hidden="true"></div><div class="velo" aria-hidden="true"></div><div class="wrap"><div class="texto"><h1 id="emb-titulo">Tu recomendación vale hasta<!-- --> <b>3X</b></h1><p class="bajada">Para consultores, profesionales y empresas de la hotelería que ya recomiendan Pxsol. Por cada hotel que se suma, cobrás tres meses de su cartera.</p><a class="btn btn-rojo" href="#sumarme">Quiero ser embajador</a><div class="quien"><img src="/embajadores/cynthia-maciel.webp" alt="" width="44" height="44"/><span>Te atiende <b>Cynthia Maciel</b>, líder del programa</span></div></div><div class="notif" aria-hidden="true"><div class="ic"><img src="/forms/pxsol-isotipo.svg" alt="" width="26" height="24"/></div><div><b>Pxsol <span>ahora</span></b><p>Hotel Las Lengas se sumó a Pxsol. Quedó registrado como referido tuyo.</p></div></div></div></section><section class="sec" aria-label="El programa"><div class="wrap"><p class="manif" data-r="">Vos <b>recomendás</b> Pxsol en tu red, el hotel <b>se suma</b> y nuestro equipo acompaña la venta. Vos<!-- --> <b>cobrás tres meses</b> de su cartera <span class="x">×3</span></p><p class="sub" data-r="">Es un canal de venta para quienes conocen la hotelería desde adentro: te reconocemos por cada hotel que llega gracias a vos.</p></div></section><section class="sec" aria-labelledby="emb-perfiles"><div class="wrap perf"><div class="lado" data-r="izq"><h2 id="emb-perfiles" class="h2">Pensado para quienes <b>ya son referencia</b></h2><p>Si los hoteleros te consultan antes de decidir, ya hacés el trabajo de un embajador.</p></div><ul><li data-r="der" style="--d:0s"><h3>Consultores hoteleros</h3><p>Asesorás a hoteles en gestión, tecnología o crecimiento.</p></li><li data-r="der" style="--d:0.09s"><h3>Profesionales del sector</h3><p>Tenés experiencia, contactos y la confianza de otros hoteleros.</p></li><li data-r="der" style="--d:0.18s"><h3>Empresas de tecnología</