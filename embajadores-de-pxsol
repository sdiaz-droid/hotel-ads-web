  var $ = function (sel, ctx) { return (ctx || raiz).querySelector(sel) }
  var $$ = function (sel, ctx) { return Array.prototype.slice.call((ctx || raiz).querySelectorAll(sel)) }
  var escapaId = function (v) {
    return window.CSS && CSS.escape ? CSS.escape(v) : String(v).replace(/[^\w-]/g, "")
  }

  // ── Mega-menú desktop ──────────────────────────────────────────────────────
  var enlaces = $$('.js-menu-link:not([data-type="link"])')
  var secciones = $$(".js-menu-section")

  function cerrarSecciones() {
    secciones.forEach(function (s) { s.classList.add("d-none") })
    enlaces.forEach(function (l) { l.classList.remove("--active") })
  }

  enlaces.forEach(function (enlace) {
    enlace.addEventListener("click", function (e) {
      e.preventDefault()
      var seccion = $("#menu-" + escapaId(enlace.dataset.menuId || ""))
      // Volver a clickear el mismo ítem lo cierra: es el `toggleClass` del original.
      var estabaAbierta = !!seccion && !seccion.classList.contains("d-none")
      cerrarSecciones()
      if (seccion && !estabaAbierta) {
        seccion.classList.remove("d-none")
        enlace.classList.add("--active")
      }
