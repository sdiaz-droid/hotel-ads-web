[data-pxsol-global="header"] .pxband__go { margin-left: auto; display: inline-flex; align-items: center; color: var(--pxnav-fg); }
[data-pxsol-global="header"] .pxband__go svg { width: 16px; height: 16px; }



/* ── Mobile ──────────────────────────────────────────────────────────────────
   El handoff es de escritorio (1728px) y no cubre mobile, así que abajo de
   1100px sigue mandando el menú mobile que ya existía: se esconden los links y
   las acciones, y queda logo + hamburguesa. */
[data-pxsol-global="header"] .pxnav__burger {
  display: none;
  flex: none;
  width: 40px;
  height: 40px;
  margin-left: auto;
  padding: 11px 9px;
  border: 0;
  background: none;
  cursor: pointer;
}
[data-pxsol-global="header"] .pxnav__burger span {
  display: block;
  height: 2px;
  margin-bottom: 5px;
  border-radius: 2px;
  background: #fff;
  transition: background var(--pxnav-dur) var(--pxnav-ease);
}
[data-pxsol-global="header"] .pxnav__burger span:last-child { margin-bottom: 0; }
[data-pxsol-global="header"] .pxnav-wrap.--light .pxnav__burger span { background: var(--pxnav-ink); }

/* El diseño se dibujó sobre 1728px de ancho. Abajo de eso el contenido no entra:
   medido en producción a 1512, ocupaba 1417,8 contra 1392 útiles y los botones
   quedaban 62,8px FUERA de la pantalla. Se recupera en dos pasos —primero gap y
   padding, después los labels cortos— antes de caer en la hamburguesa. */
@media (max-width: 1727px) {
  [data-pxsol-global="header"] .pxnav { padding: 0 40px; max-width: min(1728px, max(1260px, calc(100% - 96px))); }
  /* Acá el contenido mide 1235px: la píldora baja en la misma proporción. */
  [data-pxsol-global="header"] .pxnav-wrap.--stuck .pxnav { max-width: 1260px; }
  [data-pxsol-global="header"] .pxnav__nav { gap: 24px; margin-left: 28px; }
}
@media (max-width: 1500px) {
  [data-pxsol-global="header"] .pxnav { padding: 0 28px; max-width: min(1728px, max(1128px, calc(100% - 96px))); }
  /* Y acá 1101px. */
  [data-pxsol-global="header"] .pxnav-wrap.--stuck .pxnav { max-width: 1128px; }
  [data-pxsol-global="header"] .pxnav__nav { gap: 14px; margin-left: 20px; }
  /* Los labels cortos también sin scrollear: son los que hacen entrar las cinco
     entradas, y es preferible a apretar la tipografía. El corte va en 1500 y no
     en 1400 porque, medido, con los labels largos el contenido ocupa 1383,8px y
     necesita 1464 de viewport: a 1440 los botones se salían 52,8px. */
  [data-pxsol-global="header"] .pxnav__lab-l { display: none; }
  [data-pxsol-global="header"] .pxnav__lab-s { display: inline; }
  [data-pxsol-global="header"] .pxnav__item { padding: 10px 14px 10px 12px; }
}

/* El último tramo antes de la hamburguesa. Acá el contenido casi llena la
   pantalla, y como el padding ya NO se achica al recogerse (antes bajaba a 20px
   y liberaba 36), a 1101px de viewport se desbordaba 5px. Medido. */
@media (max-width: 1250px) {
  [data-pxsol-global="header"] .pxnav { padding: 0 14px; }
}

@media (max-width: 1100px) {
  [data-pxsol-global="header"] .pxnav { padding: 0 16px; }
  [data-pxsol-global="header"] .pxnav__nav,
  [data-pxsol-global="header"] .pxnav__cta { display: none; }
  [data-pxsol-global="header"] .pxnav__burger { display: block; }
  /* En mobile el logotipo completo se queda: no hay links que recentrar. */
  [data-pxsol-global="header"] .pxnav-wrap.--stuck .pxnav__logo--full { max-width: 120px; }
  [data-pxsol-global="header"] .pxnav-wrap.--stuck .pxnav__logo--iso { max-width: 0; }
}

@media (prefers-reduced-motion: reduce) {
  [data-pxsol-global="header"] .pxnav-wrap,
  [data-pxsol-global="header"] .pxnav,
  [data-pxsol-global="header"] .pxnav__logo,
  [data-pxsol-global="header"] .pxnav__nav,
  [data-pxsol-global="header"] .pxnav__item,
  [data-pxsol-global="header"] .pxnav__btn,
  [data-pxsol-global="header"] .pxnav__chev,
  [data-pxsol-global="header"] .pxnav-drop,
  [data-pxsol-global="header"] .pxcard__thumb img { transition-duration: 1ms; }
}

/* ── Los paneles, en claro ───────────────────────────────────────────────────
   El desplegable tiene que ser del mismo color que la barra: con el header en
   claro, un panel negro se lee como de otra página (Sofi, 07/08/2026). */
[data-pxsol-global="header"] .pxnav-wrap.--light .pxpanel,
[data-pxsol-global="header"] .pxnav-wrap.--light .pxnav-drop .px-headerSection {
  background: #FFFFFF !important;
  border-color: rgba(0, 0, 23, .10);
  box-shadow: 0 24px 60px rgba(0, 0, 23, .18);
}
[data-pxsol-global="header"] .pxnav-wrap.--light .pxpanel__lists,
[data-pxsol-global="header"] .pxnav-wrap.--light .pxcard.--on,
[data-pxsol-global="header"] .pxnav-wrap.--light .pxband__bar,
[data-pxsol-global="header"] .pxnav-wrap.--light .pxnav-drop .px-headerSectionCards__card {
  background: #F4F5F8 !important;
}
[data-pxsol-global="header"] .pxnav-wrap.--light .pxband__bar:hover { background: #EAECF2 !important; }
[data-pxsol-global="header"] .pxnav-wrap.--light .pxcard__ttl,
[data-pxsol-global="header"] .pxnav-wrap.--light .pxlist a,
[data-pxsol-global="header"] .pxnav-wrap.--light .pxband__ttl,
[data-pxsol-global="header"] .pxnav-wrap.--light .pxnav-drop .px-headerSectionCards__cardTitle,
[data-pxsol-global="header"] .pxnav-wrap.--light .pxnav-drop .px-headerSectionCards__cardButton {
  color: var(--pxnav-ink) !important;
}
[data-pxsol-global="header"] .pxnav-wrap.--light .pxcard__desc,
