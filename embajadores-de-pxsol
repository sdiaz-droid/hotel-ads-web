   if (chevron) chevron.classList.toggle(\"--rotate\", abierta)\n  }\n\n  function alternar(titulo) {\n    if (!mql.matches) return\n    var lista = listaDe(titulo)\n    if (!lista) return\n    var abrir = !estaAbierta(lista)\n\n    /* Una sola columna abierta por bloque, como en el tema. */\n    var bloque = titulo.closest(\".px-footer__groups\")\n    if (bloque) {\n      titulos.forEach(function (otro) {\n        if (otro === titulo || otro.closest(\".px-footer__groups\") !== bloque) return\n        var suLista = listaDe(otro)\n        if (suLista) pintar(otro, suLista, false)\n      })\n    }\n\n    pintar(titulo, lista, abrir)\n  }\n\n  /* Envuelve TODO lo que tiene el título (texto + chevron) en un botón. */\n  function armarBoton(titulo, lista) {\n    if (botonDe(titulo)) return\n    var boton = document.createElement(\"button\")\n    boton.type = \"button\"\n    boton.className = CLASE_BOTON\n    boton.style.cssText = ESTILO_BOTON\n    if (lista.id) boton.setAttribute(\"aria-controls\", lista.id)\n    boton.setAttribute(\"aria-expanded\", estaAbierta(lista) ? \"true\" : \"false\")\n    while (titulo.firstChild) boton.appendChild(titulo.firstChild)\n    titulo.appendChild(boton)\n    boton.addEventListener(\"click\", function () {\n      alternar(titulo)\n    })\n  }\n\n  /* Deshace armarBoton: los hijos vuelven al título y el botón desaparece. */\n  function desarmarBoton(titulo) {\n    var boton = botonDe(titulo)\n    if (!boton) return\n    while (boton.firstChild) titulo.insertBefore(boton.firstChild, boton)\n    titulo.removeChild(boton)\n  }\n\n  /* El botón y sus atributos de ARIA sólo existen mientras haya acordeón. */\n  function sincronizar() {\n    titulos.forEach(function (titulo) {\n      var lista = listaDe(titulo)\n      if (!lista) return\n      if (mql.matches) {\n        armarBoton(titulo, lista)\n      } else {\n        pintar(titulo, lista, false)\n        desarmarBoton(titulo)\n      }\n    })\n  }\n\n  sincronizar()\n  if (mql.addEventListener) mql.addEventListener(\"change\", sincronizar)\n  else if (mql.addListener) mql.addListener(sincronizar)\n})()\n"])</script><script>self.__next_f.push([1,"5:[\"$\",\"$L14\",null,{\"embajadores\":[],\"esMuestra\":false,\"chrome\":{\"header\":{\"html\":\"$15\",\"css\":\"$16\",\"js\":\"$17\"},\"footer\":{\"html\":\"$18\",\"css\":\"$19\",\"js\":\"$1a\"}}}]\n"])</script></body></html>