}
[data-pxsol-global="header"] .pxlist ul > li:first-child .pxlist__cap { padding-top: 0; }
/* El único lugar del header donde se usa Inter; todo el resto es Work Sans. */
[data-pxsol-global="header"] .pxbadge {
  margin-left: 2px;
  padding: 0 8px;
  border-radius: 999px;
  background: #1F8A5B;
  font-family: Inter, "Work Sans", sans-serif;
  font-size: 9.5px;
  font-weight: 600;
  line-height: 18px;
  letter-spacing: .08em;
  color: #fff;
}

/* ── Banda de Pagos e Integraciones ──────────────────────────────────────── */
[data-pxsol-global="header"] .pxband { display: flex; gap: 10px; }
[data-pxsol-global="header"] .pxband__bar {
  flex: 1;
  min-width: 0;
  height: 44px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 18px;
  border-radius: 12px;
  background: var(--pxnav-card);
