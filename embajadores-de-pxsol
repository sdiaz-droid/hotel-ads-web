  })

  // Cerrar al clickear afuera. El original recorría los ancestros buscando
  // `js-wrapper-menu` / `js-menu-section`; con `closest` es lo mismo.
  if (secciones.length) {
    document.addEventListener("click", function (e) {
      if (!(e.target instanceof Element)) return
      if (e.target.closest(".js-wrapper-menu") || e.target.closest(".js-menu-section")) return
      cerrarSecciones()
    })
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") cerrarSecciones()
    })
  }

  // ── Tabs internas de cada grupo de secciones ───────────────────────────────
  $$(".js-menu-section-group").forEach(function (grupo) {
    $$(".js-button", grupo).forEach(function (boton) {
      boton.addEventListener("click", function () {
        var id = boton.dataset.id
        $$(".js-item-content, .js-item-menu", grupo).forEach(function (el) {
          el.classList.remove("--selected")
