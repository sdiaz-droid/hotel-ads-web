}

/* ── Header ──────────────────────────────────────────────────────────────── */
/* ⚠ SIN USO desde el 06/08/2026. Este bloque (.hdr, .mega, .mnav) y el del footer
   (.foot) estilaban a SiteHeader/SiteFooter, los componentes React que montaban el
   menú del sitio en las páginas nativas. Precios era la última que los usaba y pasó
   al MÓDULO GLOBAL, así que los componentes se borraron.

   El CSS queda por ahora porque SITE_SHELL_CSS es un solo template literal que TODAS
   las públicas inyectan por sus tokens .pxsite, y recortarlo es un cambio aparte.
   Ninguna regla de acá matchea nada hoy, y no pisa al módulo global: ese va scopeado
   bajo el atributo data-pxsol-global. Al limpiarlo, revisar site-shell-css.test.ts. */
.pxsite .hdr{position:sticky;top:0;z-index:60;background:#fff;border-bottom:1px solid transparent;}
.pxsite .hdr.is-stuck{border-bottom-color:var(--stroke);box-shadow:0 8px 24px -20px rgba(1,14,61,.45);}
/* La BARRA es el ancla de los paneles del megamenú (ver el comentario de '.mega'):
   sin este 'position:relative' el panel se posiciona contra '.hdr', que es
   full-bleed, y los paneles '--right' se pegan al borde de la ventana en vez del
   contenedor. */
.pxsite .hdr .bar{max-width:1400px;margin:0 auto;padding:0 28px;height:64px;display:flex;align-items:center;gap:34px;position:relative;}
.pxsite .hdr .brand{display:flex;align-items:center;flex:none;}
.pxsite .hdr .brand img{width:74px;height:36px;}
.pxsite .hdr .nav{display:flex;align-items:center;gap:6px;}
/* Los ítems de la nav NO pueden ser 'position:relative': si lo son, el panel del
   megamenú ('.mega', absoluto) se ancla AL BOTÓN en vez de a la barra, y como es de
   1180px centrado ('left:50%' + 'translateX(-50%)') arranca ~300px FUERA de la
   pantalla por la izquierda y sale recortado. Le pasaba a los tres paneles cuyo
   botón está a menos de 590px del borde (reportado el 03/08/2026 sobre
   /es-ar/producto/pos-para-hoteles). */
.pxsite .hdr .nav>*{position:static;}
.pxsite .hdr .navlink{display:inline-flex;align-items:center;gap:6px;font-size:14.5px;color:var(--title);padding:10px 12px;border-radius:10px;background:none;border:0;cursor:pointer;font-family:var(--ui);transition:color .15s var(--ease),background .15s var(--ease);}
.pxsite .hdr .navlink .chev{width:12px;height:12px;transition:transform .2s var(--ease);}
.pxsite .hdr .navlink[aria-expanded="true"]{color:var(--mint-ink);}
.pxsite .hdr .navlink[aria-expanded="true"] .chev{transform:rotate(180deg);}
@media (hover:hover) and (pointer:fine){.pxsite .hdr .navlink:hover{color:var(--mint-ink);}}
.pxsite .hdr .right{margin-left:auto;display:flex;align-items:center;gap:10px;}
.pxsite .hdr .geo{display:inline-flex;align-items:center;gap:6px;background:none;border:0;cursor:pointer;padding:9px;border-radius:10px;color:var(--title);}
.pxsite .hdr .geo svg{width:19px;height:19px;}
.pxsite .hdr .burger{display:none;background:none;border:0;cursor:pointer;padding:8px;border-radius:10px;color:var(--ink);}
.pxsite .hdr .burger svg{width:24px;height:24px;}

/* Megamenú (desktop)
   Los paneles se anclan a '.bar' (que es la que lleva el 'position:relative'), NO al
   botón: así el ancho se centra en el CONTENEDOR y nunca se sale de la pantalla.
   'top' cuelga del alto de la barra, no del botón, porque el ancla ahora es la barra. */
.pxsite .mega{position:absolute;top:calc(100% + 8px);left:50%;transform:translateX(-50%);width:min(1180px,calc(100vw - 40px));background:#fff;border:1px solid var(--stroke);border-radius:22px;box-shadow:var(--sh-hi);padding:26px;z-index:70;}
/* Alineados al borde INTERNO de la barra (su padding es 28px), no al externo: así el
   panel termina donde termina "Cotizar" y no 28px más afuera. Abajo de 1080px la nav
   y el selector de país se esconden (entra la hamburguesa), así que el padding de
   18px del breakpoint de 600px nunca aplica a estos paneles. */
.pxsite .mega--right{left:auto;right:28px;transform:none;width:min(820px,calc(100vw - 40px));}
/* EXCEPCIÓN: el selector de país. Su panel NO cuelga de la barra sino de un wrapper con
   'position:relative' INLINE que trae SiteHeader (el div que envuelve al botón .geo),
   así que su 'right' se mide desde el botón: los 28px de arriba lo correrían 28px a la
   izquierda en vez de alinearlo. Este panel va pegado a su botón, como estaba. */
.pxsite .hdr .right .mega--right{right:0;}
.pxsite .mega .mtitle{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:4px;}
.pxsite .mega .mlead{font-size:13.5px;color:var(--body);max-width:62ch;margin-bottom:16px;}
.pxsite .mega-grid{display:grid;grid-template-columns:1.55fr 1fr;gap:26px;}
.pxsite .mega .plist{display:grid;grid-template-columns:1fr 1fr;gap:4px;}
.pxsite .mega .pitem{display:flex;align-items:center;gap:11px;padding:9px 11px;border-radius:12px;font-size:14.5px;color:var(--title);transition:background .15s var(--ease);}
.pxsite .mega .pitem img{width:22px;height:22px;flex:none;}
.pxsite .mega .pitem .tag{font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--mint-ink);background:var(--mint-bg);border-radius:100px;padding:2px 7px;}
@media (hover:hover) and (pointer:fine){.pxsite .mega .pitem:hover{background:var(--mint-bg);}}
.pxsite .mega .rail{display:flex;flex-direction:column;gap:14px;border-left:1px solid var(--stroke-2);padding-left:26px;}
.pxsite .mega .rcard{background:var(--bg);border:1px solid var(--stroke-2);border-radius:16px;padding:15px 16px;}
.pxsite .mega .rcard h4{font-size:15px;margin-bottom:4px;}
.pxsite .mega .rcard p{font-size:13px;color:var(--body);margin-bottom:10px;}
.pxsite .mega .rlist{display:flex;flex-direction:column;gap:2px;}
.pxsite .mega .rlist a{font-size:14px;color:var(--body);padding:6px 8px;border-radius:9px;}
@media (hover:hover) and (pointer:fine){.pxsite .mega .rlist a:hover{background:var(--bg);color:var(--ink);}}
.pxsite .mega .integr{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px;padding-top:16px;border-top:1px solid var(--stroke-2);font-size:13.5px;color:var(--body);}
.pxsite .mega .integr b{color:var(--title);}
.pxsite .mega .cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.pxsite .mega .rescard{border:1px solid var(--stroke-2);border-radius:16px;overflow:hidden;background:#fff;transition:box-shadow .2s var(--ease),transform .2s var(--ease);}
.pxsite .mega .rescard img{width:100%;height:104px;object-fit:cover;display:block;}
.pxsite .mega .rescard .body{padding:12px 14px 14px;}
.pxsite .mega .rescard h4{font-size:14.5px;margin-bottom:4px;}
.pxsite .mega .rescard p{font-size:12.5px;color:var(--body);}
@media (hover:hover) and (pointer:fine){.pxsite .mega .rescard:hover{transform:translateY(-2px);box-shadow:var(--sh-card);}}
.pxsite .mega .wa{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:18px;background:var(--mint-bg);border:1px solid var(--mint-line);border-radius:14px;padding:12px 16px;font-size:14px;color:var(--title);}
.pxsite .mega .wa a{display:inline-flex;align-items:center;gap:8px;font-weight:500;color:var(--mint-ink);}
.pxsite .mega .wa img{width:18px;height:18px;}

/* Menú mobile */
.pxsite .mnav{display:none;}
.pxsite .mnav.open{display:block;position:fixed;inset:64px 0 0;background:#fff;z-index:55;overflow-y:auto;padding:18px 20px 40px;}
.pxsite .mnav .grp{border-bottom:1px solid var(--stroke-2);}
.pxsite .mnav .ghead{width:100%;display:flex;align-items:center;justify-content:space-between;gap:10px;background:none;border:0;padding:16px 2px;font-family:var(--ui);font-size:16px;font-weight:500;color:var(--title);cursor:pointer;text-align:left;}
.pxsite .mnav .ghead svg{width:16px;height:16px;transition:transform .2s var(--ease);}
.pxsite .mnav .ghead[aria-expanded="true"] svg{transform:rotate(180deg);}
.pxsite .mnav .gbody{display:flex;flex-direction:column;gap:2px;padding:0 2px 14px;}
.pxsite .mnav .gbody a{display:flex;align-items:center;gap:10px;padding:10px 8px;border-radius:10px;font-size:15px;color:var(--body);}
.pxsite .mnav .gbody a img{width:20px;height:20px;}
.pxsite .mnav .macts{display:grid;gap:10px;margin-top:22px;}

/* ── Footer ──────────────────────────────────────────────────────────────── */
.pxsite .foot{background:var(--dark);color:#C9CDD4;padding:44px 0 0;}
.pxsite .foot .top{display:grid;grid-template-columns:1fr auto auto;gap:34px;align-items:start;padding-bottom:30px;border-bottom:1px solid rgba(255,255,255,.09);}
.pxsite .foot .brand img{width:86px;height:auto;}
.pxsite .foot .brand p{margin-top:10px;font-size:14px;color:#9AA1AB;}
.pxsite .foot .social{display:flex;gap:10px;margin-top:16px;}
.pxsite .foot .social a{width:30px;height:30px;border-radius:50%;border:1px solid rgba(255,255,255,.18);display:grid;place-items:center;transition:border-color .18s var(--ease),background .18s var(--ease);}
.pxsite .foot .social img{width:14px;height:14px;filter:brightness(0) invert(1);opacity:.85;}
@media (hover:hover) and (pointer:fine){.pxsite .foot .social a:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.4);}}
.pxsite .foot .certs{display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
.pxsite .foot .certs img{height:44px;width:auto;border-radius:6px;}
.pxsite .foot .switchers{display:grid;gap:10px;justify-items:stretch;min-width:230px;}
.pxsite .foot .sw{position:relative;}
.pxsite .foot .sw>summary{list-style:none;display:flex;align-items:center;gap:10px;background:var(--dark-2);border:1px solid rgba(255,255,255,.12);border-radius:100px;padding:11px 16px;font-size:14px;color:#E8EBEF;cursor:pointer;}
.pxsite .foot .sw>summary::-webkit-details-marker{display:none;}
.pxsite .foot .sw>summary img{width:20px;height:14px;object-fit:contain;}
.pxsite .foot .sw>summary .chev{margin-left:auto;width:14px;height:14px;}
.pxsite .foot .sw[open]>summary .chev{transform:rotate(180deg);}
.pxsite .foot .sw .opts{position:absolute;left:0;right:0;bottom:calc(100% + 8px);background:var(--dark-2);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:8px;display:grid;gap:2px;z-index:5;box-shadow:0 24px 50px -24px rgba(0,0,0,.8);}
.pxsite .foot .sw .opts a{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:10px;font-size:14px;color:#D6DAE0;}
.pxsite .foot .sw .opts img{width:20px;height:14px;object-fit:contain;}
@media (hover:hover) and (pointer:fine){.pxsite .foot .sw .opts a:hover{background:rgba(255,255,255,.08);color:#fff;}}
.pxsite .foot .cols{display:grid;grid-template-columns:repeat(3,1fr);gap:34px;padding:34px 0 40px;}
.pxsite .foot .cols h3{color:#fff;font-size:17px;margin-bottom:14px;}
.pxsite .foot .cols h3+h3{margin-top:26px;}
.pxsite .foot .cols ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;}
.pxsite .foot .cols li a{display:flex;align-items:center;gap:9px;font-size:14px;color:#B7BDC6;transition:color .15s var(--ease);}
.pxsite .foot .cols li img{width:15px;height:15px;opacity:.7;flex:none;}
@media (hover:hover) and (pointer:fine){.pxsite .foot .cols li a:hover{color:#fff;}}
.pxsite .foot .legal{border-top:1px solid rgba(255,255,255,.09);padding:16px 0 22px;text-align:center;font-size:12.5px;color:#8A9099;}
.pxsite .foot .legal a{color:#B7BDC6;}

/* ── Responsive ──────────────────────────────────────────────────────────── */
@media (max-width:1080px){
  .pxsite .hdr .nav,.pxsite .hdr .geo{display:none;}
  .pxsite .hdr .burger{display:inline-flex;}
  .pxsite .hdr .right .btn{display:none;}
  .pxsite .foot .top{grid-template-columns:1fr;}
  .pxsite .foot .switchers{min-width:0;max-width:300px;}
  .pxsite .foot .cols{grid-template-columns:1fr 1fr;gap:26px;}
}
@media (max-width:600px){
  .pxsite .wrap{padding:0 18px;}
  .pxsite .hdr .bar{padding:0 18px;gap:12px;}
  .pxsite .foot{padding-top:34px;}
  .pxsite .foot .cols{grid-template-columns:1fr;gap:22px;}
  .pxsite .foot .certs img{height:38px;}
}
@media (prefers-reduced-motion:reduce){
  .pxsite *{animation:none!important;transition:none!important;}
}

.pxsite.embx{--ink:#000017;--ink-2:#17171c;--rojo:#D20A11;--cuerpo:#2B2B33;--suave:#5f5f6b;--alt:#F6F7FB;--wa:#1F7A50;
  --sh-card:0 1px 2px rgba(0,0,23,.05),0 10px 30px rgba(0,0,23,.07);--sh-up:0 22px 50px rgba(0,0,23,.18);
  --ease:cubic-bezier(.22,.61,.36,1);position:relative;isolation:isolate;overflow-x:clip;background:#fff;color:var(--cuerpo);
  font-family:"Work Sans","Segoe UI",system-ui,sans-serif;font-size:17px;line-height:1.6}
.pxsite.embx h1,.pxsite.embx h2,.pxsite.embx h3,.pxsite.embx h4{font-family:"Work Sans",sans-serif;font-weight:300;color:var(--ink);letter-spacing:-.025em;line-height:1.08;text-wrap:balance;margin:0}
.pxsite.embx h1 b,.pxsite.embx h2 b,.pxsite.embx h4 b{font-weight:500}
.pxsite.embx p{margin:0}
.pxsite.embx .wrap{max-width:1320px;margin:0 auto;padding:0 16px}
.pxsite.embx .h2{font-size:clamp(34px,4.4vw,60px)}
.pxsite.embx .sec{padding:130px 0;position:relative}
.pxsite.embx .btn{display:inline-flex;align-items:center;gap:10px;border-radius:100px;font:500 16px/1 "Work Sans",sans-serif;padding:17px 28px;text-decoration:none;transition:transform .2s var(--ease),box-shadow .2s var(--ease)}
.pxsite.embx .btn:active{transform:scale(.97)}
.pxsite.embx .btn:focus-visible,.pxsite.embx .wa:focus-visible{outline:3px solid #fff;outline-offset:3px;box-shadow:0 0 0 6px var(--ink)}
@media (hover:hover){.pxsite.embx .btn:hover{transform:scale(1.02);box-shadow:0 6px 18px rgba(0,0,0,.18)}}
.pxsite.embx .btn-rojo{background:var(--rojo);color:#fff}

/* fondo continuo: manchas suaves, sin cortes entre secciones */
.pxsite.embx .manchas{position:absolute;inset:0;overflow:hidden;z-index:-1;pointer-events:none}
.pxsite.embx .mancha{position:absolute;width:70vw;height:70vw;max-width:1100px;max-height:1100px;border-radius:50%;filter:blur(90px);opacity:.55}
.pxsite.embx .mancha.r{background:radial-gradient(circle,rgba(255,174,174,.9),transparent 65%)}
.pxsite.embx .mancha.c{background:radial-gradient(circle,rgba(204,231,255,1),transparent 65%)}

/* paneles oscuros como los de la home */
.pxsite.embx .oscuro{background:var(--ink-2);color:#d9d9e0;position:relative;overflow:hidden;margin:0 12px;border-radius:20px}
.pxsite.embx .oscuro h2,.pxsite.embx .oscuro h3{color:#fff}
.pxsite.embx .oscuro::before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(60% 70% at 0% 100%,rgba(160,14,20,.55),transparent 70%),radial-gradient(55% 65% at 100% 0%,rgba(23,63,85,.85),transparent 70%)}
.pxsite.embx .oscuro>*{position:relative}

/* HERO */
.pxsite.embx .hero{margin:12px 12px 0;border-radius:20px;overflow:hidden;position:relative;min-height:680px;display:flex;align-items:center;background:#17171c;color:#d9d9e0}
.pxsite.embx .hero .foto{position:absolute;inset:0;background:url(/embajadores/hero-lobby.webp) center/cover no-repeat;transform:scale(1.06);animation:emb-acerca 14s var(--ease) forwards}
@keyframes emb-acerca{to{transform:scale(1)}}
.pxsite.embx .hero .velo{position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,12,22,.9) 0%,rgba(12,12,22,.72) 42%,rgba(12,12,22,.25) 100%),linear-gradient(0deg,rgba(12,12,22,.55),transparent 45%)}
.pxsite.embx .hero .wrap{position:relative;width:100%;padding-top:calc(var(--px-header-h,88px) + 70px);padding-bottom:110px}
.pxsite.embx .hero .texto{max-width:640px}
.pxsite.embx .hero h1{font-size:clamp(44px,6.2vw,90px);margin-bottom:28px;color:#fff}
.pxsite.embx .hero .bajada{font:300 21px/1.5 "Work Sans",sans-serif;color:#d6d6de;max-width:470px;margin-bottom:40px}
.pxsite.embx .hero .quien{margin-top:52px;display:flex;align-items:center;gap:14px;font-size:14px;color:#c4c4cf}
.pxsite.embx .hero .quien img{width:44px;height:44px;border-radius:50%;object-fit:cover;object-position:50% 20%}
.pxsite.embx .hero .quien b{color:#fff;font-weight:500}
.pxsite.embx .hero .texto>*{opacity:0;animation:emb-sube 1s var(--ease) forwards}
.pxsite.embx .hero .texto>:nth-child(2){animation-delay:.15s}.pxsite.embx .hero .texto>:nth-child(3){animation-delay:.3s}.pxsite.embx .hero .texto>:nth-child(4){animation-delay:.45s}
@keyframes emb-sube{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
.pxsite.embx .notif{position:absolute;right:16px;bottom:56px;width:340px;background:rgba(255,255,255,.96);border-radius:20px;padding:16px 18px;box-shadow:0 24px 50px rgba(0,0,0,.45);display:flex;gap:12px;color:var(--ink);opacity:0;transform:translateY(30px);animation:emb-entra .9s var(--ease) 1.1s forwards}
@keyframes emb-entra{to{opacity:1;transform:none}}
.pxsite.embx .notif .ic{flex:none;width:38px;height:38px;border-radius:10px;background:#fff;box-shadow:0 0 0 1px #ececf1;display:grid;place-items:center}
.pxsite.embx .notif .ic img{width:26px;height:auto;display:block}
.pxsite.embx .notif b{font:600 13px Inter,"Work Sans",sans-serif;display:flex;justify-content:space-between}
.pxsite.embx .notif b span{font-weight:400;color:#6f6f7b}
.pxsite.embx .notif p{font-size:13.5px;line-height:1.4;color:#3a3a44;margin-top:2px}

/* EL PROGRAMA */
.pxsite.embx .manif{font:300 clamp(28px,3.4vw,46px)/1.25 "Work Sans",sans-serif;color:var(--ink);letter-spacing:-.02em;max-width:1060px}
.pxsite.embx .manif b{font-weight:500}
.pxsite.embx .manif .x{color:var(--rojo);font-weight:500}
.pxsite.embx .sub{margin-top:36px;max-width:560px;font-size:18px;color:var(--suave)}

/* PERFILES */
.pxsite.embx .perf{display:grid;grid-template-columns:.8fr 1.2fr;gap:90px;align-items:start}
.pxsite.embx .perf ul{list-style:none;margin:0;padding:0}
.pxsite.embx .perf li{padding:0 0 38px}
.pxsite.embx .perf li h3{font-size:clamp(28px,3vw,40px);margin-bottom:6px}
.pxsite.embx .perf li p{color:var(--suave);max-width:480px}
.pxsite.embx .perf .lado p{color:var(--suave);margin-top:22px;max-width:360px}

/* 3X: calendario de 5 meses (facturas 1 y 2 sin cobro, después los tres cobros) */
.pxsite.embx .benef{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center}
.pxsite.embx .benef p{font-size:18px;max-width:460px;margin-top:22px}
.pxsite.embx .cal{background:var(--ink-2);border-radius:28px;padding:40px;color:#fff;box-shadow:var(--sh-up);position:relative;overflow:hidden}
.pxsite.embx .cal::before{content:"";position:absolute;inset:0;background:radial-gradient(70% 80% at 100% 0%,rgba(160,14,20,.6),transparent 70%),radial-gradient(60% 70% at 0% 100%,rgba(23,63,85,.9),transparent 70%)}
.pxsite.embx .cal>*{position:relative}
.pxsite.embx .cal-top{display:flex;justify-content:space-between;align-items:start}
.pxsite.embx .cal-top small{font:500 12px Inter,sans-serif;letter-spacing:.14em;color:#c8c8d2}
.pxsite.embx .big4{font:300 150px/.85 "Work Sans",sans-serif;letter-spacing:-.05em;margin:6px 0 18px;color:#fff}
.pxsite.embx .cal-top p{font:300 18px/1.4 "Work Sans",sans-serif;color:#e0e0e6;max-width:200px;text-align:right}
.pxsite.embx .meses{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:22px}
.pxsite.embx .mes{border-radius:14px;padding:14px 12px;background:rgba(255,255,255,.07);transition:background .5s var(--ease)}
.pxsite.embx .mes b{display:block;font:500 11px Inter,sans-serif;letter-spacing:.12em;color:#a9a9b5;margin-bottom:10px;transition:color .5s}
.pxsite.embx .mes .dias{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.pxsite.embx .mes .dias i{aspect-ratio:1;border-radius:2px;background:rgba(255,255,255,.12);transition:background .35s var(--ease),transform .35s var(--ease)}
.pxsite.embx .cal.in .mes.cobra{background:#fff}
.pxsite.embx .cal.in .mes.cobra b{color:var(--rojo)}
.pxsite.embx .cal.in .mes.cobra .dias i{background:rgba(210,10,17,.14)}
.pxsite.embx .cal.in .mes.cobra .dias i.pago{background:var(--rojo);transform:scale(1.08)}
.pxsite.embx .cal-ley{margin-top:18px;font-size:13px;color:#d0d0d8}
.pxsite.embx .cal-ley i{display:inline-block;width:10px;height:10px;border-radius:2px;background:var(--rojo);margin-right:8px}

/* CARTERA mes a mes */
.pxsite.embx .intro{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:end;margin-bottom:60px}
.pxsite.embx .intro p{font-size:18px;max-width:520px}
.pxsite.embx .gantt{background:#fff;border-radius:28px;padding:44px;box-shadow:var(--sh-card)}
.pxsite.embx .g-fila{display:grid;grid-template-columns:150px repeat(8,1fr);gap:8px;align-items:center;margin-bottom:10px}
.pxsite.embx .g-fila.cab{color:var(--suave);font:500 12px Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px}
.pxsite.embx .g-fila .lbl{font:400 18px "Work Sans",sans-serif;color:var(--ink)}
.pxsite.embx .celda{height:44px;border-radius:10px;background:var(--alt)}
.pxsite.embx .celda.cuota{color:transparent;display:grid;place-items:center;font:500 13px Inter,sans-serif;transition:background .45s var(--ease),color .45s var(--ease),transform .45s var(--ease);transform:scale(.92)}
.pxsite.embx .gantt.in .celda.cuota{background:var(--ink);color:#fff;transform:none}
.pxsite.embx .celda.espera{background:repeating-linear-gradient(135deg,#e6e6ec 0 6px,#f6f7fb 6px 12px)}
.pxsite.embx .g-fila.total{margin-top:26px}
.pxsite.embx .g-fila.total .lbl{font-weight:500}
.pxsite.embx .celda.barra{display:flex;align-items:end;background:transparent;height:90px}
.pxsite.embx .celda.barra span{width:100%;border-radius:10px 10px 6px 6px;background:var(--rojo);transform-origin:bottom;transform:scaleY(0);transition:transform .7s var(--ease)}
.pxsite.embx .gantt.in .celda.barra span{transform:none}
.pxsite.embx .g-nota{margin-top:22px;font-size:14px;color:var(--suave)}

/* DE LA RECOMENDACIÓN AL COBRO: objetos reales, en fila */
.pxsite.embx .pasos{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;margin:70px 0 0;padding:0;list-style:none}
.pxsite.embx .obj{background:#fff;border-radius:18px;box-shadow:var(--sh-card);padding:18px;font-size:13.5px;color:#3a3a44;min-height:190px;transition:transform .5s var(--ease),box-shadow .5s var(--ease)}
@media (hover:hover){.pxsite.embx .paso:hover .obj{transform:translateY(-6px);box-shadow:var(--sh-up)}}
.pxsite.embx .paso .cap{margin-top:22px}
.pxsite.embx .paso .cap h3{font-size:22px;font-weight:400;margin-bottom:4px}
.pxsite.embx .paso .cap p{font-size:15px;color:var(--suave)}
.pxsite.embx .invit .d{display:flex;gap:14px;align-items:center;margin-bottom:12px}
.pxsite.embx .invit .dia{width:52px;text-align:center;border-radius:10px;overflow:hidden;box-shadow:0 0 0 1px #ececf1;flex:none}
.pxsite.embx .invit .dia i{display:block;background:var(--rojo);color:#fff;font:600 10px Inter,sans-serif;letter-spacing:.1em;padding:3px 0;font-style:normal}
.pxsite.embx .invit .dia b{display:block;font:500 22px "Work Sans",sans-serif;color:var(--ink);padding:3px 0 4px}
.pxsite.embx .invit strong{display:block;color:var(--ink);font-weight:600;font-size:14px;line-height:1.3}
.pxsite.embx .invit .meta{color:#6f6f7b;font-size:12.5px}
.pxsite.embx .invit .quien{display:flex;align-items:center;gap:8px;margin-top:10px}
.pxsite.embx .invit .quien img{width:24px;height:24px;border-radius:50%;object-fit:cover}
.pxsite.embx .chat{background:#e9e3d9}
.pxsite.embx .chat .burbuja{border-radius:12px 12px 2px 12px;background:#d9fdd3;padding:9px 11px 18px;margin-left:24px;position:relative;color:#111;font-size:13.5px;line-height:1.4;opacity:0;transform:translateY(10px) scale(.96);transition:opacity .45s var(--ease),transform .45s var(--ease)}
.pxsite.embx .chat .burbuja.recibida{background:#fff;border-radius:12px 12px 12px 2px;margin:0 24px 6px 0}
.pxsite.embx .chat .burbuja small{position:absolute;right:9px;bottom:4px;font-size:10.5px;color:#556}
.pxsite.embx .paso.in .chat .burbuja{opacity:1;transform:none}
.pxsite.embx .paso.in .chat .burbuja+.burbuja{transition-delay:.7s}
.pxsite.embx .alta .t{display:flex;align-items:center;gap:8px;font:600 12px Inter,sans-serif;color:var(--wa);letter-spacing:.04em;margin-bottom:10px}
.pxsite.embx .alta .t i{width:8px;height:8px;border-radius:50%;background:var(--wa)}
.pxsite.embx .alta strong{display:block;font:500 19px "Work Sans",sans-serif;color:var(--ink);margin-bottom:6px}
.pxsite.embx .alta dl{display:grid;grid-template-columns:auto 1fr;gap:3px 12px;font-size:12.5px;margin:0}
.pxsite.embx .alta dt{color:#6f6f7b}
.pxsite.embx .alta dd{margin:0}
.pxsite.embx .transf{background:var(--ink-2);color:#d8d8e0;position:relative;overflow:hidden}
.pxsite.embx .transf::before{content:"";position:absolute;inset:0;background:radial-gradient(80% 90% at 100% 0%,rgba(160,14,20,.55),transparent 70%)}
.pxsite.embx .transf>*{position:relative}
.pxsite.embx .transf .t{font-size:12px;color:#c0c0cb}
.pxsite.embx .transf b{display:block;font:300 34px "Work Sans",sans-serif;color:#fff;letter-spacing:-.02em;margin:6px 0 10px}
.pxsite.embx .transf p{font-size:12.5px;line-height:1.6}

/* MÁS QUE UNA COMISIÓN */
.pxsite.embx .mas{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center;padding-top:120px;padding-bottom:120px}
.pxsite.embx .mas h2{margin-bottom:46px}
.pxsite.embx .mas ul{list-style:none;display:grid;gap:30px;margin:0;padding:0}
.pxsite.embx .mas li h3{font-size:26px;font-weight:400;margin-bottom:4px}
.pxsite.embx .mas li p{color:#c3c3ce;max-width:440px}
.pxsite.embx .placa{background:linear-gradient(140deg,#fff 0%,#fdf2f3 40%,#eaf4ff 100%);border-radius:30px;padding:52px 44px;box-shadow:var(--sh-up);color:var(--ink);display:flex;flex-direction:column;align-items:center;text-align:center;gap:30px;max-width:470px;width:100%;justify-self:end}
.pxsite.embx .placa h4{font-size:34px;font-weight:300}
.pxsite.embx .placa p{font:300 20px/1.4 "Work Sans",sans-serif;color:#555;margin-top:10px}
.pxsite.embx .sello{width:280px;height:auto;display:block;filter:drop-shadow(0 10px 24px rgba(0,0,23,.10))}

/* NUESTROS EMBAJADORES */
.pxsite.embx .emb-cab{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:56px}
.pxsite.embx .emb-cab p{max-width:400px;color:var(--suave)}
.pxsite.embx .emb-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;list-style:none;margin:0;padding:0}
.pxsite.embx .emb{background:#fff;border-radius:26px;box-shadow:var(--sh-card);overflow:hidden;display:flex;flex-direction:column;height:100%;transition:transform .25s var(--ease),box-shadow .25s var(--ease)}
@media (hover:hover){.pxsite.embx .emb:hover{transform:translateY(-4px);box-shadow:var(--sh-up)}}
.pxsite.embx .emb .ph{position:relative;aspect-ratio:1/1.08;overflow:hidden;background:var(--alt)}
.pxsite.embx .emb .ph img{width:100%;height:100%;object-fit:cover;display:block}
.pxsite.embx .emb .insignia{position:absolute;left:14px;bottom:14px;display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.94);border-radius:100px;padding:6px 12px 6px 6px;font:500 12px Inter,sans-serif;color:var(--ink)}
.pxsite.embx .emb .insignia img{width:20px;height:auto;display:block;margin-left:4px}
.pxsite.embx .emb .tx{padding:22px 22px 24px;display:flex;flex-direction:column;flex:1}
.pxsite.embx .emb h3{font-size:22px;font-weight:400;margin-bottom:8px;letter-spacing:-.015em}
.pxsite.embx .emb .desc{font-size:15px;color:var(--suave);line-height:1.55;flex:1}
.pxsite.embx .wa{margin-top:20px;align-self:start;display:inline-flex;align-items:center;gap:9px;background:var(--wa);color:#fff;text-decoration:none;border-radius:100px;padding:11px 18px 11px 14px;font:500 14px "Work Sans",sans-serif;transition:transform .2s var(--ease)}
.pxsite.embx .wa:active{transform:scale(.97)}
.pxsite.embx .wa svg{width:18px;height:18px}
.pxsite.embx .muestra{margin-top:28px;font-size:13px;color:#7a7a86;text-align:center}

/* CONDICIONES: una hoja */
.pxsite.embx .hoja{background:#fff;border-radius:8px;box-shadow:0 2px 3px rgba(0,0,23,.05),0 30px 60px rgba(0,0,23,.10);padding:64px 70px;margin-top:56px;display:grid;grid-template-columns:1fr 1fr;gap:20px 80px}
.pxsite.embx .hoja h3{grid-column:1/-1;font:500 15px Inter,sans-serif;letter-spacing:0;color:#6f6f7b;margin-top:10px}
.pxsite.embx .hoja h3:not(:first-child){margin-top:34px}
.pxsite.embx .hoja dl{display:contents}
.pxsite.embx .hoja dt{font:500 15px Inter,sans-serif;color:var(--ink);margin-bottom:2px}
.pxsite.embx .hoja dd{font:300 21px/1.4 "Work Sans",sans-serif;color:var(--cuerpo);margin:0}
.pxsite.embx .linea{grid-column:1/-1;display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:6px 0 0;padding:0;list-style:none}
.pxsite.embx .linea li{font:500 10.5px Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#6f6f7b;padding-top:12px;position:relative}
.pxsite.embx .linea li::before{content:"";position:absolute;top:0;left:0;right:0;height:6px;border-radius:6px;background:#e2e2e8}
.pxsite.embx .linea li:nth-child(n+3){color:#b0090f}
.pxsite.embx .linea li:nth-child(3)::before{background:#e98a8e}.pxsite.embx .linea li:nth-child(4)::before{background:#e35e63}.pxsite.embx .linea li:nth-child(5)::before{background:var(--rojo)}

/* CYNTHIA */
.pxsite.embx .cyn{display:grid;grid-template-columns:.85fr 1.15fr;gap:80px;align-items:center;padding:110px 16px}
