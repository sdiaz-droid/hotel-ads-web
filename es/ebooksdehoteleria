</div><script>/* Módulo global "header" (menú) — JS del porte de HubSpot a Nexus.
 *
 * ── Por qué esto NO es el JS de HubSpot ──────────────────────────────────────
 * El módulo original (`fuente-hubspot/menu.module.js`) está escrito con jQuery y
 * arranca con `APP.domReady(...)`, donde `APP` es un global que define el tema
 * MyDesign. En una página de Nexus no existe ninguno de los dos: pegarlo tal cual
 * tira `APP is not defined` en la primera línea y deja el menú MUERTO — el
 * mega-menú no abre, el menú mobile no abre, y queda un error de consola por
 * página. (Ese JS minificado venía en el porte de julio; el bug se detectó antes
 * de publicarlo, nunca salió a producción.)
 *
 * Tampoco hay Bootstrap JS, que en HubSpot es el que maneja los `data-bs-toggle`
 * del selector de idioma. Así que acá se reimplementa todo en JS plano:
 *   · mega-menú desktop (abrir/cerrar, cerrar al clickear afuera o con Escape)
 *   · tabs internas de los grupos de secciones
 *   · menú mobile (deslizar a un submenú y volver)
 *   · dropdown del selector de idioma (reemplazo de Bootstrap + Popper)
 *
 * Todo queda ACOTADO al wrapper del módulo (`<div data-pxsol-global="header">`,
 * que es lo que emite `injectGlobalModules`): las búsquedas arrancan en la raíz
 * del módulo, nunca en `document`. Si no, un `.js-button` del contenido de la
 * página entraría en la lógica del menú.
 */
;(function () {
  "use strict"

  // El <script> se inyecta DENTRO del wrapper y DESPUÉS del markup, así que en
  // este punto el header ya está parseado y `currentScript` nos da la raíz.
  var script = document.currentScript
  var raiz = script && script.closest ? script.closest("[data-pxsol-global]") : null
  if (!raiz) return
  // Idempotencia: si el módulo se inyectara dos veces, no duplicar handlers.
  if (raiz.dataset.pxMenuListo === "1") return
  raiz.dataset.pxMenuListo = "1"

  var $ = function (sel, ctx) { return (ctx || raiz).querySelector(sel) }
  var $$ = function (sel, ctx) { return Array.prototype.slice.call((ctx || raiz).querySelectorAll(sel)) }
  var escapaId = function (v) {
    return window.CSS && CSS.escape ? CSS.escape(v) : String(v).replace(/[^\w-]/g, "")
  }

  // ── Mega-menú desktop ──────────────────────────────────────────────────────
  var enlaces = $$('.js-menu-link:not([data-type="link"])')
  var secciones = $$(".js-menu-section")

  function cerrarSecciones() {
    secciones.forEach(function (s) { s.classList.add("d-none") })
    enlaces.forEach(function (l) { l.classList.remove("--active") })
  }

  enlaces.forEach(function (enlace) {
    enlace.addEventListener("click", function (e) {
      e.preventDefault()
      var seccion = $("#menu-" + escapaId(enlace.dataset.menuId || ""))
      // Volver a clickear el mismo ítem lo cierra: es el `toggleClass` del original.
      var estabaAbierta = !!seccion && !seccion.classList.contains("d-none")
      cerrarSecciones()
      if (seccion && !estabaAbierta) {
        seccion.classList.remove("d-none")
        enlace.classList.add("--active")
      }
    })
  })

  // Cerrar al clickear afuera. El original recorría los ancestros buscando
  // `js-wrapper-menu` / `js-menu-section`; con `closest` es lo mismo.
  if (secciones.length) {
    document.addEventListener("click", function (e) {
      if (!(e.target instanceof Element)) return
      if (e.target.closest(".js-wrapper-menu") || e.target.closest(".js-menu-section")) return
      cerrarSecciones()
    })
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") cerrarSecciones()
    })
  }

  // ── Tabs internas de cada grupo de secciones ───────────────────────────────
  $$(".js-menu-section-group").forEach(function (grupo) {
    $$(".js-button", grupo).forEach(function (boton) {
      boton.addEventListener("click", function () {
        var id = boton.dataset.id
        $$(".js-item-content, .js-item-menu", grupo).forEach(function (el) {
          el.classList.remove("--selected")
        })
        var contenido = $(".js-item-content-" + id, grupo)
        var item = $(".js-item-menu-" + id, grupo)
        if (contenido) contenido.classList.add("--selected")
        if (item) item.classList.add("--selected")
      })
    })
  })

  // ── Menú mobile ────────────────────────────────────────────────────────────
  // Abrir y cerrar el panel entero ya lo hace el markup con `onclick` inline (es
  // JS plano, funciona sin dependencias). Acá va sólo la navegación interna.
  var mobile = $("#headerMenuMobile")
  if (mobile) {
    var stage = $(".js-menu-stage", mobile)
    var submenus = $$(".js-mobile-submenu", mobile)

    var volverAlInicio = function () {
      if (stage) stage.classList.remove("--slide")
      submenus.forEach(function (s) { s.classList.add("d-none") })
    }

    $$(".js-menu-mobile-link", mobile).forEach(function (enlace) {
      enlace.addEventListener("click", function (e) {
        e.preventDefault()
        if (stage) stage.classList.add("--slide")
        submenus.forEach(function (s) { s.classList.add("d-none") })
        var destino = mobile.querySelector("#" + escapaId(enlace.dataset.menuId || ""))
        if (destino) destino.classList.remove("d-none")
      })
    })

    $$(".js-mobile-nav-back, .js-menu-mobile-close", mobile).forEach(function (boton) {
      boton.addEventListener("click", volverAlInicio)
    })
  }

  // ── Dropdown del selector de idioma (reemplazo de Bootstrap + Popper) ──────
  // Bootstrap muestra el menú con la clase `.show` y lo posiciona con Popper.
  // Acá se usa la MISMA clase (así el CSS del tema sirve sin tocarlo) y el
  // posicionamiento lo resuelve el CSS del módulo.
  var toggles = $$('[data-bs-toggle="dropdown"]')

  function cerrarDropdowns(excepto) {
    toggles.forEach(function (t) {
      if (t === excepto) return
      t.classList.remove("show")
      t.setAttribute("aria-expanded", "false")
      var m = t.parentElement && t.parentElement.querySelector(".dropdown-menu")
      if (m) m.classList.remove("show")
    })
  }

  toggles.forEach(function (toggle) {
    var menu = toggle.parentElement && toggle.parentElement.querySelector(".dropdown-menu")
    if (!menu) return
    toggle.setAttribute("aria-expanded", "false")
    toggle.addEventListener("click", function (e) {
      e.preventDefault()
      e.stopPropagation()
      var abierto = menu.classList.contains("show")
      cerrarDropdowns(toggle)
      menu.classList.toggle("show", !abierto)
      toggle.classList.toggle("show", !abierto)
      toggle.setAttribute("aria-expanded", String(!abierto))
    })
  })

  if (toggles.length) {
    document.addEventListener("click", function (e) {
      if (e.target instanceof Element && e.target.closest(".dropdown")) return
      cerrarDropdowns(null)
    })
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") cerrarDropdowns(null)
    })
  }
})()


/* ─────────────────────────────────────────────────────────────────────────────
   NAVBAR GLOBAL DE PXSOL — comportamiento (rediseño 08/2026)

   Se AGREGA al final del JS que ya tiene el WebModule HEADER. El viejo sigue ahí
   porque todavía maneja el menú mobile, los acordeones del footer y el dropdown
   del selector de país (Bootstrap). Lo que sí quedó sin efecto es su lógica del
   megamenú de escritorio: bindea `.js-menu-link` y `.js-button`, que ya no están
   en el markup, y un forEach sobre una lista vacía no hace nada.

   Todo cuelga de la raíz del módulo (`[data-pxsol-global]`), nunca de `document`:
   si no, un `.pxnav__item` del contenido de la página entraría en esta lógica.
   ───────────────────────────────────────────────────────────────────────────── */
;(function () {
  "use strict"

