nt.elementsFromPoint(x, y)\n    for (var i = 0; i \u003c pila.length; i++) {\n      var el = pila[i]\n      if (raiz.contains(el) || el === raiz) continue\n      var lum = luminanciaDe(getComputedStyle(el).backgroundColor)\n      if (lum !== null) return lum\n    }\n    // Ninguna capa pinta nada en ese punto: lo que se ve es el lienzo del\n    // navegador, o sea el fondo del body, y si tampoco lo pinta, blanco. Sin este\n    // fallback la página se contaba como \"sin dato\" y el estado claro no se\n    // activaba: es el caso de /precios, que no tiene ningún contenedor opaco arriba.\n    var delBody = luminanciaDe(getComputedStyle(document.body).backgroundColor)\n    return delBody === null ? 1 : delBody\n  }\n\n  /** Luminancia relativa aproximada de un color CSS; null si no pinta (translúcido). */\n  function luminanciaDe(col) {\n    var m = /rgba?\\(([^)]+)\\)/.exec(col)\n    if (!m) return null\n    var p = m[1].split(\",\")\n    var a = p.length \u003e 3 ? parseFloat(p[3]) : 1\n    if (!(a \u003e 0.5)) return null // translúcido: deja ver lo de atrás, no decide\n    return (0.2126 * +p[0] + 0.7152 * +p[1] + 0.0722 * +p[2]) / 255\n  }\n\n  /**\n   * Recoger la barra es lo ÚNICO que se resuelve en todos los frames: comparar\n   * `scrollY` contra dos números y togglear una clase no cuesta nada.\n   *\n   * Acá NO hay coreografía, y es a propósito. Hubo una versión con una segunda\n   * clase para el contenido y un `setTimeout` que lo hacía esperar a la caja:\n   * hacía falta porque los dos estados tenían textos de ancho distinto y,\n   * mientras la caja se anima, contenido y caja no pueden coincidir. Desde el\n   * 29/08/2026 los dos estados dicen lo mismo (ver el comentario del CSS), así\n   * que no queda nada que sincronizar: el contenido entra en la caja chica y en\n   * la grande, y lo único que cambia además del ancho es el logo, que salta.\n   *\n   * Si alguna vez vuelven textos distintos en los dos estados, esto deja de\n   * alcanzar — lo cuida `navbar-compresion.test.ts`.\n   */\n  function actualizarPegada() {\n    var y = window.scrollY\n    var antes = wrap.classList.contains(\"--stuck\")\n    if (y \u003e UMBRAL_ENTRADA) wrap.classList.add(\"--stuck\")\n    else if (y \u003c UMBRAL_SALIDA) wrap.classList.remove(\"--stuck\")\n    return wrap.classList.contains(\"--stuck\") !== antes\n  }\n\n  /**\n   * El estado claro, en cambio, es CARO: `fondoDetrasEsClaro()` hace tres\n   * `elementsFromPoint`, y cada uno obliga al navegador a recalcular el layout de\n   * la página entera. Corriéndolo en cada frame de scroll —que es lo que hacía\n   * antes— se le come al hilo principal justo los milisegundos en los que la barra\n   * tiene que animarse, y la transición sale a los tirones.\n   *\n   * El color de fondo de una sección no cambia dentro de 100ms de scroll, así que\n   * muestrear cada 100ms se ve idéntico y cuesta seis veces menos. Lo que NO puede\n   * esperar es el frame en el que la barra se recoge —cambia de alto y de ancho,\n   * o sea se mueven los tres puntos de muestreo— ni el arranque: van forzados.\n   */\n  var MUESTREO_MS = 100\n  var ultimoMuestreo = -Infinity\n  function actualizarClaro(forzar) {\n    var ahora = Date.now()\n    if (!forzar \u0026\u0026 ahora - ultimoMuestreo \u003c MUESTREO_MS) return\n    ultimoMuestreo = ahora\n    var b = barra.getBoundingClientRect()\n    var marcada = claros.some(function (el) {\n      var r = el.getBoundingClientRect()\n      return r.top \u003c b.bottom - 4 \u0026\u0026 r.bottom \u003e b.top + 4\n    })\n    wrap.classList.toggle(\"--light\", marcada || fondoDetrasEsClaro())\n  }\n\n  function sincronizar(forzar) {\n    var cambio = actualizarPegada()\n    actualizarClaro(forzar || cambio)\n    // Reubicar los paneles sólo tiene sentido si hay uno abierto. Antes corría\n    // siempre, y `ubicar()` ESCRIBE `style.left`/`style.width` en los tres paneles\n    // inmediatamente después de leer geometría: leer-escribir-leer en el mismo\n    // frame invalida el layout una y otra vez, y encima cada frame de scroll.\n    if (abierto !== null) ubicar()\n  }\n\n  // Un solo listener de scroll, pasivo y limitado a UN cálculo por frame. Dentro\n  // de ese frame va lo barato siempre (recoger la barra) y lo caro con\n  // cuentagotas (el muestreo de color) — ver `sincronizar`.\n  var pendiente = false\n  function alScrollear() {\n    if (pendiente) return\n    pendiente = true\n    requestAnimationFrame(function () {\n      pendiente = false\n      sincronizar()\n    })\n  }\n  window.addEventListener(\"scroll\", alScrollear, { passive: true })\n  window.addEventListener(\"resize\", function () { releerClaros(); sincronizar(true) })\n  // Los dos de abajo existen porque el ancho de la barra cambia CON ANIMACIÓN y un\n  // offset calculado al abrir queda viejo enseguida. Pero si no hay ningún panel\n  // abierto no hay nada que reubicar, y el ResizeObserver disparaba en CADA frame\n  // de esa animación: era thrashing de layout compitiendo contra la animación que\n  // el navegador estaba tratando de dibujar.\n  barra.addEventListener(\"transitionend\", function () { if (abierto !== null) ubicar() })\n  if (window.ResizeObserver) {\n    new ResizeObserver(function () { if (abierto !== null) ubicar() }).observe(barra)\n  }\n\n  releerClaros()\n  pintar()\n  sincronizar(true)\n\n  /**\n   * Las secciones claras hay que volver a buscarlas cuando el body terminó de\n   * parsearse.\n   *\n   * El \u003cscript\u003e del módulo se inyecta DENTRO del wrapper del header, o sea arriba\n   * de todo: cuando corre, el resto de la página todavía no existe y el\n   * querySelectorAll de arriba devuelve CERO. El síntoma es que el estado claro\n   * simplemente nunca se activa, sin ningún error en consola — se ve igual que si\n   * la detección estuviera mal escrita. Medido en la preview el 06/08/2026:\n   * `solapa: true` y aun así la clase --light no se ponía.\n   */\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      releerClaros()\n      sincronizar(true)\n    })\n  }\n})()\n"])</script><script>self.__next_f.push([1,"1b:T4132,"])</script><script>self.__next_f.push([1,"\u003cfooter class=\"px-footer\"\u003e\n    \u003cdiv class=\"container\"\u003e\n        \u003cdiv class=\"row\"\u003e\n            \u003cdiv class=\"col-md-4\"\u003e\n                \u003cdiv class=\"px-footer__logo\"\u003e\n                    \u003cimg src=\"https://www.pxsol.com/api/marketing-asset/marketing-files/cc28b544-7b11-4c17-8ca3-f1c3241eedbe.svg\" alt=\"PxSol\" width=\"74\" height=\"36\"\u003e\n                  \u003c/div\u003e\n                  \u003cdiv  style=\"\"\u003e\u003cdiv class=\"px-sn__text\"\u003eSoftware para hoteles all-in-one\u003c/div\u003e\n\u003cul class=\"px-sn__links\"\u003e\n\n\t\t\u003cli\u003e\n\t\t\t\u003ca href=\"https://www.linkedin.com/company/pxsol/\" target=\"_blank\"\u003e\n\t\t\t\t\u003cimg src=\"https://www.pxsol.com/api/marketing-asset/marketing-files/0c8d6b5c-a1a4-4439-8958-899a881b14b3.svg\" alt=\"linkedin\"\u003e\n\t\t\t\u003c/a\u003e\n\t\t\u003c/li\u003e\n\n\t\t\u003cli\u003e\n\t\t\t\u003ca href=\"https://www.youtube.com/channel/UCoTRm0dWRP9ySGKXCwA5qQA\" target=\"_blank\"\u003e\n\t\t\t\t\u003cimg src=\"https://www.pxsol.com/api/marketing-asset/marketing-files/825bf6ee-c519-4dbc-ad73-f5eb205195bc.svg\" alt=\"youtube\"\u003e\n\t\t\t\u003c/a\u003e\n\t\t\u003c/li\u003e\n\n\t\t\u003cli\u003e\n\t\t\t\u003ca href=\"https://www.facebook.com/PXSOL/\" target=\"_blank\"\u003e\n\t\t\t\t\u003cimg src=\"https://www.pxsol.com/api/marketing-asset/marketing-files/90319783-cef5-4d3a-8506-1ccab316f64b.svg\" alt=\"facebook\"\u003e\n\t\t\t\u003c/a\u003e\n\t\t\u003c/li\u003e\n\n\t\t\u003cli\u003e\n\t\t\t\u003ca href=\"https://www.instagram.com/pxsol/\" target=\"_blank\"\u003e\n\t\t\t\t\u003cimg src=\"https://www.pxsol.com/api/marketing-asset/marketing-files/fb27fdc6-8ecc-4ef2-b505-b8b005685952.svg\" alt=\"instagram\"\u003e\n\t\t\t\