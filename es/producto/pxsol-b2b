  .pxsite .feats--plain .feat{padding:24px;}
  .pxsite .feats--plain .feat h3{font-size:18px;line-height:20px;}
  .pxsite .feats--plain .feat p{margin-top:16px;line-height:22px;}
  .pxsite .tabs .tabbar{justify-content:flex-start;overflow-x:auto;flex-wrap:nowrap;margin-bottom:26px;padding-bottom:4px;}
  .pxsite .tabs .tabbtn{flex:none;}
  /* Las 4 métricas del bento pasan a 2×2, como en la publicada. El min-width:150px
