/* ══ Reveal por scroll ══════════════════════════════════════════════════════
   La pagina publicada anima al entrar en viewport con animate.css: los elementos
   nacen con una clase de opacidad 0 y un data-animation, y el JS del tema les
   suma la clase cuando aparecen. Hotel Ads tiene 7 elementos asi (la banda de
   logos, el titulo y el carrusel de notas, las dos columnas del trial y el CTA
   del footer); Channel Manager tiene 38 y Motor 33.

   Dos decisiones propias, las dos a proposito:

   1. El opacity:0 vive scopeado bajo .pxsite--reveal, que la agrega el JS al
      montar. En la publicada el opacity:0 esta en el HTML, asi que si el JS no
      corre el contenido queda invisible PARA SIEMPRE. Aca, sin JS, se ve todo:
      la animacion es una mejora, no un requisito para leer la pagina.
   2. Es OPT-IN por pagina: los data-reveal son inertes hasta que una pagina
      agrega la clase raiz. Por eso se pueden dejar en componentes compartidos
      (el bloque de trial lo usa tambien crearcuenta) sin moverles nada.

   Las curvas son las de animate.css: fadeInUp/Down entran 100% de su alto, y las
   variantes Big entran de 2000px al costado. */
.pxsite--reveal [data-reveal]{opacity:0;}
/* Duracion 1s y fill-mode both: son EXACTAMENTE los de animate.css 4.1.1, que es
   la hoja que linkean las publicadas (:root{--animate-duration:1s} y
   .animate__animated{animation-duration:var(--animate-duration);
   animation-fill-mode:both}). Estaba en .8s, que era invento nuestro.
   La duracion se lee de --animate-duration, igual que animate.css, y cae en 1s si
   nadie la declara. Antes era el 1s pelado y cada valor se enumeraba abajo con un
   data-attribute propio. Eso alcanzaba mientras las publicadas usaran medios
   segundos redondos, pero Agentes de IA trae DIEZ duraciones distintas y dos son
   basura de coma flotante de la aritmetica del editor de HubSpot
   (2.0999999999999996s y 3.5999999999999996s): enumerarlas no se puede mantener, y
   el generador de markup aborta ante cualquier valor que el CSS no declare. Leyendo
   la variable, el markup portado conserva su style inline VERBATIM y cualquier valor
   nuevo anda solo. Las reglas enumeradas de abajo se conservan y siguen ganando
   donde estan (pesan un atributo mas), asi que las paginas que ya usan
   data-reveal-duration no se mueven un pixel. */
.pxsite--reveal [data-reveal].is-in{opacity:1;animation-duration:var(--animate-duration,1s);animation-fill-mode:both;}
.pxsite--reveal [data-reveal="fade-up"].is-in{animation-name:pxRevealFadeInUp;}
.pxsite--reveal [data-reveal="fade-down"].is-in{animation-name:pxRevealFadeInDown;}
.pxsite--reveal [data-reveal="fade-in"].is-in{animation-name:pxRevealFadeIn;}
.pxsite--reveal [data-reveal="fade-left"].is-in{animation-name:pxRevealFadeInLeft;}
.pxsite--reveal [data-reveal="fade-right"].is-in{animation-name:pxRevealFadeInRight;}
.pxsite--reveal [data-reveal="zoom-in"].is-in{animation-name:pxRevealZoomIn;}
.pxsite--reveal [data-reveal="fade-left-big"].is-in{animation-name:pxRevealFadeInLeftBig;}
.pxsite--reveal [data-reveal="fade-right-big"].is-in{animation-name:pxRevealFadeInRightBig;}
.pxsite--reveal [data-reveal="zoom-in-down"].is-in{animation-name:pxRevealZoomInDown;}
/* Demora, como los animate__delay-Xs de la publicada. Con animation-fill-mode:both
   el elemento se queda en el estado inicial (opacity 0) durante la espera, que es
   justo lo que hace animate.css — sin esto entraria visible y despues animaria.
   Nada de backticks en estos comentarios: el archivo ES un template literal y uno
   solo lo parte (el build lo caza como "Expected a semicolon").
   OJO con la semantica: delay-1s en los 6 items de un FAQ NO los escalona, los
   hace entrar A LA VEZ un segundo despues. El escalonado aparece cuando el
   diseño mezcla -1s y -2s en elementos distintos (ERP). */
.pxsite--reveal [data-reveal][data-reveal-delay="1s"].is-in{animation-delay:1s;}
.pxsite--reveal [data-reveal][data-reveal-delay="2s"].is-in{animation-delay:2s;}
/* Escalonado por DURACION, no por demora: es como escalona B2B sus cards
   (--animate-duration 0.5/1.0/1.5/2.0s en la publicada). Entran todas juntas
   pero terminan en momentos distintos, que da una cascada mas suave que el
   delay. Ojo: NO es lo mismo que el delay — con delay la card no existe hasta
   que arranca; con duracion arranca ya y tarda mas. */
.pxsite--reveal [data-reveal][data-reveal-duration="0.5s"].is-in{animation-duration:.5s;}
.pxsite--reveal [data-reveal][data-reveal-duration="1s"].is-in{animation-duration:1s;}
.pxsite--reveal [data-reveal][data-reveal-duration="1.5s"].is-in{animation-duration:1.5s;}
.pxsite--reveal [data-reveal][data-reveal-duration="2s"].is-in{animation-duration:2s;}
/* La grilla de ERP llega hasta 3s: son 6 cards y la publicada NO cicla, sigue
   sumando medio segundo por card. */
.pxsite--reveal [data-reveal][data-reveal-duration="2.5s"].is-in{animation-duration:2.5s;}
.pxsite--reveal [data-reveal][data-reveal-duration="3s"].is-in{animation-duration:3s;}
/* La escalera de 0.7s, que es la que usa Huesped+. Es una segunda serie, no un
   reemplazo: esa pagina escalona sus cards en multiplos de 0.7 (5 elementos por
   bloque) y las otras doce siguen en la de 0.5. HubSpot escribe la tercera como
   2.0999999999999996s (0.7x3 en punto flotante) y el generador la normaliza a
   2.1s: sin normalizar, el selector no matchea y la animacion corre con la
   duracion por defecto SIN AVISAR, que es indistinguible a ojo de una que ya
   termino. Por eso generar-markup.py aborta ante una duracion que no este aca. */
.pxsite--reveal [data-reveal][data-reveal-duration="0.7s"].is-in{animation-duration:.7s;}
.pxsite--reveal [data-reveal][data-reveal-duration="1.4s"].is-in{animation-duration:1.4s;}
.pxsite--reveal [data-reveal][data-reveal-duration="2.1s"].is-in{animation-duration:2.1s;}
.pxsite--reveal [data-reveal][data-reveal-duration="2.8s"].is-in{animation-duration:2.8s;}
.pxsite--reveal [data-reveal][data-reveal-duration="3.5s"].is-in{animation-duration:3.5s;}
@keyframes pxRevealFadeInUp{from{opacity:0;transform:translate3d(0,100%,0)}to{opacity:1;transform:none}}
@keyframes pxRevealFadeInDown{from{opacity:0;transform:translate3d(0,-100%,0)}to{opacity:1;transform:none}}
@keyframes pxRevealFadeIn{from{opacity:0}to{opacity:1}}
/* Las variantes NO-Big entran 100% de su propio ancho, no 2000px. */
@keyframes pxRevealFadeInLeft{from{opacity:0;transform:translate3d(-100%,0,0)}to{opacity:1;transform:none}}
@keyframes pxRevealFadeInRight{from{opacity:0;transform:translate3d(100%,0,0)}to{opacity:1;transform:none}}
/* zoomIn de animate.css: arranca al 30% y tiene un easing propio en el 50%. */
@keyframes pxRevealZoomIn{from{opacity:0;transform:scale3d(.3,.3,.3)}50%{opacity:1}to{opacity:1;transform:none}}
@keyframes pxRevealFadeInLeftBig{from{opacity:0;transform:translate3d(-2000px,0,0)}to{opacity:1;transform:none}}
@keyframes pxRevealFadeInRightBig{from{opacity:0;transform:translate3d(2000px,0,0)}to{opacity:1;transform:none}}
/* zoomInDown de animate.css: cae de 1000px arriba y sobrepasa 60px, con DOS
   easings distintos (el segundo lo declara el propio keyframe al 60%). */
@keyframes pxRevealZoomInDown{
  from{opacity:0;transform:scale3d(.1,.1,.1) translate3d(0,-1000px,0);animation-timing-function:cubic-bezier(.55,.055,.675,.19)}
  60%{opacity:1;transform:scale3d(.475,.475,.475) translate3d(0,60px,0);animation-timing-function:cubic-bezier(.175,.885,.32,1)}
}
/* Sin movimiento: se muestra todo de una, nada queda escondido.

   Lo que de verdad garantiza que nada anime NO esta en este archivo: es la regla
   global del shell (site-shell-css.ts, .pxsite * con animation:none!important).
   Al ser !important le gana a todas las reglas de reveal de aca sin importar la
   especificidad — verificado con la media query emulada por CDP, no leyendo el
   CSS. Eso es lo que sostiene que un data-reveal-delay no deje el contenido
   invisible durante la espera: con animation-fill-mode:both el elemento retiene
   su estado inicial (opacity 0) hasta que arranca.
   Este bloque aporta el opacity:1, que la global NO toca: es la red por si el JS
   no llego a poner .is-in. Si algun dia se saca ese !important del shell, hay que
   empatarle aca la especificidad a las reglas de reveal (la de la demora suma 4)
   o la demora esconde contenido. El gate es el probe de reveal del repo con la
   opcion --reduced-motion.
   (Y NADA de backticks en estos comentarios: el archivo ES un template literal.
   Va la tercera vez que lo rompo; el guard es product-page-css.test.ts.) */
@media (prefers-reduced-motion:reduce){
  .pxsite--reveal [data-reveal]{opacity:1;animation:none;}
}

/* ── B2B ────────────────────────────────────────────────────────────────────
   Primera pagina CLARA del rediseno. Los valores salen del CSS de cada modulo
   de la publicada (module_hero-portal-ventas, module_caso-de-uso,
   module_features, module_pdp-steps, module_beneficios-por-bloque y
   module_cta-intermedio), no del frame. */

/* Hero del portal: una sola columna de 918px centrada sobre el degradado, y la
   foto ancha abajo recortada a 379px. El header NO va encima (la publicada le
   pone position:relative), asi que no hay padding para el menu. */
/* La caja va a 12px de cada borde de la ventana, no a 20: es el container-fluid
   del layout de HubSpot, el mismo que el resto de los modulos. */
/* padding-bottom en 0: el .hero generico del sistema pone 22px abajo y el modulo
   no tiene ninguno (el aire lo da el margen de la foto). Eran 22px que no estan
   en el origen y que ninguna otra medida cantaba, porque caen fuera del wrap. */
.pxsite .hero--portal{background:linear-gradient(113.5deg,var(--g1) 2.52%,var(--g2) 45.31%,var(--g3) 88.1%);border-radius:20px;margin:0 12px 120px;padding:100px 0 0;}
/* El color del texto es el default del campo (#001701), y los h1/h2 lo tienen que
   HEREDAR: en tema claro el encabezado del repo trae su propio color (#212529) y
   gana. No mueve una sola altura, asi que ninguna medida lo canta. */
.pxsite .hero--portal{color:#001701;}
/* flow-root para que el margen de abajo de la foto quede ADENTRO. En el origen
   cada pieza del hero va envuelta en un div.overflow-hidden (los wrappers de la
   animacion de entrada), asi que ese margen lo contiene el wrapper; aca la foto
   es hija directa y sus 40px colapsaban hacia afuera del hero: la foto quedaba
   pegada al borde de la caja de color, 40px menos de alto. */
.pxsite .hero-portal__wrap{margin:auto;max-width:918px;padding:0 16px;display:flow-root;}
.pxsite .hero-portal__eyebrow{display:inline-flex;align-items:center;gap:12px;min-height:40px;padding-right:16px;border-radius:100px;font-size:16px;line-height:18px;font-weight:400;margin-bottom:24px;}
.pxsite .hero-portal__eyebrow img{width:40px;height:40px;}
.pxsite .hero--portal h1{font-size:52px;line-height:62px;font-weight:600;margin:0 0 24px;}
/* El max-width de 22ch y el tracking de -.03em son de la regla generica .hero h2
   / .hero h1 del sistema, y el modulo no los tiene. El de la bajada era el peor:
   con 22ch la caja quedaba en 415px y el subtitulo ocupaba 342px de alto (nueve
   lineas) contra los 152 (cuatro) de la publicada. Es el mismo modo de falla que
   ya habia aparecido en el design2 de ERP. */
.pxsite .hero--portal h1,.pxsite .hero--portal h2{color:inherit;letter-spacing:normal;}
.pxsite .hero--portal h2{font-size:30px;line-height:38px;font-weight:500;margin:0 0 8px;max-width:none;}
/* El aire alrededor del boton NO es el padding de 54 del "__desc". Ese bloque
   esta vacio en el editable y no se emite. Arriba lo pone el "mt-lg-5 mt-4" de
   Bootstrap que lleva la fila de botones, y abajo el margen de la foto. Medido
   contra la publicada, entre el pie del subtitulo y el techo del boton hay 64px a
   1440 y 40 abajo de 992 (de los cuales 8 son el margen del h2), y entre el boton
   y la foto 56 y 30. Con los 54 fijos el boton entraba 22px tarde en tablet. */
.pxsite .hero-portal__cta{padding:56px 0;}
@media (max-width:991px){ .pxsite .hero-portal__cta{padding-top:32px;} }
@media (max-width:768px){ .pxsite .hero-portal__cta{padding-bottom:30px;} }
.pxsite .hero-portal__ctaRow{display:flex;gap:24px;flex-wrap:wrap;}
/* Linea de tranquilidad debajo de los botones (el __desc del CMS). Hoy ninguna de
   las dos paginas la trae. */
.pxsite .hero-portal__note{font-size:16px;line-height:24px;margin:0 0 40px;opacity:.75;}
/* ERP no tiene degradado en el hero: pone una imagen de fondo. */
.pxsite .hero--portal-img{background-image:var(--hero-bg);background-position:50%;background-repeat:no-repeat;background-size:cover;}
.pxsite .hero-portal__img{display:block;width:100%;max-height:379px;object-fit:cover;border-radius:20px;margin-bottom:40px;}
@media (max-width:768px){
  /* El padding-top que estaba en 0 era el peor de los siete: el eyebrow quedaba a
     16px del borde y el header (76px) le pasaba por encima 60px enteros, tapando
     el logo en ERP y en B2B. Acá la reserva es el alto pelado del header porque
     el aire ya lo pone el hero-portal__wrap (16px, la regla de abajo): el eyebrow
     queda 16px por debajo del menu, el mismo aire que deja la publicada de
     HubSpot (medido en b2b: header 12..88, eyebrow en 104). */
  .pxsite .hero.hero--portal{margin-bottom:50px;padding-top:var(--px-header-h, 88px);}
  .pxsite .hero-portal__wrap{padding:16px;}
  .pxsite .hero--portal h1{font-size:48px;line-height:55px;}
  .pxsite .hero--portal h2{font-size:18px;line-height:140%;}
  .pxsite .hero-portal__desc{padding:30px 0;}
  /* El "margin-bottom:0" del corte NO se aplica en la publicada: es una regla de
     una sola clase y la del design1 lleva tres, asi que la base de 40px le gana
     por especificidad aun dentro de la media query. Replicarlo "bien" dejaba la
     foto pegada al borde de la caja en mobile. */
}
/* El tope de 208px del corte de 425 tampoco aplica al design1, por lo mismo que
   el margin-bottom: la regla del modulo lleva tres clases y la del corte una. En
   design2 SI aplica (esa regla no declara max-height), y por eso vive en las
   reglas de hero--portal-center y no aca. Con el tope puesto, la foto de B2B
   quedaba 41px mas baja que en la publicada a 390. */

/* ── design2 del mismo modulo: el hero de ERP ───────────────────────────────
   El editable de ERP declara "design_style: "design2"" y el de B2B "design1". Son
   el MISMO modulo con dos diseños, y el porte de julio sirvio el de B2B en las
   dos. Todo lo de acá va bajo la doble clase para no mover a B2B.

   Lo que cambia, medido contra https://7398646.hs-sites.com/erp a 1440:

     · Titulo, bajada, chip y botones CENTRADOS.
     · La bajada es 16/24 peso 400, no 30/38 peso 500. Con la regla de design1 la
       bajada de ERP entraba en una caja de 415px y ocupaba 380px de alto (diez
       lineas) contra los 72 de la publicada.
     · La foto va a max-width:min(510px,100%) con width:auto, centrada, SIN
       recorte y sin radio: es un panel vertical de 510x632, no una banda ancha
       recortada a 379 de alto.
     · Los 54px de aire arriba y abajo del CTA son el padding del "__desc", que
       ERP no tiene: en su lugar el CTA lleva el "mt-lg-5 mt-4" de Bootstrap.
     · El color de texto es el default del campo (#001701), y los h1/h2 lo tienen
       que HEREDAR: en tema claro el encabezado trae su propio color y gana.
     · El hero arranca DEBAJO del header, con 12px de aire (la publicada le pone
       position:relative al menu). Sin esto el chip quedaba a 4px del menu. */
.pxsite .hero--portal-center{margin-top:calc(var(--px-header-h, 88px) + 12px);margin-left:12px;margin-right:12px;padding-bottom:0;text-align:center;}
/* Y el TRACKING va en normal, que es lo que el modulo deja. Las reglas globales de
   encabezado del repo le meten -0,03em al h1, y con eso el titular entraba en DOS
   lineas donde la publicada usa TRES: el segundo tramo mide 925px contra los 886
   de la caja, y los 56px que come el tracking negativo alcanzaban para que
   quepa. Es la diferencia de 62px de alto de todo el hero. */
.pxsite .hero--portal-center h1,.pxsite .hero--portal-center h2{color:inherit;letter-spacing:normal;}
.pxsite .hero--portal-center h2{font-size:16px;line-height:24px;font-weight:400;margin:0 0 8px;max-width:none;}
.pxsite .hero--portal-center .hero-portal__cta{padding:0;}
/* flex-column flex-md-row: apilados abajo de 768. */
.pxsite .hero--portal-center .hero-portal__ctaRow{justify-content:center;align-items:center;flex-direction:column;margin-top:24px;}
@media (min-width:768px){ .pxsite .hero--portal-center .hero-portal__ctaRow{flex-direction:row;} }
.pxsite .hero--portal-center .hero-portal__img{width:auto;max-width:min(510px,100%);max-height:none;object-fit:fill;border-radius:0;margin:0 auto;}
@media (min-width:992px){ .pxsite .hero--portal-center .hero-portal__ctaRow{margin-top:48px;} }
@media (max-width:768px){
  /* El aire contra el menu ya lo pone el margin-top, y la publicada le saca el
     padding-top al hero en este corte.

     La bajada NO baja a 18/140% como en design1: la regla del design2 lleva tres
     clases y la del corte una sola, asi que sigue en 16/24 en todos los anchos. */
  .pxsite .hero.hero--portal-center{padding-top:0;}
}
/* El tope de 208px de alto tambien aplica al design2 (la regla del modulo no
   distingue), y con width:auto la foto queda de 168x208. */
@media (max-width:425px){ .pxsite .hero--portal-center .hero-portal__img{max-height:208px;} }

/* ── Hero SIN arte ──────────────────────────────────────────────────────────
   ERP va sin la foto de los tres celulares (decision de Sofi del 04/08/2026), y
   ahi el hero cierra con los dos botones. El aire de abajo lo daba la foto, asi
   que hay que declararlo: van los mismos 100px que arriba, para que la caja
   quede simetrica. */
.pxsite .hero--portal-noart{padding-bottom:100px;}
@media (max-width:768px){ .pxsite .hero.hero--portal-noart{padding-bottom:48px;} }

/* Caso de uso: volanta en pastilla, titulo 30/38 y bajada 18px.
   El modulo se mete 70px hacia adentro de la caja y sus dos columnas son un row
   de Bootstrap: la canaleta es 24, no los 56 de la grilla del sistema (a 1440
