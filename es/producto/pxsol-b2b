/* ── Hotel Ads: el logo es el de Pxsol Studio ──────────────────────────────
   SOLO en esta página, igual que en la publicada, que lo pisa con un <style>
   propio (px-studio-logo). El generador del calco lo detectó y lo dejó afuera a
   propósito, porque el menú y el pie son el CHROME (módulos globales) y no
   parte de lo portado: por eso vive acá, scopeado con data-page, y no toca
   ninguna otra página.

   El menú trae DOS anclas de logo —una .--transparent y otra .--dark— y el CSS
   del módulo alterna cuál se muestra segun el header este sobre el hero o ya
   scrolleado. Hay que pisar las dos, o al scrollear vuelve el logo Pxsol.

   Se usa content:url(), la misma tecnica del origen, porque el src del <img> lo
   emite el módulo global y desde acá no se puede cambiar el atributo. El alto va
   fijo y el ancho auto, como allá: 36px en el menú y 38px en el pie. */
.pxsite[data-page="hotel-ads"] .px-header__logo-link.--transparent .px-header__logo-image{content:url(/producto/assets/ha-logo-studio-blanco.png);height:36px;width:auto;}
.pxsite[data-page="hotel-ads"] .px-header__logo-link.--dark .px-header__logo-image{content:url(/producto/assets/ha-logo-studio.png);height:36px;width:auto;}
.pxsite[data-page="hotel-ads"] .px-footer__logo img{content:url(/producto/assets/ha-logo-studio-blanco.png);height:38px;width:auto;}

/* ── El espacio que cada hero le reserva al header ─────────────────────────────
   El header del módulo global FLOTA sobre el hero (position:absolute, ver
   GlobalChromeBlock), así que NO ocupa lugar: el espacio de arriba lo tiene que
   reservar el hero. Ese espacio se escribe SIEMPRE como
   calc(var(--px-header-h, 88px) + aire) y nunca como un número suelto.

   Por qué la variable y no un número: el alto del header NO es fijo y encima se
   decide en otro lado. El CSS del header vive en la DB (es un WebModule), su
   alto sale del contenido de la barra (no de un height) y medido sobre
   producción da 76px de 320 a 1200 y 96px a partir de ~1280 — un salto que no
   cae en ningún breakpoint con nombre. El 64 que estaba hardcodeado era el alto
   del header REACT que estas páginas ya no usan: quedó mal en las cinco
   variantes de hero a la vez, y en mobile las media queries lo bajaban a 0-30px,
   dejando el badge encima del logo en 7 de las 12 (medido el 04/08/2026: erp y
   b2b 60px de solape, pms 46, motor 44, channel/crm/conversaciones 12).

   El 76px del fallback es el alto real en mobile, que es donde estas reservas
   aplican: con eso la página queda bien incluso sin JS. HeaderHeightVar mide el
   header de verdad y sobreescribe la variable, así el arreglo no se vuelve a
   romper si el header cambia de alto. */

/* El sitio real escribe estos chips en caja normal ("+ Property Management
   System", "+ Eficiencia en la Gestión de Limpieza") → sin uppercase. */
.pxsite .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:500;color:var(--mint-ink);background:var(--mint-bg);border:1px solid var(--mint-line);border-radius:100px;padding:7px 16px;}
.pxsite .sec{padding:74px 0;}
.pxsite .sec--tight{padding:52px 0;}
.pxsite .sec--alt{background:#fff;}
.pxsite .h2{font-size:clamp(28px,3.4vw,46px);}
.pxsite .lead{font-size:clamp(15px,1.4vw,17px);color:var(--body);line-height:1.65;}
.pxsite .center{text-align:center;}
.pxsite .mint{color:var(--mint);}
.pxsite .card{background:var(--card);border-radius:20px;box-shadow:var(--sh-card);}

/* ── Hero ────────────────────────────────────────────────────────────────── */
.pxsite .hero{padding:56px 0 22px;}
.pxsite .hero .grid{display:grid;grid-template-columns:1fr 1.02fr;gap:56px;align-items:start;}
.pxsite .hero h1{margin-top:20px;font-size:clamp(36px,5vw,52px);font-weight:500;letter-spacing:-.03em;}
.pxsite .hero h2{margin-top:14px;font-size:clamp(20px,2.2vw,26px);font-weight:500;color:var(--title);max-width:22ch;}
.pxsite .hero .paras{margin-top:20px;display:grid;gap:14px;max-width:52ch;}
.pxsite .hero .paras p{font-size:15px;color:var(--body);line-height:1.68;}
.pxsite .hero .cta{margin-top:26px;}
.pxsite .hero .panel{position:relative;background:linear-gradient(160deg,#F2FAF7 0%,#EAF5FF 100%);border:1px solid var(--stroke-2);border-radius:22px;padding:28px 0 0 28px;overflow:hidden;min-height:300px;display:grid;grid-template-columns:minmax(190px,.9fr) 1.25fr;gap:10px;align-items:start;}
.pxsite .hero .panel h3{font-size:20px;font-weight:600;letter-spacing:-.02em;line-height:1.22;}
.pxsite .hero .panel p{margin-top:10px;font-size:13.5px;color:var(--body);}
.pxsite .hero .panel .btn{margin:16px 0 26px;}
.pxsite .hero .panel .shot{align-self:end;border-radius:14px 0 0 0;box-shadow:-8px -8px 30px -14px rgba(1,14,61,.28);display:block;width:100%;}
.pxsite .hero .stats{margin-top:16px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.pxsite .hero .stat{background:var(--mint-bg);border:1px solid var(--mint-line);border-radius:16px;padding:14px 16px;}
.pxsite .hero .stat img{width:20px;height:20px;opacity:.9;}
.pxsite .hero .stat .v{display:block;margin-top:8px;font-size:24px;font-weight:600;color:var(--mint-ink);letter-spacing:-.02em;line-height:1.1;}
.pxsite .hero .stat .l{display:block;margin-top:2px;font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:#6E7C79;}
/* Variante pastilla (PMS): una línea de chips discretos bajo el demo. Va con
   doble clase para ganarle a las reglas de .hero--bg sin !important. */
.pxsite .hero .stats.stats--chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px;}
.pxsite .hero .stats--chips .stat{display:inline-flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--mint-line);border-radius:999px;padding:9px 18px 9px 12px;box-shadow:0 1px 2px rgba(15,23,43,.04);}
.pxsite .hero .stats--chips .stat img{width:22px;height:22px;opacity:1;}
.pxsite .hero .stats--chips .stat .v{margin:0;font-size:15px;font-weight:600;line-height:1.2;letter-spacing:0;color:#1F2D2A;}

/* ── Hero con degradado de fondo + demo de Arcade (px-shHero del PMS) ─────────
   Todo scopeado bajo .hero--bg y NO en .hero a secas: la clase .hero la
   comparten los heroes hero-wide y hero-split de las otras páginas, así que una
   regla suelta sobre .hero .grid les cambiaría las columnas.
   Medidas de la publicada: columnas 5/7, radio 20, el degradado apoyado abajo y
   al centro, y las cards de dato en #E8F4F8 con borde blanco. */
/* El padding de arriba lo tiene que poner el hero, porque el header FLOTA (ver
   GlobalChromeBlock): son los 56px del '.hero' base MAS los 64px que el header
   ocupaba cuando estaba en el flujo. Sin esto el menu se le encima al contenido —
   en PMS el badge quedaba pegado al menu (reportado por Sofi el 03/08/2026). */
.pxsite .hero--bg{background-repeat:no-repeat;background-position:center bottom;background-size:contain;border-radius:20px;padding-top:120px;padding-bottom:20px;}
.pxsite .hero--bg .grid{grid-template-columns:5fr 7fr;gap:40px;align-items:center;}
.pxsite .hero--bg .grid>div:first-child{max-width:433px;justify-self:end;}
.pxsite .hero--bg .eyebrow{background:rgba(74,178,156,.2);border-color:transparent;color:var(--title);min-height:40px;gap:12px;padding:0 16px 0 0;font-size:14px;}
.pxsite .hero--bg .eyebrow img{width:40px;height:40px;}
.pxsite .hero--bg h1{font-size:clamp(36px,4.4vw,52px);line-height:1.02;letter-spacing:-.02em;margin-bottom:30px;}
.pxsite .hero--bg h2{margin-top:0;font-size:clamp(20px,2.4vw,30px);line-height:1.07;font-weight:400;margin-bottom:30px;}
/* El demo de Arcade: el alto lo reserva "aspect-ratio", porque el iframe va
   absoluto y si no colapsa a 0.
   ⚠ Antes iba "padding-bottom:calc(56.25% + 41px);height:0", y esos 41px eran
   plata en la calle: el embed ("?embed&embed_desktop=inline") NO dibuja barra de
   reproductor propia — mete su lienzo 16:9 CENTRADO en el alto que le des. Los
   41px de sobra salían como una franja clara arriba y otra abajo del demo, dentro
   del panel. Se mide comparando el alto de la caja con "ancho*9/16"; a 1440 daba
   41px de más. El Arcade del cuerpo de Hotel Ads siempre fue 1040x585 —16:9
   exacto, sin los 41— y ahí nunca hubo franja. Reportado por Sofi el 25/08/2026. */
.pxsite .hero--bg .arcade{position:relative;width:100%;max-width:min(970px,100%);margin:0 auto;aspect-ratio:16/9;}
.pxsite .hero--bg .arcade iframe{position:absolute;inset:0;width:100%;height:100%;border:0;color-scheme:light;border-radius:14px;}
.pxsite .hero--bg .stats{margin-top:24px;gap:20px;}
/* Panel de espera del Arcade. El iframe se difiere (ver iframes-diferidos.ts) y
   ninguno de los dos contenedores tenia fondo propio, asi que en el hueco se
   transparentaba el hero: quedaba un agujero hasta que montaba. Con esto el
   espacio reservado se lee como el panel del demo cargando. El iframe va
   absoluto con inset 0, asi que al cargar lo tapa por completo, y lleva el
   mismo radio: no hace falta overflow hidden, que ademas romperia cualquier
   sticky de adentro. */
.pxsite .arcade,.pxsite .px-shHero__arcade{background:#f7f7f7;border-radius:14px;}
.pxsite .hero--bg .stat{background:#E8F4F8;border-color:#fff;padding:13px 24px;}
.pxsite .hero--bg .stat img{width:32px;height:32px;opacity:1;}
.pxsite .hero--bg .stat .v{margin-top:2px;font-size:clamp(22px,2.2vw,30px);font-weight:700;line-height:1.2;color:var(--mint);}
.pxsite .hero--bg .stat .l{margin-top:2px;font-size:14px;font-weight:500;letter-spacing:.04em;color:#74777A;}

/* ── Hero con Arcade ABAJO (px-shHero de Motor de reservas) ──────────────────
   Es el mismo modulo que el hero del PMS pero con imgarcade_location en
   "bottom", y eso cambia el reparto: arriba dos columnas iguales (titulo +
   bajada) y el Arcade a lo ANCHO debajo, no en una columna.

   Medidas de la publicada: caja con radio 20 y margen superior de 150px (80 en
   mobile), el degradado apoyado abajo y al centro, el bloque de texto sticky a
   30px del techo y una barra solida de 318px pegada al fondo.

   Va todo bajo .hero--arcade y NO bajo .hero a secas: la clase .hero la
   comparten hero-panel, hero-wide y hero-split de las otras 11 paginas. */
/* El header del sitio es oscuro y ocupa lugar, asi que el hero se mete DEBAJO
   con el margen negativo (mismo truco que hero--wide) y los 150px de aire de la
   publicada van como PADDING, no como margen: es literalmente lo que hace el
   modulo cuando el header es negro (body.px-header--black usa padding-top).
   El degradado va a su tamano NATURAL (2054px de ancho, el del PNG del CMS) y
   apoyado abajo y al centro: con cover se estira y tapa el hero de rojo. El
   archivo se guarda a la mitad y el background-size lo devuelve a escala — es
   un blur, no se nota, y pesa un cuarto.
   Sin overflow:hidden a proposito: convertiria al hero en el contenedor de
   scroll del bloque sticky y le romperia el pegado. El radio ya recorta el
   fondo. */
/* Sin el -64px: compensaba al header en el flujo y con un header que flota tiraba
   la tarjeta fuera del borde. Los 150px de padding ya le dejan el lugar al menu. */
.pxsite .hero--arcade{position:relative;margin:0 20px;padding:150px 0 20px;border-radius:20px;background-color:#000017;background-repeat:no-repeat;background-position:center bottom;background-size:2054px auto;}
.pxsite .hero--arcade .wrap{position:relative;z-index:2;}
/* El texto se queda pegado mientras el Arcade sube; el JS del hero le baja la
   opacidad hasta 0 a los 350px de scroll. */
.pxsite .hero--arcade .hero-sticky{position:sticky;top:30px;}
.pxsite .hero--arcade .grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;}
.pxsite .hero--arcade .txt{display:grid;gap:30px;justify-items:start;max-width:433px;justify-self:end;}
.pxsite .hero--arcade .desc{max-width:433px;}
.pxsite .hero--arcade h1{margin:0;font-size:clamp(36px,4.4vw,52px);font-weight:500;letter-spacing:-.02em;line-height:1.02;color:#fff;}
.pxsite .hero--arcade h2{margin:0;font-size:clamp(20px,2.4vw,30px);font-weight:400;line-height:1.07;letter-spacing:normal;color:#fff;}
.pxsite .hero--arcade .paras{display:grid;gap:24px;margin:0;max-width:none;}
.pxsite .hero--arcade .paras p{font-size:16px;line-height:24px;color:#fff;}
.pxsite .hero--arcade .cta{margin:0;}
/* El boton repetido de la columna de la bajada es SOLO de mobile, como en la
   publicada (d-lg-none). */
.pxsite .hero--arcade .cta--mob{display:none;}
/* El Arcade: el alto lo reserva "aspect-ratio" porque el iframe va absoluto y si
   no colapsa a 0.
   ⚠ Acá vivían los DOS huecos que reportó Sofi el 25/08/2026 ("un espacio en
   blanco muy grande arriba y abajo, unos márgenes horribles"), y ninguno de los
   dos era intencional:

     · "padding-bottom:calc(56.25% + 41px)" — un padding en % se resuelve contra
       el ancho del BLOQUE CONTENEDOR (acá ".wrap", 1184px a 1440), NO contra el
       ancho propio del elemento, que "max-width:min(970px,100%)" recorta a 970.
       Resultado: la caja se reservaba 1184*.5625+41 = 707px de alto para un
       lienzo de 970*9/16 = 546px. El embed centra su 16:9 en el alto que le
       dan, así que esos 161px de sobra salían como franja clara ARRIBA y ABAJO
       del demo. Los 41px además nunca hicieron falta: el embed inline no dibuja
       barra de reproductor (el Arcade del cuerpo de Hotel Ads es 1040x585, 16:9
       exacto, y nunca tuvo franja). Con "aspect-ratio" el alto sale del ancho
       REAL del elemento y el problema no puede volver.
     · "transform:scale(.85)" + "transform-origin:center bottom" — el efecto de
       la publicada (el demo entra al 85% y crece al 100% con el scroll). Escalar
       no cambia la caja de layout: al 85% el demo se dibujaba 824px de ancho
       dentro de una caja de 970, o sea 106px de aire muerto ARRIBA (por el
       origin abajo) y ~73px de recorte a cada lado que se leían como márgenes
       puestos a dedo. Se fue el scale y con él el JS que lo escribía en
       "ArcadeHero" (ProductPage.tsx): el demo arranca ya en su tamaño real. El
       texto sticky sigue desvaneciéndose, que eso sí es la publicada. */
.pxsite .hero--arcade .arcade{position:relative;width:100%;max-width:min(970px,100%);margin:40px auto 0;aspect-ratio:16/9;}
.pxsite .hero--arcade .arcade iframe{position:absolute;inset:0;width:100%;height:100%;border:0;color-scheme:light;border-radius:14px;}
.pxsite .hero--arcade .hero-bar{position:absolute;left:0;bottom:0;width:100%;height:318px;border-radius:0 0 20px 20px;z-index:1;}
/* Variante clara (Motor, 24/09/2026). El margen de 16px de arriba (pedido de
   Sofi: "que se separe un poquito del navegador") deja la franja clara de la
   página; como el hero también es claro, la base es blanca y lleva un borde
   finito para que la tarjeta se siga leyendo. El navbar se entera solo: muestrea
   el color que tiene detrás y pasa a tinta (scripts/pxsol-navbar/README.md). */
/* Brillos SUTILES y en las esquinas (24/09/2026): el rosa de .16 caía detrás del
   título, la bajada y el botón, y "se veía raro" (Sofi, Jam a61661ac). */
.pxsite .hero--arcade-light{background:radial-gradient(40% 45% at 100% 0%,rgba(255,42,58,.055),transparent 70%),radial-gradient(40% 45% at 0% 100%,rgba(108,169,255,.07),transparent 70%),#fff;border:1px solid rgba(11,13,23,.06);}
.pxsite .hero--arcade-light h1,.pxsite .hero--arcade-light h2{color:#0B0D17;}
.pxsite .hero--arcade-light .paras p{color:#3A3F4A;}
.pxsite .hero--arcade-light .paras p b{color:var(--page-acc,#C00001);}
/* Hero corto y CENTRADO (24/09/2026). Antes iba el h1 a la izquierda y la bajada
   con el botón a la derecha: las dos columnas tenían alturas distintas y la
   bajada quedaba "desfasada", más arriba que el título (Sofi). Ahora todo va
   apilado y centrado sobre la animación, que también está al centro. De dos
   propuestas (apilado a la izquierda / centrado) Sofi eligió esta, aunque deja
   de arrancar en la x del hero del PMS. Se reusa el botón de la columna de la
   bajada (el que en oscuro es solo de mobile). */
/* Todo lo del hero de Motor va bajo .hero--arcade-light: .hero--arcade la
   comparte el Motor de VR, que no pidió el cambio (QA de regresión, 24/09/2026).
   Margen arriba para separarlo del borde (Sofi) y la caja del demo al ancho
   entero del contenedor: arranca más chica y crece con el scroll (ArcadeHero). */
.pxsite .hero.hero--arcade-light{padding-top:120px;margin:16px 20px 0;}
.pxsite .hero--arcade-light .arcade{max-width:100%;aspect-ratio:16/9;transform-origin:center top;will-change:transform;}
.pxsite .hero--arcade-light .grid{grid-template-columns:1fr;gap:22px;justify-items:center;text-align:center;}
.pxsite .hero--arcade-light .txt{justify-self:stretch;justify-items:center;max-width:none;}
.pxsite .hero--arcade-light .desc{max-width:none;display:grid;justify-items:center;}
.pxsite .hero--arcade-light .txt .cta{display:none;}
.pxsite .hero--arcade-light .cta--mob{display:inline-flex;margin-top:28px;}
.pxsite .hero--arcade-light .paras p{font-size:20px;line-height:1.5;max-width:560px;margin:0 auto;}
.pxsite .hero--arcade-light .arcade{margin-top:56px;}
@media (max-width:767px){
  .pxsite .hero.hero--arcade-light{padding-top:calc(var(--px-header-h, 88px) + 16px);margin:12px 12px 0;}
  .pxsite .hero.hero--arcade-light .paras p{font-size:17px;line-height:1.45;}
  .pxsite .hero--arcade-light .cta--mob{margin-top:20px;}
  .pxsite .hero.hero--arcade-light .arcade{margin-top:32px;}
  /* En mobile la animación pasa a su versión de celular (el JS corta en 767px,
     el mismo quiebre): la caja reserva el lienzo del teléfono, 360x640, en vez
     del 16:9. Sigue siendo aspect-ratio, sin padding en % (arcade-sin-huecos). */
  .pxsite .hero--arcade .arcade.arcade--demo{aspect-ratio:360/640;max-width:360px;background:none;}
  .pxsite .hero.hero--arcade-light .mdemo{box-shadow:none;border-radius:0;}
}
/* La animación del motor (demo:"motor") ocupa la caja 16:9 de .arcade entera;
   el resto de su estilo vive en su Shadow DOM (motor-demo.ts). */
.pxsite .hero--arcade .mdemo{position:absolute;inset:0;border-radius:14px;overflow:hidden;}
.pxsite .hero--arcade .mdemo-play{position:absolute;right:12px;bottom:12px;z-index:3;width:34px;height:34px;padding:0;border:0;border-radius:50%;background:rgba(11,13,23,.66);color:#fff;display:grid;place-items:center;cursor:pointer;}
.pxsite .hero--arcade .mdemo-play svg{width:15px;height:15px;fill:currentColor;}
.pxsite .hero--arcade .mdemo-play:focus-visible{outline:2px solid var(--page-acc,#C00001);outline-offset:2px;}
.pxsite .hero--arcade-light .mdemo{box-shadow:0 40px 80px -24px rgba(11,13,23,.28),0 0 0 1px rgba(11,13,23,.06);}
.pxsite .hero--arcade-light .arcade iframe{box-shadow:0 40px 80px -24px rgba(192,0,1,.35),0 0 0 1px rgba(11,13,23,.06);}

/* ── Prueba social (carrusel-marcas de HubSpot) ────────────────────────────
   Porte fiel del módulo carrusel-marcas, que en HubSpot es GLOBAL: las 8
   páginas de producto que declaran proof muestran exactamente la misma tira.
   Medido con Chrome sobre la publicada a 1440, no deducido del CSS; el fuente
   y las mediciones estan en migracion-cms-hubspot/hotel-ads/.

   Lo que cambió respecto del porte de julio, y por qué importa:
     · los logos iban a 40px de ALTO fijo, recortados a 132px de ancho y en
       escala de grises. En el origen la única restricción es max-width:166px:
       el alto sale del aspecto natural y va de 44px (Del Bono, 3,74:1) a 97px
       (Quinto Centenario, 1,72:1). La tira mide ~97px de alto, no 40.
     · van A COLOR y con opacidad 1. El grayscale era del porte.
     · el separador es margin-right:16px en cada imagen, no un gap de 34.
     · la máscara del fade es 20%/80%, mucho más ancha que el 6%/94% del porte.

   Diferencia deliberada: en la publicada los 3 SVG los agranda Owl Carousel al
   medirlos con autoWidth (Amérian sale 154px cuando su tamaño natural es 138).
   Acá no se replica: es un artefacto del carrusel, no del diseño, y agrandar un
   logo vectorial por encima de su tamaño no lo pide ninguna regla del módulo.

   La cifra dice "alojamientos" y NO "hoteles" como la publicada: regla de marca.

   La tira ocupa el ANCHO COMPLETO (container-fluid con 12px), no el .wrap de
   1240: en el origen el carrusel arranca en el 33% exacto del viewport. */
.pxsite .proof{padding:12px 0 0;}
.pxsite .proof .row{display:flex;align-items:center;gap:0;}
.pxsite .proof.proof .wrap{max-width:none;padding:0 12px;}
.pxsite .proof .who{flex:0 0 33.3333%;box-sizing:border-box;display:flex;align-items:center;justify-content:flex-end;gap:12px;padding-right:24px;}
.pxsite .proof .who img{width:157px;max-width:157px;height:auto;flex:none;}
.pxsite .proof .who p{margin:0;font-size:18px;font-weight:400;line-height:26px;color:var(--title);}
/* El acento de la segunda linea es un DEGRADADO recortado al texto, no un color
   plano: --text-color-start #c00001 a --text-color-end #F4CCCC, igual en las 8. */
.pxsite .proof .who b{display:block;font-weight:400;background:linear-gradient(to right,#c00001 0,#F4CCCC 100%);-webkit-background-clip:text;background-clip:text;color:transparent;}
.pxsite .proof .logos{flex:1 1 auto;min-width:0;display:flex;align-items:center;overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 20%,#000 80%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 20%,#000 80%,transparent);}
.pxsite .proof .track{display:flex;align-items:center;gap:0;animation:pxmarquee 42s linear infinite;}
.pxsite .proof .track img{max-width:166px;width:auto;height:auto;margin-right:16px;flex:none;}
@keyframes pxmarquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
/* Una tira que se desplaza sola en loop es exactamente lo que reduced-motion
   apaga. Se detiene y quedan visibles los primeros logos. */
@media (prefers-reduced-motion:reduce){.pxsite .proof .track{animation:none;}}
/* El corte es 992, no 600: en el origen las dos columnas son col-lg-*, así que
   apilan en el breakpoint lg de Bootstrap, y ahí el bloque de la izquierda pasa
   a alinearse a la IZQUIERDA (justify-content:start del módulo). */
@media (max-width:991.98px){
  .pxsite .proof .row{flex-direction:column;align-items:stretch;gap:14px;}
  .pxsite .proof .who{flex:none;justify-content:flex-start;padding-right:0;}
  .pxsite .proof .logos{width:100%;}
}

/* ── Funcionalidades ─────────────────────────────────────────────────────── */
.pxsite .feats{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:44px;}
.pxsite .feat{background:var(--card);border-radius:20px;box-shadow:var(--sh-card);padding:26px 24px 28px;transition:transform .22s var(--ease),box-shadow .22s var(--ease);}
.pxsite .feat .n{width:38px;height:38px;border-radius:11px;background:#BFE4DA;color:#fff;font-size:15px;font-weight:600;display:grid;place-items:center;}
.pxsite .feat h3{margin-top:18px;font-size:19px;font-weight:400;line-height:1.3;}
.pxsite .feat h3 b{font-weight:600;}
.pxsite .feat p{margin-top:14px;font-size:14px;color:var(--body);line-height:1.62;}
@media (hover:hover) and (pointer:fine){.pxsite .feat:hover{transform:translateY(-3px);box-shadow:var(--sh-hi);}}

/* ── ¿Qué es? ────────────────────────────────────────────────────────────── */
.pxsite .whatis{display:grid;grid-template-columns:1fr 420px;gap:56px;align-items:center;}
/* image_location:"left" del CMS (GDS): la imagen pasa a la primera columna y el
   texto a la segunda, sin reordenar el HTML — el orden del DOM se queda como
   esta (texto primero) para que el lector de pantalla lea el titulo antes. */
.pxsite .whatis--flip{grid-template-columns:420px 1fr;}
.pxsite .whatis--flip > div{order:2;}
.pxsite .whatis--flip > img,.pxsite .whatis--flip >picture>img{order:1;}
.pxsite .whatis p{margin-top:20px;font-size:16px;color:var(--body);line-height:1.7;max-width:60ch;}
/* Volanta del bloque (el __title del CMS: 16/24 con 10px de aire, contra el
   __headline de 46/62 que es el titulo). Va pegada arriba del H2. */
.pxsite .whatis-eyebrow{margin-top:0;margin-bottom:10px;font-size:16px;line-height:24px;font-weight:400;opacity:.75;}
.pxsite .whatis img{width:100%;border-radius:22px;}
/* Claves visuales debajo del texto (points, hoy solo Motor): ícono en pastilla
   del acento de la página + título + una línea, en grilla de 2. */
.pxsite .whatis-points{list-style:none;margin:28px 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.pxsite .whatis-points li{display:grid;grid-template-columns:44px 1fr;column-gap:14px;row-gap:2px;align-items:start;padding:16px;border-radius:16px;background:#F5F6F8;}
.pxsite .whatis-ico{grid-row:span 2;width:44px;height:44px;border-radius:12px;display:grid;place-items:center;color:var(--page-acc,var(--red));background:color-mix(in srgb,currentColor 10%,transparent);}
.pxsite .whatis-ico svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
.pxsite .whatis-points strong{font-size:15px;line-height:1.35;font-weight:600;color:var(--title);}
.pxsite .whatis-points li>span:last-child{font-size:14px;line-height:1.5;color:var(--body);}

/* ── Tabs de herramientas ────────────────────────────────────────────────── */
/* Bajada del bloque de tabs. Solo la tiene CRM; PMS no la declara. */
.pxsite .tabs .tabs-desc{max-width:820px;margin:16px auto 0;text-align:center;font-size:16px;line-height:1.6;color:var(--body);}
.pxsite .tabs .tabbar{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:32px 0 34px;}
.pxsite .tabs .tabbtn{font-family:var(--ui);font-size:14px;color:var(--body);background:#fff;border:1px solid var(--stroke);border-radius:100px;padding:11px 20px;cursor:pointer;transition:all .18s var(--ease);}
.pxsite .tabs .tabbtn[aria-selected="true"]{background:var(--ink);border-color:var(--ink);color:#fff;}
@media (hover:hover) and (pointer:fine){.pxsite .tabs .tabbtn:hover{border-color:var(--ink);}}
.pxsite .tabs .panel{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;}
.pxsite .tabs .panel h3{font-size:clamp(22px,2.4vw,30px);}
.pxsite .tabs .panel .kick{margin-top:10px;font-size:15px;font-weight:600;color:var(--mint-ink);}
.pxsite .tabs .panel .paras{margin-top:14px;display:grid;gap:12px;}
.pxsite .tabs .panel .paras p{font-size:15px;color:var(--body);line-height:1.66;}
.pxsite .tabs .minis{margin-top:26px;display:grid;gap:12px;}
.pxsite .mini{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--stroke-2);border-radius:16px;padding:14px 16px;}
.pxsite .mini img{width:26px;height:26px;flex:none;margin-top:2px;}
.pxsite .mini h4{font-size:15px;}
.pxsite .mini p{margin-top:4px;font-size:13.5px;color:var(--body);line-height:1.55;}
.pxsite .tabs .shot{border-radius:22px;width:100%;max-height:430px;object-fit:contain;background:#fff;box-shadow:var(--sh-card);}

/* ── Tabs de herramientas, variante OSCURA (px-shFeaturesTabs del PMS) ────────
   Bloque negro redondeado con el título centrado, las pestañas como tres
   tarjetas grandes con ícono y la columna derecha como carrusel con dots.
   Es opt-in (variant:"dark"): CRM usa el mismo bloque en claro. */
.pxsite .tabs--dark{padding:74px 0;}
.pxsite .dtabs{background:#000;color:#fff;border-radius:20px;padding:110px 48px;}
/* El shell pinta TODOS los h1-h4 de .pxsite con var(--title), que es azul muy
   oscuro: sobre el negro de este bloque quedan ilegibles. Va primero para que las
   reglas de abajo (el acento menta, p. ej.) puedan pisarlo. */
.pxsite .dtabs h2,.pxsite .dtabs h3,.pxsite .dtabs h4{color:#fff;}
.pxsite .dtabs__title{color:#fff;text-align:center;font-size:clamp(28px,3.4vw,46px);line-height:1.35;font-weight:600;margin-bottom:60px;}
.pxsite .dtabs__title .mint{color:#fff;}
/* Las pestañas son una barra compacta, no tarjetas (pedido de Sofi, 23/09/2026):
   como tarjetas grandes con ícono de 108px parecían el contenido, y el contenido
   de verdad quedaba abajo, desconectado. Ahora la activa se marca en menta y el
   panel va pegado debajo, dentro de su propia caja. */
.pxsite .dtabs__tabs{display:flex;justify-content:center;gap:8px;width:fit-content;max-width:100%;margin:0 auto;padding:8px;background:#0E0F1F;border:1px solid rgba(255,255,255,.08);border-radius:18px;}
/* La tarjeta arranca a escala .95 y sube a 1 al activarse o al hover, con el
   borde blanco: es la microinteracción de la publicada. */
.pxsite .dtabs__tab{display:flex;align-items:center;gap:12px;background:transparent;border:1px solid transparent;border-radius:12px;padding:12px 20px 12px 12px;cursor:pointer;transition:background .25s var(--ease),border-color .25s var(--ease),color .25s var(--ease);color:rgba(255,255,255,.62);font-family:var(--ui);text-align:left;}
.pxsite .dtabs__tab[aria-selected="true"]{background:#1B1C36;border-color:rgba(74,178,156,.7);color:#fff;}
.pxsite .dtabs__tab:focus-visible{outline:2px solid var(--mint);outline-offset:2px;}
@media (hover:hover) and (pointer:fine){.pxsite .dtabs__tab:hover{color:#fff;}}
.pxsite .dtabs__tab img{flex:none;display:block;width:36px;height:36px;opacity:.55;transition:opacity .25s var(--ease);}
.pxsite .dtabs__tab[aria-selected="true"] img{opacity:1;}
.pxsite .dtabs__tabTitle{display:block;max-width:240px;font-size:16px;line-height:1.3;font-weight:600;}
.pxsite .dtabs__panel{display:grid;grid-template-columns:1fr 1fr;gap:48px;margin-top:24px;align-items:center;background:#0B0C1A;border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:48px;}
.pxsite .dtabs__contentTitle{font-size:clamp(26px,3.2vw,46px);line-height:1.13;font-weight:500;margin-bottom:24px;}
/* La parte en negrita del titular va con el degradado rosa→azul del módulo. Una
   de las tres pestañas lo tiene pisado a menta en el origen, y ese override
   viaja como dato (titleAccent) en vez de hardcodearse acá. */
.pxsite .dtabs__contentTitle b{font-weight:600;background:linear-gradient(90deg,#F7738B 0%,#6CA9FF 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.pxsite .dtabs__contentTitle[data-accent] b{background:none;-webkit-text-fill-color:currentColor;color:var(--dtabs-accent);}
.pxsite .dtabs__contentSub{font-size:clamp(19px,1.8vw,24px);line-height:1.42;font-weight:500;margin-bottom:24px;}
.pxsite .dtabs__col .paras{display:grid;gap:14px;}
.pxsite .dtabs__col .paras p{font-size:16px;line-height:1.5;color:rgba(255,255,255,.86);}
.pxsite .dtabs__slide{background:#17182E;min-height:380px;border-radius:20px;padding:48px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:10px;text-align:center;}
.pxsite .dtabs__slide img{width:27px;height:27px;}
.pxsite .dtabs__slide h4{font-size:clamp(22px,2.2vw,30px);line-height:1.27;font-weight:500;}
.pxsite .dtabs__slide p{font-size:16px;line-height:1.5;color:rgba(255,255,255,.86);}
.pxsite .dtabs__dots{display:flex;justify-content:center;gap:10px;margin-top:-40px;position:relative;}
.pxsite .dtabs__dot{width:12px;height:12px;border-radius:50%;border:0;background:rgba(255,255,255,.35);cursor:pointer;padding:0;transition:background .2s var(--ease);}
.pxsite .dtabs__dot[aria-current="true"]{background:#fff;}

/* ── Suite completa de gestión hotelera (px-shSolutionsGrid) ──────────────────
   Bento oscuro: pastilla + título + bajada centrados, la fila de métricas y
   abajo el swap de cuatro herramientas — la activa entera a la izquierda y las
   otras tres como tarjeta-botón a la derecha, la primera a dos columnas.
   La imagen del ángulo superior derecho la pone el renderer como background. */
.pxsite .sgrid{position:relative;background:linear-gradient(135deg,#020618 0%,#0F172B 50%,#0F172B 100%);border-radius:20px;padding:89px 69px 116px 60px;color:#fff;overflow:hidden;}
/* Mismo motivo que en .dtabs: el shell pinta los h1-h4 con var(--title). */
.pxsite .sgrid h2,.pxsite .sgrid h3,.pxsite .sgrid h4{color:#fff;}
.pxsite .sgrid::before{content:"";position:absolute;top:0;right:0;width:415px;height:415px;background-image:var(--sgrid-bg);background-repeat:no-repeat;background-position:top right;z-index:0;}
.pxsite .sgrid>*{position:relative;z-index:1;}
.pxsite .sgrid__head{text-align:center;}
.pxsite .sgrid__chip{background:rgba(74,178,156,.1);border-color:rgba(74,178,156,.3);color:var(--mint);border-radius:100px;padding:12px 16px;font-size:14px;font-weight:500;margin-bottom:20px;}
.pxsite .sgrid__title{color:#fff;font-size:clamp(30px,3.8vw,52px);line-height:1.19;font-weight:500;margin-bottom:5px;}
.pxsite .sgrid__desc{color:rgba(255,255,255,.6);font-size:18px;line-height:1.55;}
.pxsite .sgrid__metrics{display:flex;gap:24px;flex-wrap:wrap;margin:60px 0;}
.pxsite .sgrid__metric{flex:1;min-width:150px;background:#191E31;border:1px solid #2D3343;border-radius:16px;padding:25px;}
.pxsite .sgrid__metricLabel{display:block;font-size:14px;line-height:1.42;color:rgba(255,255,255,.6);}
.pxsite .sgrid__metricRow{display:flex;align-items:flex-end;gap:10px;margin-top:6px;}
.pxsite .sgrid__metricRow b{font-size:30px;font-weight:700;line-height:1.2;color:#fff;}
.pxsite .sgrid__metricRow i{font-style:normal;font-size:14px;font-weight:500;line-height:1.42;color:var(--mint);}
/* minmax(0,1fr) y no 1fr: con 1fr el min-content de la columna derecha (dos
   tarjetas con 48px de padding) le come el ancho a la izquierda y el panel activo
   sale más angosto que los botones. */
.pxsite .sgrid__body{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:stretch;}
.pxsite .sgrid__panel,.pxsite .sgrid__btn{position:relative;background:linear-gradient(74.79deg,rgba(255,255,255,.09) 11.38%,rgba(231,241,250,.15) 119.35%);border:1px solid rgba(239,253,255,.22);border-radius:20px;color:#fff;text-align:left;}
.pxsite .sgrid__panel{padding:155px 48px 48px;}
.pxsite .sgrid__toolTitle{display:flex;align-items:center;gap:10px;color:var(--mint);font-size:clamp(22px,2.2vw,30px);line-height:1.27;font-weight:700;margin-bottom:12px;}
/* En desktop el ícono del título va OCULTO (lo que se ve es la marca de agua del
   ángulo); reaparece pegado al texto solo en mobile, igual que en la publicada.
   Sin esto se superpone con la marca de agua y parte el título en dos líneas. */
.pxsite .sgrid__toolTitle img{display:none;width:auto;height:auto;max-width:38px;max-height:38px;}
.pxsite .sgrid__cat{display:inline-flex;align-items:center;gap:10px;padding:7px 12px;min-height:50px;border:1px solid rgba(255,255,255,.05);border-radius:6px;background:linear-gradient(74.79deg,rgba(255,255,255,.09) 11.38%,rgba(231,241,250,.15) 119.35%);color:#fff;font-size:18px;line-height:1.06;margin-bottom:12px;}
.pxsite .sgrid__cat img{width:20px;height:20px;flex:none;}
.pxsite .sgrid__toolSub{font-size:18px;line-height:1.11;font-weight:700;margin-bottom:20px;}
.pxsite .sgrid__panel .paras{display:grid;gap:12px;}
.pxsite .sgrid__panel .paras p{font-size:16px;line-height:1.5;color:#fff;}
/* La marca de agua del ángulo: el mismo ícono de la herramienta, en grande. */
.pxsite .sgrid__watermark{position:absolute;right:48px;top:48px;max-width:80px;width:auto;height:auto;}
.pxsite .sgrid__buttons{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-content:start;}
.pxsite .sgrid__btn{font-family:var(--ui);cursor:pointer;padding:48px;transition:all .3s var(--ease);}
.pxsite .sgrid__btn--first{grid-column:1 / -1;}
@media (hover:hover) and (pointer:fine){.pxsite .sgrid__btn:hover{background:#0F172B;border-color:#fff;transform:scale(1.05);}}
.pxsite .sgrid__btn .sgrid__toolSub{margin-bottom:0;}
.pxsite .sgrid__btn .sgrid__watermark{right:24px;top:24px;max-width:38px;}
/* Integraciones (integrations): dos filas de logos en tarjetas blancas que se
   desplazan en sentidos opuestos, con los bordes fundidos al fondo. Con
   reduced-motion quedan quietas y se pueden recorrer con scroll horizontal. */
.pxsite .integ{overflow:hidden;--integ-gap:18px;}
.pxsite .integ__head{text-align:center;max-width:760px;margin:0 auto;}
.pxsite .integ__chip{margin-bottom:18px;background:var(--mint-bg);border-color:var(--mint-line);color:var(--mint-ink);}
.pxsite .integ__lead{margin-top:16px;font-size:18px;line-height:1.6;color:var(--body);}
.pxsite .integ__rows{display:flex;flex-direction:column;gap:var(--integ-gap);margin-top:56px;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 12%,#000 88%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 12%,#000 88%,transparent 100%);}
.pxsite .integ__row{overflow:hidden;}
.pxsite .integ__track{display:flex;gap:var(--integ-gap);width:max-content;margin:0;padding:6px 0;list-style:none;animation:integ-scroll 60s linear infinite;}
.pxsite .integ__row--rev .integ__track{animation-direction:reverse;animation-duration:70s;}
@media (hover:hover) and (pointer:fine){.pxsite .integ__row:hover .integ__track{animation-play-state:paused;}}
.pxsite .integ__logo{flex:none;display:flex;align-items:center;justify-content:center;width:200px;height:96px;padding:18px 26px;background:#fff;border:1px solid #E6ECEA;border-radius:18px;box-shadow:0 1px 2px rgba(15,23,43,.04),0 10px 24px -18px rgba(15,23,43,.25);}
.pxsite .integ__logo img{display:block;max-width:100%;max-height:52px;width:auto;height:auto;object-fit:contain;}
.pxsite .integ__cta{display:flex;justify-content:center;margin-top:48px;}
/* La pista es la fila DOS veces con un gap entre medio: correrla la mitad más
   medio gap deja la copia exactamente donde estaba el original. */
@keyframes integ-scroll{from{transform:translateX(0);}to{transform:translateX(calc(-50% - var(--integ-gap) / 2));}}
@media (prefers-reduced-motion:reduce){.pxsite .integ__track{animation:none;}.pxsite .integ__row{overflow-x:auto;}.pxsite .integ__logo[aria-hidden="true"]{display:none;}}

/* "¿Qué es un PMS?" como diagrama (whatis-hub): áreas del hotel a los dos lados
   y el PMS en el centro. Cada área tira una línea punteada hacia el núcleo
   (::after), que es lo que cuenta la idea: todo pasa por un solo sistema. */
.pxsite .whub__head{text-align:center;max-width:760px;margin:0 auto;}
.pxsite .whub__lead{margin-top:16px;font-size:18px;line-height:1.6;color:var(--body);}
.pxsite .whub__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr) minmax(0,1fr);gap:56px;align-items:center;margin-top:56px;}
.pxsite .whub__col{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:18px;}
.pxsite .whub__area{position:relative;display:flex;align-items:center;gap:14px;min-height:108px;background:#fff;border:1px solid var(--mint-line);border-radius:16px;padding:18px 20px;box-shadow:0 1px 2px rgba(15,23,43,.04),0 8px 24px -16px rgba(15,23,43,.18);}
.pxsite .whub__area img{flex:none;width:32px;height:32px;}
.pxsite .whub__area b{display:block;font-size:17px;line-height:1.3;color:var(--ink,#1F2D2A);}
.pxsite .whub__area b+span{display:block;margin-top:4px;font-size:15px;line-height:1.5;color:var(--body);}
.pxsite .whub__area::after{content:"";position:absolute;top:50%;width:56px;border-top:2px dashed rgba(74,178,156,.55);}
.pxsite .whub__area--l::after{left:100%;}
.pxsite .whub__area--r::after{right:100%;}
.pxsite .whub__core{position:relative;display:flex;flex-direction:column;align-items:center;gap:14px;background:linear-gradient(160deg,#E4F3EE 0%,#F4FAF8 100%);border:1px solid var(--mint-line);border-radius:28px;padding:28px 24px 24px;box-shadow:0 24px 60px -30px rgba(31,94,80,.35);}
.pxsite .whub__core img{width:100%;height:auto;border-radius:16px;}
.pxsite .whub__coreLabel{display:inline-flex;align-items:center;background:var(--mint);color:#fff;font-weight:700;font-size:15px;letter-spacing:.02em;border-radius:999px;padding:8px 18px;}
.pxsite .whub__closing{margin:48px auto 0;max-width:640px;text-align:center;font-size:18px;line-height:1.55;font-weight:600;color:var(--ink,#1F2D2A);}

/* Vitrina de la Suite del PMS (solutions-showcase): lista de herramientas a la
   izquierda y la foto de la elegida a la derecha. El texto de la tarjeta abierta
   se despliega con grid-template-rows 0fr→1fr (anima el alto sin medirlo). */
.pxsite .sshow{padding-bottom:72px;}
.pxsite .sshow__body{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:32px;margin-top:56px;align-items:stretch;}
.pxsite .sshow__list{display:flex;flex-direction:column;gap:12px;}
.pxsite .sshow__item{display:block;width:100%;font-family:var(--ui);text-align:left;cursor:pointer;color:#fff;background:rgba(255,255,255,.04);border:1px solid rgba(239,253,255,.12);border-radius:16px;padding:18px 22px;transition:background .25s var(--ease),border-color .25s var(--ease),box-shadow .25s var(--ease);}
@media (hover:hover) and (pointer:fine){.pxsite .sshow__item:hover{border-color:rgba(239,253,255,.32);}}
.pxsite .sshow__item.is-on{background:linear-gradient(74.79deg,rgba(255,255,255,.09) 11.38%,rgba(231,241,250,.15) 119.35%);border-color:rgba(74,178,156,.55);box-shadow:inset 3px 0 0 var(--mint);}
.pxsite .sshow__item:focus-visible{outline:2px solid var(--mint);outline-offset:3px;}
.pxsite .sshow__itemHead{display:flex;align-items:center;gap:14px;}
.pxsite .sshow__itemHead img{flex:none;width:28px;height:28px;}
.pxsite .sshow__itemTitle{font-size:19px;line-height:1.3;font-weight:700;color:#fff;}
.pxsite .sshow__item.is-on .sshow__itemTitle{color:var(--mint);}
.pxsite .sshow__itemBody{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s var(--ease);}
.pxsite .sshow__item.is-on .sshow__itemBody{grid-template-rows:1fr;}
.pxsite .sshow__itemInner{display:block;min-height:0;overflow:hidden;}
/* Bajada y párrafo al MISMO tamaño (pedido de Sofi, 23/09/2026): la bajada se
   distingue solo por el peso y el color. */
.pxsite .sshow__sub{display:block;margin-top:14px;font-size:16px;line-height:1.6;font-weight:700;color:#fff;}
.pxsite .sshow__text{display:block;margin-top:6px;font-size:16px;line-height:1.6;color:rgba(255,255,255,.72);}
.pxsite .sshow__media{position:relative;min-height:440px;border-radius:20px;overflow:hidden;background:#0B1224;border:1px solid rgba(239,253,255,.12);}
.pxsite .sshow__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.03);transition:opacity .45s var(--ease),transform .7s var(--ease);}
.pxsite .sshow__img.is-on{opacity:1;transform:none;}.pxsite .sshow__metrics{position:relative;z-index:1;margin:48px 0 0;}
@media (prefers-reduced-motion:reduce){.pxsite .sshow__itemBody,.pxsite .sshow__img{transition:none;}}

/* ── Más características ─────────────────────────────────────────────────── */
.pxsite .more{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;}
.pxsite .more p{margin-top:16px;font-size:15.5px;color:var(--body);line-height:1.68;max-width:52ch;}
.pxsite .more .btn{margin-top:24px;}
/* La publicada del PMS pone la imagen a la IZQUIERDA. Se invierte con order y no
   reordenando el markup, para que el texto siga primero en el DOM (lectura y
   lectores de pantalla) y en mobile, donde la grilla colapsa a una columna. */
.pxsite .more--imgleft>div{order:2;}
.pxsite .more--imgleft>img,.pxsite .more--imgleft>picture>img{order:1;}
.pxsite .more img{width:100%;border-radius:22px;}

/* ── Banda CTA ───────────────────────────────────────────────────────────── */
.pxsite .band{background:var(--mint-bg);border-top:1px solid var(--mint-line);border-bottom:1px solid var(--mint-line);}
.pxsite .band .inner{display:flex;align-items:center;justify-content:space-between;gap:34px;padding:50px 0;}
.pxsite .band h2{font-size:clamp(24px,2.8vw,36px);max-width:20ch;}
.pxsite .band p{margin-top:12px;font-size:15px;color:#476059;max-width:56ch;line-height:1.65;}
/* Variante del PMS (px-shTcil): logo + título + bajada sobre una imagen de fondo,
   con la imagen del producto a la derecha y SIN botón. Es 8/4, no 50/50, y el
   fondo lo trae la propia imagen, así que se apagan los bordes de la banda base. */
.pxsite .band--bg{position:relative;isolation:isolate;background-repeat:no-repeat;background-size:cover;background-position:center;border:0;border-radius:0;}
/* La imagen de fondo termina en menta pleno contra el gris de la página, y eso
   se leía como una sección cortada (pedido de Sofi, 23/09/2026). Los dos velos
   funden la banda con lo que tiene arriba (sección blanca) y abajo (el fondo de
   la página), así el menta queda como un halo en el medio y no como un bloque. */
.pxsite .band--bg::before,.pxsite .band--bg::after{content:"";position:absolute;left:0;right:0;z-index:-1;pointer-events:none;}
.pxsite .band--bg::before{top:0;height:30%;background:linear-gradient(to bottom,#fff,rgba(255,255,255,0));}
.pxsite .band--bg::after{bottom:0;height:45%;background:linear-gradient(to bottom,rgba(247,248,248,0),#F7F8F8);}
.pxsite .band--bg .inner{align-items:center;gap:40px;padding:90px 70px;}
.pxsite .band--bg .inner>div:first-child{flex:0 1 66%;}
.pxsite .band--bg h2{font-size:clamp(28px,3.8vw,52px);line-height:1.19;font-weight:500;max-width:26ch;}
.pxsite .band--bg p{font-size:16px;line-height:1.5;color:var(--body);margin-top:24px;}
.pxsite .band__logo{display:block;max-width:74px;width:auto;height:auto;margin-bottom:20px;}
.pxsite .band__image{flex:0 1 34%;width:100%;max-width:420px;height:auto;}

/* ── Reseñas de hoteles (carrusel-hoteles, variante --custom-style1) ──────────
   Medidas EXACTAS del módulo de HubSpot: la reseña a la izquierda (columna de
   hasta 574px, padding 48, gap 40 entre el texto y las etiquetas) y la foto de
   519x646 a la derecha con la tarjeta blanca flotando arriba.
   Este bloque se repite en todas las páginas de producto y en la mayoría de las
   páginas web: lo que haya que ajustar se ajusta ACÁ y lo heredan todas. */
/* El H2 del bloque lleva las clases del helper (.h2 .center), así que el aire
   de 48px del origen se aplica desde el contenedor de la sección. */
.pxsite .hcar .wrap .h2{margin-bottom:48px;}
/* El stage es más ancho que .wrap (1240px) porque en el origen el carrusel vive
   en un container-fluid: ese aire de los costados es el que ocupan las flechas. */
.pxsite .hcar__stage{position:relative;max-width:1400px;margin:0 auto;padding:0 88px;}
.pxsite .hcar__item{display:flex;justify-content:center;align-items:center;}
.pxsite .hcar__info{display:flex;flex-direction:column;justify-content:space-between;gap:40px;padding:48px;max-width:574px;color:var(--title);}
.pxsite .hcar__stars{display:flex;gap:10px;margin-bottom:20px;}
.pxsite .hcar__stars img{width:18px;height:18px;}
.pxsite .hcar__desc{font-size:16px;font-weight:400;line-height:28px;margin:0 0 15px;color:var(--title);}
/* Square Peg es la manuscrita del origen (--tipography-square del tema). El
   fallback cursive importa: si la fuente no carga, el nombre igual se distingue
   del cuerpo en vez de verse como un párrafo más. */
.pxsite .hcar__author{font-family:"Square Peg",cursive;font-size:33px;font-weight:400;line-height:28px;color:#74777A;}
.pxsite .hcar__footer{display:flex;flex-wrap:wrap;gap:16px;}
/* El degradado va de transparente al color del producto, de izquierda a derecha.
   En esta variante el texto es oscuro (en la de fondo negro va blanco). */
.pxsite .hcar__tag{background:linear-gradient(90deg,hsla(0,0%,100%,0) 0,var(--product-color,#4AB29C) 100%);color:#262728;display:inline-flex;align-items:center;gap:10px;border-radius:8px;padding:6px 8px;font-size:14px;font-weight:600;line-height:18px;text-decoration:none;transition:transform .4s var(--ease);}
.pxsite .hcar__tag img{width:20px;height:20px;flex:none;}
@media (hover:hover) and (pointer:fine){.pxsite a.hcar__tag:hover{transform:scale(1.1);}}
.pxsite .hcar__imageWrapper{position:relative;flex:none;width:519px;height:646px;border-radius:12px;}
.pxsite .hcar__image{display:block;width:519px;height:646px;border-radius:12px;object-fit:cover;}
.pxsite .hcar__card{position:absolute;top:30px;right:30px;z-index:1;display:flex;align-items:center;gap:12px;background:#fff;border-radius:16px;padding:16px 24px;box-shadow:0 10px 15px -3px rgba(0,0,0,.1);color:#4A5565;font-size:14px;line-height:20px;}
/* Recuadro del LOGO del alojamiento. Va cuadrado con esquinas redondeadas y no
   circular como el avatar del origen: los 14 logos tienen proporciones muy
   distintas (de 3,5:1 a verticales) y en un círculo los anchos quedaban
   diminutos. Es el mismo tratamiento que el módulo le da a los logos en su otra
   variante (__logoWrapper: fondo blanco, radio 12, contain). */
/* Alto fijo y ancho ELÁSTICO (56–88px): los logos van de 3,5:1 a verticales, y en
   un cuadrado de 56 los apaisados quedaban en 11px de alto, ilegibles. Así el
   cuadrado se mantiene para los compactos y se ensancha solo para los anchos. */
.pxsite .hcar__cardIcon{display:flex;align-items:center;justify-content:center;flex:none;width:auto;min-width:56px;max-width:88px;height:56px;padding:6px;background:#fff;border-radius:12px;border:1px solid rgba(74,178,156,.25);overflow:hidden;}
.pxsite .hcar__cardIcon img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;}
.pxsite .hcar__cardText{display:flex;flex-direction:column;}
.pxsite .hcar__cardName{color:#101828;font-size:18px;font-weight:600;line-height:20px;}
.pxsite .hcar__nav{position:absolute;top:50%;transform:translateY(-50%);width:64px;height:64px;border:0;border-radius:50%;background:#F7F7F7;box-shadow:0 20px 25px -5px rgba(0,0,0,.1);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;}
.pxsite .hcar__nav svg{width:13px;height:23px;fill:#000017;}
.pxsite .hcar__nav--prev{left:15px;}
.pxsite .hcar__nav--next{right:15px;}
/* loop:false en el origen → en los extremos la flecha no da la vuelta. */
/* owl solo le baja la opacidad: el círculo y su sombra siguen ahí, si no la
   flecha desaparece contra el fondo claro de la página. */
.pxsite .hcar__nav:disabled{opacity:.5;cursor:default;}
@media (hover:hover) and (pointer:fine){.pxsite .hcar__nav:not(:disabled):hover{background:#fff;}}

/* ── FAQ ─────────────────────────────────────────────────────────────────── */
.pxsite .faq{max-width:880px;margin:0 auto;}
.pxsite .faq .item{background:#fff;border:1px solid var(--stroke-2);border-radius:16px;margin-top:12px;overflow:hidden;}
.pxsite .faq .q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:18px;background:none;border:0;cursor:pointer;padding:18px 22px;font-family:var(--ui);font-size:16px;font-weight:500;color:var(--title);text-align:left;}
.pxsite .faq .q svg{width:18px;height:18px;flex:none;stroke:var(--mint-ink);fill:none;stroke-width:2;transition:transform .2s var(--ease);}
.pxsite .faq .q[aria-expanded="true"] svg{transform:rotate(45deg);}
.pxsite .faq .a{padding:0 22px 20px;font-size:14.5px;color:var(--body);line-height:1.68;}
/* El link al hub de FAQ, al pie del acordeón de cada página de producto.
   ⚠ El color va con su propio selector '.pxsite .faq-mas a' y no con una clase
   sola: las hojas del sitio traen reglas de <a> con más especificidad que una
   clase suelta, y ese es el bug que dejó un link BLANCO SOBRE BLANCO dentro de un
   hero. Con el <a> nombrado en el selector, gana esta. */
.pxsite .faq-mas{max-width:880px;margin:18px auto 0;text-align:center;font-size:14.5px;}
.pxsite .faq-mas a{color:var(--mint-ink);font-weight:500;text-decoration:none;border-bottom:1px solid currentColor;}
.pxsite .faq-mas a:hover{opacity:.75;}
.pxsite .faq--split .faq-mas{text-align:left;}

/* ── Notas del blog ──────────────────────────────────────────────────────── */
.pxsite .posts{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:34px;}
.pxsite .post{background:#fff;border-radius:20px;box-shadow:var(--sh-card);overflow:hidden;transition:transform .2s var(--ease),box-shadow .2s var(--ease);}
.pxsite .post img{width:100%;height:180px;object-fit:cover;display:block;}
.pxsite .post .body{padding:18px 20px 22px;}
.pxsite .post .meta{font-size:12px;color:var(--muted);}
.pxsite .post h3{margin-top:8px;font-size:17px;line-height:1.35;}
@media (hover:hover) and (pointer:fine){.pxsite .post:hover{transform:translateY(-3px);box-shadow:var(--sh-hi);}}

/* ── Formulario de prueba ────────────────────────────────────────────────── */
.pxsite .trial{background:var(--ink);padding:70px 0;scroll-margin-top:80px;}
.pxsite .trial-grid{display:grid;grid-template-columns:1fr 460px;gap:56px;align-items:center;}
.pxsite .trial-copy h2{margin-top:18px;color:#fff;font-size:clamp(26px,3vw,40px);}
.pxsite .trial-copy .lead{margin-top:16px;color:#A9B1BD;}
.pxsite .trial-copy .ticks{list-style:none;margin:24px 0 0;padding:0;display:grid;gap:10px;}
.pxsite .trial-copy .ticks li{position:relative;padding-left:28px;font-size:14.5px;color:#D3D8DF;}
.pxsite .trial-copy .ticks li::before{content:"";position:absolute;left:0;top:4px;width:16px;height:16px;border-radius:50%;background:rgba(74,178,156,.2);border:1px solid var(--mint);}
.pxsite .trial-copy .ticks li::after{content:"";position:absolute;left:5px;top:8.5px;width:6px;height:3px;border-left:1.6px solid var(--mint);border-bottom:1.6px solid var(--mint);transform:rotate(-45deg);}
/* Variante CLARA del formulario (px-landingForm del PMS): el bloque no tiene panel
   oscuro, se apoya en el fondo de la página. La pastilla es celeste plana y el
   titular negro. Los ticks del bloque compartido se mantienen (son señales de
   confianza reales, no parte del diseño del módulo). */
.pxsite .trial--light{background:transparent;border-radius:50px;}
.pxsite .trial--light .trial-copy h2{color:var(--title);font-size:clamp(28px,3.8vw,52px);line-height:1.19;font-weight:500;margin-bottom:24px;}
.pxsite .trial--light .trial-copy .lead{color:var(--body);font-size:18px;line-height:1.55;}
.pxsite .trial--light .trial-copy .eyebrow{background:#E7F1FA;border:1px solid rgba(255,255,255,.2);border-radius:12px;color:var(--title);font-size:16px;font-weight:400;padding:8px 24px;text-transform:uppercase;}
.pxsite .trial--light .trial-copy .ticks li{color:var(--body);}
.pxsite .formcard{background:#fff;border-radius:22px;padding:26px 24px;box-shadow:var(--sh-hi);}
.pxsite .formcard .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.pxsite .formcard .field{margin-top:13px;}
.pxsite .formcard .field.mt0{margin-top:0;}
.pxsite .formcard label{display:block;font-size:12px;font-weight:600;color:var(--ink);margin-bottom:6px;}
.pxsite .formcard .rq{color:var(--red);}
.pxsite .formcard input,.pxsite .formcard select,.pxsite .formcard .inp{width:100%;font-family:var(--ui);font-size:15px;color:var(--body);background:#F8F9FA;border:1px solid var(--stroke);border-radius:12px;padding:12px 13px;transition:border .15s var(--ease),box-shadow .15s var(--ease),background .15s var(--ease);}
.pxsite .formcard input::placeholder,.pxsite .formcard .inp::placeholder{color:#A6A9AE;}
.pxsite .formcard input:focus,.pxsite .formcard select:focus,.pxsite .formcard .inp:focus{outline:none;background:#fff;border-color:var(--mint);box-shadow:0 0 0 3px rgba(74,178,156,.16);}
.pxsite .formcard input.bad,.pxsite .formcard .inp.bad{border-color:var(--red);background:#FFF6F6;}
.pxsite .formcard .err{font-size:11px;color:var(--red);margin-top:5px;display:none;}
.pxsite .formcard .err.on{display:block;}
.pxsite .formcard .err a{color:var(--red);font-weight:600;}
.pxsite .formcard .phone{display:grid;grid-template-columns:104px 1fr;gap:8px;}
.pxsite .formcard .fitq{margin-top:13px;border:0;padding:0;}
.pxsite .formcard .fitq legend{font-size:12px;font-weight:600;color:var(--ink);margin-bottom:6px;padding:0;}
.pxsite .formcard .opts{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.pxsite .formcard .opt{display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;font-size:13px;color:var(--body);background:#fff;border:1px solid var(--stroke);border-radius:12px;padding:11px 13px;cursor:pointer;transition:all .15s var(--ease);}
/* El radio hay que sacarlo del flujo, y el motivo importa: la regla de arriba
   estiliza TODOS los input del formulario con width:100% + fondo + borde + padding
   (lo necesitan los campos de texto) y eso también le caía al input[type=radio].
   Al ser flex item, ese width:100% lo hacía crecer hasta empujar la etiqueta al
   borde derecho: el radio quedaba a la izquierda y el "Sí" pegado a la derecha.
   El control es la CAJA entera (así está en la publicada y en crearcuenta), así
   que el input va oculto pero PRESENTE y enfocable —no display:none— para no
   romper teclado ni lectores de pantalla; el anillo de foco se pinta en la caja. */
.pxsite .formcard .opt{position:relative;}
.pxsite .formcard .opt input{position:absolute;width:1px;height:1px;opacity:0;margin:0;padding:0;border:0;accent-color:var(--mint);}
.pxsite .formcard .opt:has(input:focus-visible){border-color:var(--mint);box-shadow:0 0 0 3px rgba(74,178,156,.16);}
.pxsite .formcard .opt.sel{border-color:var(--mint);background:var(--mint-bg);color:var(--ink);font-weight:500;}
.pxsite .formcard .btn{margin-top:18px;}
.pxsite .formcard .srv{margin-top:12px;font-size:12.5px;color:var(--red);background:#FFF6F6;border:1px solid #F3C9CB;border-radius:10px;padding:10px 12px;line-height:1.5;}
.pxsite .formcard .rc{margin-top:12px;text-align:center;font-size:10.5px;color:#B6B9BE;}
.pxsite .formcard .fine{margin-top:10px;font-size:11px;color:var(--muted);text-align:center;line-height:1.5;}
.pxsite .formcard .fine a{color:var(--body);text-decoration:underline;}
.pxsite .formcard .hp-wrap{position:absolute!important;left:-9999px!important;top:-9999px!important;width:1px;height:1px;overflow:hidden;opacity:0;}
.pxsite .formcard .hotel-wrap{position:relative;}
.pxsite .formcard .hotel-menu{list-style:none;margin:6px 0 0;padding:5px;position:absolute;left:0;right:0;z-index:20;background:#fff;border:1px solid var(--stroke);border-radius:14px;box-shadow:var(--sh-hi);max-height:260px;overflow-y:auto;}
.pxsite .formcard .hotel-opt{display:flex;flex-direction:column;gap:1px;padding:9px 11px;border-radius:10px;cursor:pointer;}
.pxsite .formcard .hotel-opt.is-active{background:var(--mint-bg);}
.pxsite .formcard .hotel-opt-primary{font-size:14px;color:var(--ink);font-weight:500;}
.pxsite .formcard .hotel-opt-secondary{font-size:12px;color:var(--muted);}
.pxsite .formcard .hotel-verified{display:inline-flex;align-items:center;gap:6px;margin-top:6px;font-size:11.5px;color:#12855B;}
.pxsite .formcard .hotel-verified--warn{color:#9A6A00;}
.pxsite .formcard .done{text-align:center;padding:8px 6px 4px;}
.pxsite .formcard .done .ok{width:64px;height:64px;border-radius:50%;background:var(--mint-bg);color:var(--mint-ink);display:grid;place-items:center;margin:6px auto 18px;}
.pxsite .formcard .done .ok svg{width:30px;height:30px;}
.pxsite .formcard .done h3{font-size:22px;}
.pxsite .formcard .done p{margin-top:10px;font-size:14px;color:var(--body);line-height:1.6;}
.pxsite .formcard .done .creds{margin:18px 0;background:#F8F9FA;border:1px solid var(--stroke-2);border-radius:14px;padding:14px 16px;text-align:left;font-size:13px;}
.pxsite .formcard .done .creds .row{display:flex;justify-content:space-between;gap:12px;padding:4px 0;}
.pxsite .formcard .done .creds .row span{color:var(--muted);}
.pxsite .formcard .done .creds .row b{color:var(--ink);font-weight:500;}

/* ── CTA final ───────────────────────────────────────────────────────────── */
.pxsite .fcta{padding:64px 0;}
.pxsite .fcta .inner{display:grid;grid-template-columns:1fr 420px;gap:48px;align-items:center;}
.pxsite .fcta h2{font-size:clamp(26px,3vw,40px);max-width:24ch;}
.pxsite .fcta .btn{margin-top:24px;}
/* Solo la imagen de la sección, NO los íconos que van dentro del botón: con un
   .fcta img a secas, el ícono de WhatsApp del CTA (16px) se estiraba a 65px. */
.pxsite .fcta .inner>img,.pxsite .fcta .inner>picture>img{width:100%;border-radius:22px;}
/* El icono de WhatsApp, en blanco sobre el boton negro. Estaba como style inline
   y por eso no se podia pisar por pagina. */
.pxsite .fcta .btn img{width:16px;height:16px;flex:none;filter:brightness(0) invert(1);}

/* ══ Tema de la página ═════════════════════════════════════════════════════
   Dos sistemas visuales conviven mientras se migran las 12 páginas de producto:

   · light — con el que se construyó y publicó la de PMS: fondo casi blanco,
     acento menta, header blanco.
   · dark  — el del rediseño de Figma: header transparente sobre un hero oscuro,
     acento ROJO de marca, y secciones oscuras intercaladas (carrusel y bloque de
     reservas directas) sobre fondo claro.

   El acento se resuelve con la clase .acc en vez de hardcodear el color en el
   markup: así el renderer es uno solo y el color lo decide el tema de la página.
   En light, .acc da exactamente el mismo menta que usaba .mint.
   (Ojo: nada de backticks en estos comentarios — cortan el template literal.) */
.pxsite--light .acc{color:var(--mint);}
/* #C00001 es el rojo MEDIDO del diseño para el acento de los títulos de Motor de
   reservas: no es el rojo de marca (--red #D20A11) ni el del chip (#FF2A3A). Los
   tres conviven. Y el acento es POR PÁGINA: Channel Manager lo tiene naranja
   (#FF7316), así que el color sale de --page-acc y este es solo el default. */
.pxsite--dark .acc{color:var(--page-acc,#C00001);}
/* Títulos de sección, medidos: 46/52, SemiBold, -0.92px, casi negro. */
.pxsite--dark .h2{color:#060707;font-weight:600;line-height:1.13;letter-spacing:-.02em;}

/* ── Tema dark: header transparente sobre el hero ────────────────────────── */
.pxsite--dark .hdr{background:transparent;}
.pxsite--dark .hdr .navlink,.pxsite--dark .hdr .geo{color:#EDEFF2;}
.pxsite--dark .hdr .burger{color:#fff;}
.pxsite--dark .hdr .navlink[aria-expanded="true"]{color:#fff;}
@media (hover:hover) and (pointer:fine){.pxsite--dark .hdr .navlink:hover{color:#fff;}}
.pxsite--dark .hdr .right .btn--ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.42);}
.pxsite--dark .hdr .right .btn--dark{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.42);}
@media (hover:hover) and (pointer:fine){
  .pxsite--dark .hdr .right .btn--ghost:hover,.pxsite--dark .hdr .right .btn--dark:hover{background:rgba(255,255,255,.2);border-color:#fff;}
}
/* Al scrollear se separa del hero: ahí sí necesita fondo propio. */
.pxsite--dark .hdr.is-stuck{background:var(--dark);border-bottom-color:rgba(255,255,255,.1);}
/* El megamenú y el menú mobile son paneles claros: dentro vuelve el tema claro. */
.pxsite--dark .hdr .mega,.pxsite--dark .hdr .mnav{color:var(--title);}

/* Botón claro sobre fondo oscuro (CTA del hero del rediseño). El degradado, el
   borde celeste y el glow azulado son los del diseño, medidos. */
.pxsite .btn--light{
  background-image:linear-gradient(-87.3deg,rgba(255,255,255,.2) 8%,rgba(28,17,131,.2) 266%);
  color:#fff;border:1px solid #E7F1FA;border-radius:50px;padding:12px 24px;font-size:16px;font-weight:500;
  box-shadow:0 0 20px rgba(28,17,131,.3);
}
@media (hover:hover) and (pointer:fine){.pxsite .btn--light:hover{border-color:#fff;box-shadow:0 0 26px rgba(28,17,131,.45);}}

/* ── Hero del rediseño (párrafos al costado + screenshot ancho) ───────────── */
/* El header va transparente ENCIMA del hero (así está en el diseño), pero es
   sticky y ocupa lugar en el flujo: sin esto quedaría una franja blanca arriba
   con el logo blanco invisible. Se sube el hero los 64px del header y se los
   devuelve como padding; el header queda por encima por su z-index. */
/* Sin margen negativo: el header FLOTA (ver GlobalChromeBlock). El -64px existía para
   meter el hero debajo del header en React, que era sticky y de 64px; con un header
   que no ocupa lugar, tiraba el hero fuera del borde. El padding-top de 98px es el que
   le deja el lugar al menú, igual que en la publicada. */
.pxsite .hero--wide{position:relative;background:var(--dark);border-radius:0 0 26px 26px;padding:98px 0 0;overflow:hidden;}
/* El glow del diseño es CSS, no una imagen: el PNG original pesaba 1,9 MB (y el
   de Channel Manager, 1,3 MB). Toma el acento de la página, así el hero de cada
   producto queda del color de su diseño sin sumar un asset por página. */
.pxsite .hero--wide::before{content:"";position:absolute;left:-8%;top:18%;width:70%;height:70%;background:radial-gradient(closest-side,var(--page-glow,rgba(210,10,17,.28)),transparent 70%);pointer-events:none;}
/* Medidas del diseño (get_design_context sobre el nodo del hero), no a ojo: el
   bloque de texto es de 956px centrado —no ocupa todo el ancho— con 90px entre
   columnas y 24px entre los elementos de la izquierda. Con ese ancho el h1 de 52px
   cae en tres líneas como en el diseño. */
.pxsite .hero--wide .grid{position:relative;display:grid;grid-template-columns:1fr 1fr;grid-template-areas:"txt paras" "cta paras";grid-template-rows:auto 1fr;gap:24px 90px;align-items:start;max-width:956px;margin:0 auto;padding:74px 0 44px;}
.pxsite .hero--wide .txt{grid-area:txt;display:grid;gap:24px;justify-items:start;}
.pxsite .hero--wide .heroparas{grid-area:paras;}
.pxsite .hero--wide .cta{grid-area:cta;justify-self:start;align-self:start;margin:0;}
/* El chip: el ícono ya trae su propio fondo y padding (nodo "Icon product"). */
.pxsite .hero--wide .eyebrow{gap:12px;padding:0 16px 0 0;font-size:16px;line-height:24px;color:#E7F1FA;background:rgba(255,42,58,.1);border:0;}
.pxsite .hero--wide .eyebrow img{width:40px;height:40px;}
.pxsite .hero--wide h1{margin:0;font-size:clamp(36px,4vw,52px);font-weight:500;letter-spacing:-.02em;line-height:1.19;color:#fff;}
/* El diseño no le pone letter-spacing a este subtítulo (el h2 del shell sí). */
.pxsite .hero--wide h2{margin:0;font-size:clamp(22px,2.2vw,30px);font-weight:400;line-height:1.27;letter-spacing:normal;color:#fff;max-width:440px;}
/* Los párrafos del hero van en BLANCO 16/24 (medido), no en gris: el gris los
   hacía ver como texto secundario y en el diseño pesan igual que el título. */
.pxsite .hero--wide .paras{display:grid;gap:24px;margin:0;padding-top:4px;max-width:none;}
.pxsite .hero--wide .paras p{font-size:16px;line-height:24px;color:#fff;}

/* ══ hero--split (familia pdp-hero: GDS, POS, Agentes, Pagina web) ══════════
   Chip, titulo y parrafos TODOS a la izquierda; la imagen a la derecha. Se
   reusan el fondo, el radius, el margin-top negativo del header y el glow de
   hero--wide: es el mismo sistema visual, cambia el reparto.
   Medido en la publicada de GDS: dos columnas iguales (6-6 de bootstrap), h1 de
   52/62 en 636px, imagen de 636 de ancho a la derecha. Pagina web usa 7/5. */
.pxsite .hero--split{position:relative;background:var(--dark);border-radius:0 0 26px 26px;padding:98px 0 64px;overflow:hidden;}
.pxsite .hero--split::before{content:"";position:absolute;left:-8%;top:18%;width:70%;height:70%;background:radial-gradient(closest-side,var(--page-glow,rgba(73,37,152,.3)),transparent 70%);pointer-events:none;}
.pxsite .hero--split .grid{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:32px 64px;align-items:center;padding:74px 0 0;}
.pxsite .hero--split-75 .grid{grid-template-columns:7fr 5fr;}
.pxsite .hero--split .txt{display:grid;gap:24px;justify-items:start;}
.pxsite .hero--split .eyebrow{gap:12px;padding:0 16px 0 0;font-size:16px;line-height:24px;color:#E7F1FA;background:rgba(255,42,58,.1);border:0;}
.pxsite .hero--split .eyebrow img{width:40px;height:40px;}
.pxsite .hero--split h1{margin:0;font-size:clamp(36px,4vw,52px);font-weight:500;letter-spacing:-.02em;line-height:1.19;color:#fff;}
.pxsite .hero--split .paras{display:grid;gap:16px;margin:0;max-width:560px;}
.pxsite .hero--split .paras p{font-size:16px;line-height:24px;color:#fff;}
.pxsite .hero--split .art{justify-self:end;}
.pxsite .hero--split .art img{display:block;border-radius:14px;}
/* La tira de logos dentro del hero (solo Pagina web). */
.pxsite .hero--split .hero-logos{position:relative;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:28px 44px;margin-top:48px;}
.pxsite .hero--split .hero-logos img{height:44px;width:auto;opacity:.9;}
@media (max-width:900px){
  /* En mobile se apila: texto y despues la imagen, que pasa a ancho completo. */
  .pxsite .hero--split .grid,.pxsite .hero--split-75 .grid{grid-template-columns:1fr;gap:28px;}
  .pxsite .hero--split .art{justify-self:center;}
  .pxsite .hero--split .art img{width:100%!important;height:auto;}
  .pxsite .hero--split .paras{max-width:none;}
  .pxsite .hero--split .hero-logos{gap:20px 28px;margin-top:32px;}
  .pxsite .hero--split .hero-logos img{height:34px;}
}
/* En desktop los párrafos van completos y el "Leer más" no existe. */
.pxsite .hero--wide .readmore{display:none;}
.pxsite .hero--wide .shot{position:relative;display:block;width:100%;max-width:1100px;margin:0 auto;border-radius:16px 16px 0 0;box-shadow:0 -2px 0 rgba(255,255,255,.06),0 -40px 90px -50px rgba(0,0,0,.9);}

/* ── Funcionalidades con ícono de marca de agua ───────────────────────────── */
/* El padding-top tiene que dejar pasar el ícono COMPLETO: si no, un título de dos
   líneas se le mete por debajo (pasaba con "Promociones y ventas adicionales"). */
.pxsite .feats--icon .feat{position:relative;overflow:hidden;padding-top:106px;}
.pxsite .feats--icon .feat .wm{position:absolute;top:-16px;right:-6px;width:120px;height:120px;opacity:.85;pointer-events:none;}
.pxsite .feats--icon .feat h3{margin-top:0;font-size:19px;font-weight:600;letter-spacing:-.01em;}
.pxsite .feats--icon .feat p b{font-weight:600;color:var(--title);}
/* Variante SIN icono (Motor de reservas): el modulo del CMS los dibuja solo si
   declara icon_location, y esa pagina lo tiene vacio. Sin la marca de agua la
   card respira distinto: padding 48 y titulo 24/32, como sirve la publicada. */
.pxsite .feats--plain{gap:48px;}
.pxsite .feats--plain .feat{padding:48px;}
.pxsite .feats--plain .feat h3{margin-top:0;font-size:24px;font-weight:500;line-height:32px;letter-spacing:-.01em;}
.pxsite .feats--plain .feat p{margin-top:24px;font-size:16px;line-height:24px;}
.pxsite .feats--plain .feat p b{font-weight:700;color:var(--title);}
/* Ícono de línea arriba del título (lineIcon, Motor): misma pastilla que las
   claves de "¿Qué es?", un poco más grande. */
.pxsite .feat-ico{display:grid;place-items:center;width:52px;height:52px;margin-bottom:22px;border-radius:14px;color:var(--page-acc,var(--red));background:color-mix(in srgb,currentColor 10%,transparent);}
.pxsite .feat-ico svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
.pxsite[data-page="motor-de-reservas-hoteles"] .feats--plain .feat p{max-width:36ch;}

/* ── Carrusel de herramientas (sección oscura) ────────────────────────────── */
.pxsite .carou{background:var(--dark);border-radius:26px;margin:0 20px;padding:70px 0;}
/* Sin max-width: el diseño le da el ancho entero de la sección y el título cae en
   DOS líneas (1248x124 = 2 de 62). Con 22ch caía en tres. En mobile son tres, pero
   por el ancho del frame (348), no por un tope. */
/* El titulo se limita a 690px y deja MUCHO aire abajo (150px en el modulo del
   CMS, contra los 52 que habia): es lo que separa el titular de la seccion del
   bloque de contenido y sin eso los dos se leen como una sola cosa. Este bloque
   lo usa unicamente Motor de reservas. */
.pxsite .carou .h2{color:#fff;margin:0 auto;max-width:690px;}
.pxsite .carou-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center;margin-top:150px;}
.pxsite .carou-grid h3{font-size:clamp(26px,2.9vw,38px);font-weight:500;letter-spacing:-.03em;line-height:1.16;color:#fff;}
.pxsite .carou-grid h3 .dim{color:#6B7280;}
/* La parte resaltada con degradado (el <strong> del modulo del CMS). El
   color:transparent va con background-clip, y el fondo lo pone el inline style
   porque los dos colores son dato de la pagina. */
.pxsite .carou-grid h3 .grad{-webkit-background-clip:text;background-clip:text;color:transparent;}
.pxsite .carou-grid .sub{margin-top:22px;font-size:17px;font-weight:600;color:#fff;}
.pxsite .carou-grid .txt{margin-top:14px;font-size:14.5px;line-height:1.7;color:#A9B1BD;max-width:52ch;}
/* Card del carrusel — medida sobre el diseño (nodo 1541:2758, 579x510): fondo
   rgba(231,241,250,.1) SIN borde, radio 20, padding lateral 48 y CERO abajo
   (el arte se apoya en el fondo de la card), ícono de 108 con la sombra roja
   del kit, titulo 30/38 y parrafo 16/24 en blanco a 435px. El arte va a su
   tamaño natural, no a width:100%. */
/* overflow:hidden porque el arte NO es transparente: es un PNG opaco cuyo fondo es
   exactamente el color de esta card (#1E1F24). Va así porque el mockup de la
   notebook se dibuja en el Figma con mix-blend-mode y backdrop-filter, y sin fondo
   detrás pierde el cuerpo — está explicado en scripts/web-figma-svg-to-png.mjs.
   Como se apoya en el borde de abajo, sin el recorte sus esquinas cuadradas
   asomarían sobre el radio de la card en mobile, donde el arte casi la llena. */
.pxsite .carou-card{position:relative;overflow:hidden;min-height:510px;background:rgba(231,241,250,.1);border-radius:20px;padding:0 48px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:16px;}
/* El padding vertical es 24, no los 48 que declara el nodo: la card tiene alto
   FIJO (510) y el bloque de texto es flex-1, así que Figma le come el padding y
   termina renderizando 23.8 (medido en las coordenadas del icono y del párrafo).
   Con 48 la card se iba a 560 y el arte dejaba de apoyarse donde va. */
.pxsite .carou-card .cc-tx{flex:1;width:100%;padding:24px 0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;}
/* SIN filter drop-shadow, aunque el código que devuelve get_design_context lo
   traiga: en el render de Figma esa sombra queda casi tapada por el propio ícono,
   y aplicada como filtro CSS sobre la silueta se convierte en un glow rojo que el
   diseño no tiene. Los PNG salen del render de Figma, que ya la trae dentro
   (comparado contra el nodo 1541:2834, el maletín). */
.pxsite .carou-card .ico{width:108px;height:108px;display:block;}
.pxsite .carou-card h4{font-size:30px;font-weight:500;line-height:38px;color:#fff;}
.pxsite .carou-card .cc-tx p{font-size:16px;line-height:24px;color:#fff;max-width:435px;}
.pxsite .carou-card .shot{display:block;width:auto;max-width:100%;height:auto;}
/* Flecha sobre el borde derecho de la card, centrada vertical. Sin círculo:
   el diseño usa el chevron de 42px pelado, a 12px del borde. */
.pxsite .carou-card .next{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:42px;height:42px;padding:0;border:0;background:none;color:#fff;cursor:pointer;display:grid;place-items:center;border-radius:50%;}
.pxsite .carou-card .next svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.6;}
@media (hover:hover) and (pointer:fine){.pxsite .carou-card .next:hover{background:rgba(255,255,255,.12);}}
/* Dots: 12px con 12px de aire, en Celeste Pxsol (#E7F1FA) al 100% el activo y
   al 30% los otros — muestreado del nodo Nav horizontal. */
.pxsite .carou-nav{display:flex;align-items:center;justify-content:center;margin-top:24px;}
.pxsite .carou-nav .dots{display:flex;gap:12px;}
.pxsite .carou-nav .dot{width:12px;height:12px;padding:0;border:0;border-radius:50%;background:rgba(231,241,250,.3);cursor:pointer;transition:background .18s var(--ease);}
.pxsite .carou-nav .dot.on{background:#E7F1FA;}
/* ── Vitrina de motores reales (engine-showcase, Motor 24/09/2026) ──────────
   Coverflow sin posiciones absolutas: todas las cards comparten la MISMA celda
   de la grilla (así el alto sale del contenido) y se corren con translateX según
   --off, la distancia al activo. overflow-x:clip en la sección para que las que
   quedan afuera no generen scroll horizontal. */
/* Fondo casi plano (24/09/2026): el brillo rosa y celeste de .09/.12 más la
   sombra rojiza de la card "ensuciaban" las capturas (Sofi). Queda un halo gris
   apenas perceptible detrás del motor, y la sombra es neutra. */
.pxsite .engines{overflow-x:clip;background:radial-gradient(55% 45% at 50% 60%,rgba(11,13,23,.035),transparent 70%);}
.pxsite .engines .h2{margin:0 auto;max-width:760px;}
.pxsite .engines-lead{margin:18px auto 0;max-width:620px;text-align:center;font-size:17px;line-height:1.6;color:var(--body);}
.pxsite .engines-stage{position:relative;display:grid;margin-top:48px;touch-action:pan-y;user-select:none;}
.pxsite .eng-card{grid-area:1/1;justify-self:center;width:min(860px,78%);margin:0;border-radius:16px;overflow:hidden;background:#fff;box-shadow:0 20px 50px -30px rgba(11,13,23,.22),0 0 0 1px rgba(11,13,23,.07);transform:translateX(calc(var(--off) * 72%)) scale(.84);opacity:0;pointer-events:none;transition:transform .6s var(--ease),opacity .6s var(--ease),box-shadow .6s var(--ease);}
.pxsite .eng-card.is-on{transform:none;opacity:1;pointer-events:auto;z-index:2;box-shadow:0 28px 60px -30px rgba(11,13,23,.28),0 0 0 1px rgba(11,13,23,.07);}
.pxsite .eng-card.is-side{opacity:.5;pointer-events:auto;cursor:pointer;z-index:1;}
.pxsite .eng-card a{display:block;color:inherit;}
.pxsite .eng-card img{display:block;width:100%;height:auto;}
.pxsite .eng-bar{display:flex;align-items:center;gap:14px;height:38px;padding:0 14px;background:#F1F2F5;border-bottom:1px solid rgba(11,13,23,.06);}
.pxsite .eng-dots{display:flex;gap:6px;}
.pxsite .eng-dots i{width:10px;height:10px;border-radius:50%;background:#D5D8DE;}
.pxsite .eng-dots i:first-child{background:#FF5F57;}
.pxsite .eng-dots i:nth-child(2){background:#FEBC2E;}
.pxsite .eng-dots i:last-child{background:#28C840;}
.pxsite .eng-url{flex:1;max-width:420px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:6px;height:24px;border-radius:999px;background:#fff;font-size:12.5px;color:#4A4F57;}
.pxsite .eng-url svg{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:2;}
.pxsite .eng-nav{position:absolute;top:50%;z-index:3;width:48px;height:48px;padding:0;border:0;border-radius:50%;background:#fff;color:#0B0D17;box-shadow:0 8px 24px -8px rgba(11,13,23,.35);display:grid;place-items:center;cursor:pointer;transform:translateY(-50%);transition:transform .18s var(--ease);}
.pxsite .eng-nav svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
.pxsite .eng-nav--prev{left:calc(11% - 24px);}
.pxsite .eng-nav--next{right:calc(11% - 24px);}
@media (hover:hover) and (pointer:fine){.pxsite .eng-nav:hover{transform:translateY(-50%) scale(1.06);}}
/* Pausa del cambio automático (WCAG 2.2.2 / Art. 40): abajo a la derecha del escenario. */
.pxsite .eng-play{position:absolute;right:calc(11% + 12px);bottom:14px;z-index:3;width:36px;height:36px;padding:0;border:0;border-radius:50%;background:rgba(11,13,23,.72);color:#fff;display:grid;place-items:center;cursor:pointer;}
.pxsite .eng-play svg{width:16px;height:16px;fill:currentColor;}
.pxsite .eng-play:focus-visible{outline:2px solid var(--page-acc,#C00001);outline-offset:2px;}
.pxsite .engines-tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:36px;}
.pxsite .eng-tab{display:grid;gap:2px;padding:10px 18px;border-radius:14px;border:1px solid rgba(11,13,23,.1);background:#fff;text-align:left;cursor:pointer;transition:border-color .18s var(--ease),box-shadow .18s var(--ease);}
.pxsite .eng-tab strong{font-size:14px;font-weight:600;color:var(--title);}
.pxsite .eng-tab span{font-size:12.5px;color:var(--body);}
.pxsite .eng-tab.on{border-color:var(--page-acc,#C00001);box-shadow:0 0 0 3px color-mix(in srgb,var(--page-acc,#C00001) 14%,transparent);}
.pxsite .engines-cta{display:grid;justify-items:center;gap:12px;margin-top:32px;text-align:center;}
.pxsite .engines-cta .btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;}
.pxsite .engines-note{margin:0;font-size:13px;color:var(--body);opacity:.85;}
@media (prefers-reduced-motion:reduce){.pxsite .eng-card{transition:none;}}
@media (max-width:767px){
  .pxsite .engines-stage{margin-top:32px;}
  .pxsite .eng-card{width:100%;}
  .pxsite .eng-card.is-side{opacity:0;pointer-events:none;}
  .pxsite .eng-bar{height:30px;gap:10px;padding:0 10px;}
  .pxsite .eng-dots i{width:8px;height:8px;}
  .pxsite .eng-url{font-size:11px;height:20px;}
  /* En mobile la captura entera (un motor de escritorio a ~330px) no se leía:
     se muestra un recorte más cerrado de la misma imagen, 4:3 y anclado arriba
     a la izquierda, que deja buscador, comparador y la habitación al doble de
     tamaño. */
  .pxsite .eng-card img{aspect-ratio:4/3;object-fit:cover;object-position:6% 0;}
  /* Sin flechas en mobile: pisaban la captura. Se pasa deslizando o con los chips. */
  .pxsite .eng-nav{display:none;}
  .pxsite .eng-play{right:10px;bottom:10px;}
  .pxsite .engines-tabs{flex-wrap:nowrap;justify-content:flex-start;overflow-x:auto;margin:24px -16px 0;padding:0 16px 4px;scrollbar-width:none;}
  .pxsite .eng-tab{flex:none;}
}
/* Variante "grid" (Motor, 23/09/2026): las herramientas juntas y a lo ancho en
   vez de una card por vez. Intro centrada y tres cards iguales debajo. */
.pxsite .carou--grid{padding:96px 0;}
.pxsite .carou--grid .tg-intro{max-width:760px;margin:56px auto 0;text-align:center;}
.pxsite .carou--grid .tg-intro h3{font-size:clamp(24px,2.6vw,34px);font-weight:500;letter-spacing:-.02em;line-height:1.2;color:#fff;}
.pxsite .carou--grid .tg-intro h3 .dim{color:#6B7280;}
.pxsite .carou--grid .tg-intro h3 .grad{-webkit-background-clip:text;background-clip:text;color:transparent;}
.pxsite .carou--grid .tg-intro .sub{margin-top:16px;font-size:17px;font-weight:500;color:#C3C9D2;}
.pxsite .carou--grid .tg-intro .txt{margin:14px auto 0;font-size:15px;line-height:1.7;color:#A9B1BD;max-width:60ch;}
.pxsite .tg-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px;}
.pxsite .tg-card{display:flex;flex-direction:column;align-items:flex-start;gap:14px;padding:36px 30px;border-radius:20px;background:rgba(231,241,250,.07);border:1px solid rgba(255,255,255,.08);}
.pxsite .tg-card .ico{width:72px;height:72px;display:block;margin-bottom:6px;}
.pxsite .tg-card h4{font-size:22px;line-height:1.25;font-weight:500;color:#fff;}
.pxsite .tg-card p{font-size:15px;line-height:1.6;color:#C3C9D2;}
@media (max-width:991px){
  .pxsite .tg-cards{grid-template-columns:1fr;gap:16px;margin-top:40px;}
  .pxsite .carou--grid{padding:64px 0;}
  .pxsite .carou--grid .tg-intro{margin-top:36px;}
}
@media (max-width:560px){
  .pxsite .whatis-points{grid-template-columns:1fr;}
}

/* ── ¿Por qué usar? (3 cards con ilustración) ─────────────────────────────── */
.pxsite .whycards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:44px;}
.pxsite .whycard{background:var(--card);border-radius:20px;box-shadow:var(--sh-card);padding:14px 14px 26px;}
.pxsite .whycard img{width:100%;border-radius:14px;display:block;}
.pxsite .whycard h3{margin-top:20px;padding:0 10px;font-size:19px;font-weight:500;line-height:1.28;color:var(--title);text-align:center;}
.pxsite .whycard h3+p{margin-top:10px;}
.pxsite .whycard p{margin-top:20px;padding:0 10px;font-size:14px;line-height:1.62;color:var(--body);text-align:center;}

/* ── Pasos de distribución (Channel Manager) ──────────────────────────────────
   Bloque oscuro con los 3 pasos APILADOS; lo que rota es el trío de cards de cada
   paso. Valores MEDIDOS con get_design_context sobre el frame 1498:2824, no sobre
   la página publicada — los dos difieren y manda el diseño:
     · el fondo es #000017 (Negro Pxsol), no el --dark del tema
     · el título es 46/62 (la publicada lo deja en 46/52)
     · NO hay separadores: el aire lo da el padding de 90px de cada bloque
     · el chip es un fondo translúcido SIN borde, con el ícono a 33px
     · la negrita del título lleva un degradado VERTICAL blanco→rosa→rojo
     · el párrafo va BLANCO
     · la card lleva la ilustración abajo, recortada por su borde */
.pxsite .steps{background:#000017;border-radius:50px;margin:0 20px;padding:60px 0;}
.pxsite .steps-h2{color:#fff;max-width:690px;margin:0 auto;font-size:clamp(28px,3.4vw,46px);line-height:1.348;}
/* Ilustración de arriba del bloque, solo en POS. Va centrada y a su tamaño
   natural (con max-width para que no desborde en mobile). */
.pxsite .steps-art{display:block;margin:0 auto 24px;max-width:100%;height:auto;}
.pxsite .step{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center;padding:90px 0;}
/* Los pasos alternan de qué lado queda el carrusel. */
.pxsite .step--left .step-txt{order:2;}
.pxsite .step--left .step-car{order:1;}
.pxsite .step-txt{display:flex;flex-direction:column;align-items:flex-start;gap:24px;}
.pxsite .step-chip{display:inline-flex;align-items:center;gap:9.5px;padding:8px 12px;background:rgba(255,255,255,.05);border-radius:6px;font-size:18px;line-height:19px;color:#fff;}
.pxsite .step-chip img{width:33px;height:33px;flex:none;opacity:.8;}
.pxsite .step-txt h3{margin:0;font-size:clamp(28px,3.4vw,46px);font-weight:500;line-height:1.13;letter-spacing:-.02em;color:#fff;}
/* El número queda en blanco: el degradado es solo para la parte en negrita. */
.pxsite .step-txt h3 .step-n{color:#fff;}
.pxsite .step-txt h3 b{
  font-weight:500;
  background:linear-gradient(to bottom,rgba(231,241,250,.5) 12.5%,rgba(221,126,133,.35) 55.5%,rgba(210,10,17,.2) 98.6%);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;
}
.pxsite .step-txt h4{margin:0;font-size:clamp(20px,2.2vw,30px);font-weight:500;line-height:1.27;color:#fff;}
.pxsite .step-txt>p{margin:0;font-size:16px;line-height:1.5;color:#fff;}
.pxsite .step-card{position:relative;display:flex;flex-direction:column;justify-content:flex-end;height:510px;padding:0 48px;border-radius:20px;background:rgba(231,241,250,.1);text-align:center;color:#fff;overflow:hidden;}
/* El bloque de texto se sube 45px: así queda el aire de abajo para la ilustración. */
.pxsite .step-card__tx{display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:48px 0;margin-bottom:-45px;}
/* SIN filter drop-shadow. El codigo que devuelve get_design_context trae un
   drop-shadow(0 4px 2px #F93F3F) sobre el icono, pero en el render de Figma esa
   sombra se ve casi tapada por el propio icono, y aplicada como filtro CSS sobre
   la silueta se convierte en un glow rojo que el diseño no tiene. Los PNG salen
   del render de Figma, que ya la trae dentro (comparado ícono por ícono). */
.pxsite .step-card .ico{width:108px;height:108px;display:block;}
.pxsite .step-card h5{margin:0;font-size:clamp(22px,2.2vw,30px);font-weight:500;line-height:1.27;color:#fff;}
.pxsite .step-card p{margin:0;font-size:16px;line-height:1.5;color:#fff;}
.pxsite .step-card__art{display:block;width:100%;max-width:489px;margin:0 auto;height:auto;}
/* La flecha va sobre el borde derecho de la card, centrada. */
.pxsite .step-next{position:absolute;right:0;top:50%;transform:translateY(-50%);width:42px;height:42px;padding:0;border:0;background:none;color:#fff;cursor:pointer;display:grid;place-items:center;}
.pxsite .step-next svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;}
@media (hover:hover) and (pointer:fine){.pxsite .step-next:hover{opacity:.7;}}
.pxsite .step-dots{display:flex;gap:12px;align-items:center;justify-content:center;padding:24px 10px 0;}
.pxsite .step-dots .dot{width:12px;height:12px;padding:0;border:0;border-radius:100px;background:rgba(231,241,250,.35);cursor:pointer;transition:background .18s var(--ease);}
.pxsite .step-dots .dot.on{background:#E7F1FA;}

/* ── Directorio de canales de reserva (Channel Manager) ───────────────────────
   Valores MEDIDOS con get_design_context sobre el frame 1517:3115. Donde el
   diseño y el módulo publicado difieren, manda el diseño:
     · la card es #F7F7F7 (el mismo fondo de la página: la separa la sombra, no
       el color) con sombra de 6px de blur, no blanca con 12px
     · la ranura del logo es de 50px, no de 68
     · la descripción es 16/24 en #060707, no 15px en gris
     · el borde de los controles es #D2D0D5 y el círculo del buscador #000017
     · el botón de "ver más" es oscuro con borde rojo #DC0001
   El título va en dos líneas, con la primera en el acento (#C00001). */
.pxsite .dir .h2 .acc{display:block;}
.pxsite .dir-lead{max-width:827px;margin:24px auto 0;text-align:center;font-size:16px;line-height:24px;color:#060707;}
.pxsite .dir-lead b{font-weight:700;}
.pxsite .dir-h3{margin-top:48px;text-align:center;font-size:clamp(24px,2.8vw,40px);font-weight:500;line-height:1.2;letter-spacing:-.02em;color:#060707;}
.pxsite .dir-filters{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:24px;align-items:center;margin-top:48px;}
.pxsite .dir-search{position:relative;}
.pxsite .dir-search input{width:100%;height:52px;padding:0 56px 0 12px;background:#fff;border:1px solid #D2D0D5;border-radius:8px;font-family:var(--ui);font-size:16px;line-height:24px;color:#353535;}
.pxsite .dir-search input::placeholder{color:#353535;}
.pxsite .dir-search input::-webkit-search-cancel-button{margin-right:6px;}
.pxsite .dir-search svg{position:absolute;right:8px;top:8px;width:36px;height:36px;padding:6px;border-radius:100px;background:#000017;stroke:#fff;fill:none;stroke-width:1.8;stroke-linecap:round;pointer-events:none;}
.pxsite .dir-sel{position:relative;}
.pxsite .dir-filters select{width:100%;height:52px;padding:0 56px 0 12px;background:#fff;border:1px solid #D2D0D5;border-radius:8px;font-family:var(--ui);font-size:16px;color:#353535;appearance:none;-webkit-appearance:none;}
/* El círculo del diseño. Con pointer-events en none para que el clic siga
   llegando al select nativo que está debajo. */
.pxsite .dir-circle{position:absolute;right:8px;top:8px;width:36px;height:36px;border-radius:100px;background:#000017;display:grid;place-items:center;pointer-events:none;}
.pxsite .dir-circle svg{width:20px;height:20px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
.pxsite .dir-count{width:140px;text-align:right;font-size:18px;font-weight:500;line-height:1.4;color:#060707;}
/* Sin align-items:start las cards de una fila se estiran a la más alta. Con
   start, un nombre que cae en dos líneas dejaba la fila con los bordes de abajo
   desparejos. */
.pxsite .dir-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:48px;margin:48px 0 0;}
/* La sombra del diseño es un DROP_SHADOW, pero acá va como box-shadow: sobre un
   rectángulo opaco se ve idéntico, y un filter en la card rompe el
   loading=lazy de los logos — Chrome deja de detectarlos como visibles y no
   dispara ni una request (verificado: con filter cargaban 0 de 53, sin filter
   cargan todos). */
.pxsite .dircard{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;padding:24px;border-radius:20px;background:#F7F7F7;box-shadow:-2px -2px 6px rgba(1,14,61,.1);}
.pxsite .dircard.off{display:none;}
/* Recorte de la primera pintura, antes de hidratar (ver DirectorySection). */
.pxsite .dir-grid.is-capped>.dircard:nth-child(n+9){display:none;}
/* El logo va a 50px de alto y ancho intrínseco (en el diseño cada uno mide
   distinto: 169, 131, 94, 75…), con un tope en px. OJO: con la card en
   align-items:center el contenedor del logo pasa a ser shrink-to-fit, así que
   un max-width:100% en la imagen se resuelve contra un ancho indefinido y la
   ranura colapsa a 0 (pasó). El tope va en px. */
.pxsite .dircard .logo{display:flex;align-items:center;justify-content:center;height:50px;flex:none;}
.pxsite .dircard .logo img{height:50px;width:auto;max-width:200px;object-fit:contain;display:block;}
/* Respaldo cuando el canal no tiene logo: iniciales sobre el color de su marca.
   La publicada hace <img src=""> y muestra 15 imágenes rotas.
   Va en un cuadrado y no a todo el ancho: estirado se lee como una banda de
   color, no como el lugar de un logo. */
.pxsite .dircard .logo--mono{width:50px;border-radius:12px;overflow:hidden;}
.pxsite .dircard .logo span{font-size:20px;font-weight:600;letter-spacing:-.01em;color:#fff;}
.pxsite .dircard .tx{width:100%;display:flex;flex-direction:column;gap:12px;}
.pxsite .dircard h4{font-size:clamp(18px,1.8vw,24px);font-weight:500;line-height:1.42;color:#060707;}
.pxsite .dircard p{font-size:16px;line-height:24px;color:#060707;}
.pxsite .dir-empty{padding:80px 24px;text-align:center;color:var(--body);}
.pxsite .dir-empty .t{font-size:17px;font-weight:600;color:var(--title);margin-bottom:8px;}
.pxsite .dir-more{margin-top:48px;text-align:center;}
.pxsite .dir-btn{min-width:230px;height:52px;padding:12px 24px;background:#000017;color:#fff;border:1px solid #DC0001;border-radius:50px;font-size:16px;font-weight:500;line-height:24px;}
@media (hover:hover) and (pointer:fine){.pxsite .dir-btn:hover{background:#12122b;}}

/* ── FAQ: respuestas que son una lista de puntos ─────────────────────────────── */
.pxsite .faq .a ul{margin:10px 0 0;padding-left:20px;display:grid;gap:8px;}
.pxsite .faq .a li{list-style:disc;}
.pxsite .faq .a li b{color:var(--title);font-weight:600;}

/* ── Ebook ────────────────────────────────────────────────────────────────── */
.pxsite .ebook-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;}
.pxsite .ebook-grid p{margin-top:18px;font-size:15.5px;line-height:1.68;color:var(--body);max-width:46ch;}
.pxsite .ebook-grid .btn{margin-top:26px;}
/* Imagen a la izquierda (image_location del CMS). Se reordenan las columnas y
   no se cambia el markup, asi el orden de lectura en mobile sigue siendo
   texto -> imagen. */
.pxsite .ebook--flip>div:first-child{order:2;}
.pxsite .ebook--flip .ebook-art{order:1;}
.pxsite .ebook-art{background:#EAF2FB;border-radius:22px;display:grid;place-items:center;padding:26px;}
.pxsite .ebook-art img{width:100%;max-width:420px;height:auto;display:block;}

/* ── Reservas directas sin comisiones (sección oscura + 4 cards) ──────────── */
/* La banda CTA que sigue es la CONTINUACIÓN de este bloque oscuro (así está en el
   diseño): esta sección redondea solo arriba y la banda cierra abajo. */
.pxsite .vals{background:var(--dark);border-radius:26px 26px 0 0;margin:0 20px;padding-bottom:30px;}
.pxsite .vals-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;}
.pxsite .vals .kicker{font-size:clamp(22px,2.4vw,31px);font-weight:500;letter-spacing:-.02em;color:#fff;}
.pxsite .vals .h2{margin-top:26px;color:#fff;max-width:18ch;}
.pxsite .vals-lead{margin-top:22px;font-size:14.5px;line-height:1.7;color:#A9B1BD;max-width:54ch;}
.pxsite .valgrid{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
.pxsite .valcard{position:relative;background:var(--dark-2);border:1px solid rgba(255,255,255,.09);border-radius:18px;padding:26px 22px;min-height:206px;}
.pxsite .valcard img{position:absolute;top:22px;right:22px;width:28px;height:28px;}
.pxsite .valcard h3{margin-top:38px;font-size:16px;font-weight:600;color:#fff;line-height:1.3;}
.pxsite .valcard p{margin-top:14px;font-size:13.5px;line-height:1.6;color:#A9B1BD;}
.pxsite .valcard--accent{background:var(--red);border-color:var(--red);}
.pxsite .valcard--accent h3{margin-top:0;}
.pxsite .valcard--accent p{color:rgba(255,255,255,.92);}
/* Pie del bloque de cards (px-shFeatureCards__footer). Ocupa las dos columnas de
   la grilla, con el fondo tenue que usa la publicada (#E7F1FA al 10%). */
.pxsite .vals-foot{grid-column:1/-1;display:grid;gap:20px;justify-items:center;text-align:center;margin-top:34px;padding:34px 28px;border-radius:20px;background:rgba(231,241,250,.1);}
/* El texto va en BLANCO: la banda vive dentro del panel oscuro y estaba
   heredando el gris del cuerpo, o sea gris oscuro sobre casi negro. Le pasaba a
   las 5 paginas que usan este pie (App conversaciones, CRM, GDS, Motor y POS),
   no solo a Motor. En el modulo del CMS el color lo hereda del bloque, que es
   #fff. */
.pxsite .vals-foot p{margin:0;max-width:720px;font-size:18px;line-height:28px;color:#fff;}
/* El color del chip es dato de la pagina (en Motor es el rojo #FF2A3A del CMS);
   sin el se quedaba con el menta del tema, que ahi no pinta. */
.pxsite .vals-foot .eyebrow{margin:0;border-color:transparent;}

/* ── Banda CTA: en el tema dark es un panel dentro del bloque oscuro ─────── */
.pxsite--dark .band{background:var(--dark);border:0;margin:0 20px;border-radius:0 0 26px 26px;padding:0 0 70px;}
.pxsite--dark .band .inner{background:var(--dark-2);border:1px solid rgba(255,255,255,.07);border-radius:24px;flex-direction:column;align-items:flex-start;gap:18px;padding:44px 46px;}
.pxsite--dark .band h2{font-size:15px;font-weight:400;color:#C3C8D0;max-width:60ch;}
.pxsite--dark .band h2 b{display:block;margin-top:4px;font-weight:600;color:#fff;}
.pxsite--dark .band .eyebrow{background:rgba(210,10,17,.18);border-color:rgba(210,10,17,.42);color:#FF8A8F;margin-bottom:18px;}
.pxsite--dark .band .btn--dark{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.5);}
@media (hover:hover) and (pointer:fine){.pxsite--dark .band .btn--dark:hover{background:rgba(255,255,255,.18);border-color:#fff;}}

/* ── Tema dark: piezas que en light son menta y acá van con el rojo ──────── */
.pxsite--dark .faq .q svg{stroke:var(--red);}
.pxsite--dark .fcta .eyebrow{color:#A81015;background:#FDECEC;border-color:#F6D3D4;}
/* En este diseño el bloque de prueba gratis va sobre fondo CLARO (en la página
   de PMS es oscuro). El formulario en sí mantiene el verde: así está en el
   diseño y así está validado el flujo de alta. */
.pxsite--dark .trial{background:var(--bg);}
.pxsite--dark .trial-copy h2{color:var(--title);}
.pxsite--dark .trial-copy .lead{color:var(--body);}
.pxsite--dark .trial-copy .ticks li{color:var(--body);}

/* ── Responsive ──────────────────────────────────────────────────────────── */
@media (max-width:1080px){
  /* Una columna, y el orden del diseño mobile: título → párrafos → CTA. */
  .pxsite .hero--wide .grid{grid-template-columns:1fr;grid-template-areas:"txt" "paras" "cta";grid-template-rows:auto;gap:22px;}
  .pxsite .carou-grid,.pxsite .ebook-grid,.pxsite .vals-grid{grid-template-columns:1fr;gap:34px;}
  /* El aire de 150px del titulo es de desktop; en el corte chico el modulo lo
     baja a 90 y con una sola columna 150 abriria un hueco enorme. */
  .pxsite .carou-grid{margin-top:90px;}
  .pxsite .whycards{grid-template-columns:1fr;}
  .pxsite .hero--wide h1,.pxsite .hero--wide h2,.pxsite .vals .h2{max-width:none;}
  /* Hero con Arcade: una sola columna y las dos cajas a ancho completo. */
  .pxsite .hero--arcade .grid{grid-template-columns:1fr;gap:24px;}
  .pxsite .hero--arcade .txt,.pxsite .hero--arcade .desc{max-width:none;justify-self:stretch;}
}
/* Debajo de 768px la publicada apaga el efecto de scroll: el texto deja de ser
   sticky (si no, tapa el Arcade). El mismo corte que usa el modulo. (El Arcade
   ya no se escala en ningun corte — ver el bloque de ".hero--arcade .arcade".) */
@media (max-width:767px){
  /* Doble clase a proposito: mas abajo, en el corte de 600px, hay un
     .pxsite .hero{padding:30px 0 10px} para los otros heroes que empata en
     especificidad y, por venir despues, le comia el padding a este.
     Sin el margin-top:-64px que estaba acá: compensaba al header REACT, que
     ocupaba lugar. Con el header del modulo, que flota, subia la tarjeta 64px
     fuera del borde — se le comia las esquinas redondeadas de arriba y dejaba el
     h1 debajo del menu (el solape de 44px del Motor). Es el mismo arreglo que ya
     se le hizo al desktop, que quedo pendiente en este corte. */
  .pxsite .hero.hero--arcade{margin:0 12px;padding:calc(var(--px-header-h, 88px) + 16px) 0 20px;background-size:1200px auto;}
  .pxsite .hero--arcade .hero-sticky{position:static;}
  .pxsite .hero--arcade .arcade{margin-top:28px;}
  .pxsite .hero--arcade .hero-bar{display:none;}
  /* El CTA de arriba se esconde y aparece el de la columna de la bajada, como
     el par d-none d-lg-inline-flex / d-lg-none de la publicada. */
  .pxsite .hero--arcade .txt .cta{display:none;}
  .pxsite .hero--arcade .cta--mob{display:inline-flex;margin-top:16px;}
  .pxsite .hero--arcade h1{font-size:40px;line-height:40px;}
  .pxsite .hero--arcade h2{font-size:18px;line-height:18px;}
  .pxsite .hero--arcade .txt{gap:16px;}
  .pxsite .hero--arcade .paras p{line-height:20px;}
}
@media (max-width:600px){
  /* La reserva del header la pone el GRID y el hero queda en 0: así el fondo
     oscuro llega al borde de arriba (el header flota encima) y el contenido
     arranca 16px por debajo del header. Doble clase a proposito: mas abajo hay
     un .pxsite .hero{padding:30px 0 10px} que empata en especificidad y, por
     venir despues, le comia la reserva — era el solape de 12px que Sofi reporto
     en Channel Manager, CRM y Conversaciones. */
  .pxsite .hero.hero--wide{padding-top:0;border-radius:0 0 18px 18px;}
  .pxsite .hero--wide .grid{padding:calc(var(--px-header-h, 88px) + 16px) 0 30px;gap:26px;}
  /* El margen que trae .hero .paras sumaba al gap del grid y abría un hueco entre
     el subtítulo y el párrafo, y otro entre "Leer más" y el CTA. */
  .pxsite .hero--wide .paras{gap:14px;margin-top:0;}
  .pxsite .hero--wide .grid{gap:16px;}
  /* Mobile: el hero muestra SOLO el primer párrafo recortado en 4 líneas y el resto
     detrás de "Leer más" (frame Android Compact). El recorte con line-clamp deja el
     "…" al final, como en el diseño, en vez de un degradado. */
  .pxsite .hero--wide .paras--collapsible:not(.is-open) p:not(:first-child){display:none;}
  .pxsite .hero--wide .paras--collapsible:not(.is-open) p:first-child{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;}
  .pxsite .hero--wide .readmore{display:inline-block;justify-self:start;margin-top:10px;padding:0;font-family:var(--ui);font-size:15px;font-weight:600;color:var(--red);background:none;border:0;cursor:pointer;}
  /* En mobile el subtítulo del hero va en blanco y en negrita, no en gris. */
  .pxsite .hero--wide h2{color:#fff;font-weight:600;}
  .pxsite .hero--wide .shot{border-radius:10px 10px 0 0;}
  .pxsite .carou,.pxsite .vals{margin:0 12px;border-radius:18px;}
  .pxsite .carou{padding:48px 0;}
  /* Mobile (frame 1541:3156): la card baja a 16px de padding lateral, el bloque
     de texto queda pegado al arte (sin el gap de 16 del desktop) y la flecha NO
     está — el diseño la deja fuera del ancho de la card. */
  .pxsite .carou-card{min-height:0;padding:0 16px;gap:0;}
  .pxsite .carou-card .cc-tx{padding:16px 0;}
  .pxsite .carou-card .next{display:none;}
  .pxsite .valgrid{grid-template-columns:1fr;gap:14px;}
  .pxsite .valcard{min-height:0;}
  .pxsite .feats--icon .feat{padding-top:84px;}
  .pxsite .feats--icon .feat .wm{width:96px;height:96px;top:-12px;}
  .pxsite .ebook-art{padding:18px;}
  .pxsite--dark .band{margin:0 12px;padding:0 0 48px;border-radius:0 0 18px 18px;}
  .pxsite .vals{border-radius:18px 18px 0 0;}
  .pxsite--dark .band .inner{padding:28px 22px;}
}

/* Etiqueta solo para lectores de pantalla (los controles del directorio llevan
   su label oculto: el diseño usa placeholder y el placeholder no es un label). */
.pxsite .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}

/* ── Responsive (base, compartido) ───────────────────────────────────────── */
@media (max-width:1080px){
  .pxsite .hero .grid,.pxsite .whatis,.pxsite .tabs .panel,.pxsite .more,.pxsite .trial-grid,.pxsite .fcta .inner{grid-template-columns:1fr;gap:34px;}
  .pxsite .feats,.pxsite .posts{grid-template-columns:1fr 1fr;}
  .pxsite .band .inner{flex-direction:column;align-items:flex-start;}
  /* Hero del PMS: el Arcade primero y el texto debajo se apilan solos al colapsar
     la grilla; solo hay que soltar el ancho fijo de la columna de texto. */
  .pxsite .hero--bg .grid>div:first-child{max-width:none;justify-self:stretch;}
  /* Tabs oscuras: las 3 tarjetas-pestaña en una columna y el panel apilado. */
  .pxsite .dtabs{padding:60px 24px;}
  .pxsite .dtabs__tabs{flex-direction:column;width:100%;}
  .pxsite .dtabs__tabTitle{max-width:none;}
  .pxsite .dtabs__panel{grid-template-columns:1fr;gap:34px;margin-top:16px;padding:28px 22px;}
  /* Bento: el panel activo arriba y los botones abajo, en una sola columna. */
  .pxsite .sgrid{padding:52px 26px;}
  .pxsite .integ{--integ-gap:12px;}
  .pxsite .integ__rows{margin-top:32px;}
  .pxsite .integ__logo{width:150px;height:76px;padding:14px 18px;}
