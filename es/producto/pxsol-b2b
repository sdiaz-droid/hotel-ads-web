/* ══ Hotel Ads ══════════════════════════════════════════════════════════════
   Las 8 secciones propias de la página de Hotel Ads. Es la más bespoke de las
   12: no reusa la plantilla de producto. Relevamiento: spec/producto-hotel-ads.md

   El acento de la página es #00B1ED (cyan) y llega por --page-acc, así que acá
   NO se hardcodea: se usa var(--page-acc). Los valores del hero están medidos
   con get_design_context sobre el nodo 1916:4653. */

/* ── Chips ─────────────────────────────────────────────────────────────────
   Dos variantes: acc va sobre fondo oscuro (fondo del acento al 10% y texto
   celeste) y soft sobre fondo claro (pastilla celeste con el acento de texto). */
.pxsite .chip{display:inline-flex;align-items:center;gap:12px;border-radius:100px;font-size:16px;line-height:24px;}
.pxsite .chip--acc{background:color-mix(in srgb,var(--page-acc,#00B1ED) 10%,transparent);color:#E7F1FA;padding-right:16px;}
.pxsite .chip--acc img{width:40px;height:40px;padding:8px;border-radius:100px;background:color-mix(in srgb,var(--page-acc,#00B1ED) 20%,transparent);box-sizing:border-box;}
.pxsite .chip--soft{background:color-mix(in srgb,var(--page-acc,#00B1ED) 12%,#fff);color:var(--page-acc,#00B1ED);padding:8px 18px;font-size:14px;}
.pxsite .h2--center,.pxsite .lead--center{text-align:center;}
.pxsite .lead--center{max-width:64ch;margin-left:auto;margin-right:auto;}

/* ── 1. Hero tarjeta ───────────────────────────────────────────────────────
   OJO: este hero NO es el hero--wide. hero--wide es full-bleed y lleva el
   header transparente por encima; este es una TARJETA con el menú ADENTRO,
   inset 24px y radius 20 (medido: 1-Hero-Section en x=24/y=24, 1392 sobre 1440,
   rounded 20). Manda el Figma, aunque la regla del marco canónico diga 12/16.
   El fondo es #000017 (Negro Pxsol), no el --dark del tema. */
/* El header es sticky y ocupa sus 64px en el FLUJO, asi que sin esto la tarjeta
   arranca debajo de el y el menu queda afuera, sobre el fondo claro y con el
   texto blanco invisible. Se sube la tarjeta (64 del header menos los 24 de
   inset = 40) para que su borde superior quede en y=24 y el menu caiga ADENTRO,
   como en el frame. Mismo truco que hero--wide, con otro numero. */
/* ⚠ Bloque MUERTO desde el port de Hotel Ads (03/08): hero-card era un kind
   exclusivo de esa página y hoy su hero es ha-hero, markup portado bajo
   .ha-embed con su propio CSS. Nadie declara hero-card en content/.
   (Sin backticks: esto vive dentro de un template literal y lo cerrarían.)
   Queda acá, sin tocar, junto a las otras ~150 reglas muertas de Hotel Ads
   (.mkt, .pil, .adv, .pri, .mea, .cas, .pro, .hstat): se borran todas juntas
   después de verificar uso por clase, porque varias las comparten otras páginas.
   Por eso este bloque conserva la versión de master (el header flotante de
   #4356) y NO los valores medidos de la publicada que traía la rama del port:
   aplicarlos a código muerto no cambia nada, y sí chocarían con el header que
   ahora flota. */
/* Ya no se sube la tarjeta. Antes se la subía 40px (los 64 del header en el flujo
   menos los 24 del inset) para que el menu cayera adentro; ahora el header FLOTA y
   lo que se hace es bajarlo los 24px del inset, así el marco queda en y=24 como en
   el Figma y el menu cae adentro sin depender del alto del header. */
.pxsite .hero--card{padding:0;background:transparent;}
.pxsite:has(.hero--card) [data-pxsol-global="header"] .px-header{top:24px;}
.pxsite .hero--card-frame{position:relative;margin:0 24px;border-radius:20px;background:#000017;backdrop-filter:blur(5px);overflow:hidden;padding:140px 0 48px;}
/* El glow del diseño es CSS y no un PNG: el del hero de Motor pesaba 1,9 MB.
   Toma el acento de la página. */
.pxsite .hero--card-frame::before{content:"";position:absolute;left:38%;top:8%;width:62%;height:86%;background:radial-gradient(closest-side,var(--page-glow,rgba(0,177,237,.28)),transparent 70%);pointer-events:none;}
/* El bloque de contenido mide 956px centrado (1296 menos 170 de cada lado), y
   con ese ancho el h1 de 52px cae en tres líneas como en el diseño. */
.pxsite .hero--card-grid{position:relative;display:grid;grid-template-columns:548px 363px;gap:48px;align-items:center;justify-content:center;max-width:956px;}
.pxsite .hero--card-text{display:grid;gap:24px;justify-items:start;}
.pxsite .hero--card-text h1{margin:0;font-size:clamp(34px,3.9vw,52px);line-height:1.19;font-weight:500;letter-spacing:-1.04px;color:#fff;}
.pxsite .hero--card-text p{margin:0;font-size:clamp(18px,2.1vw,30px);line-height:1.27;color:#fff;}
.pxsite .hero--card-stats{display:grid;gap:24px;}
.pxsite .hero--card-statgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;}
/* La card NO tiene borde: es un wrapper de 1px con un degradado de fondo y el
   interior sólido encima, así que la "línea" es el degradado asomando. Medido en
   la publicada (px-shHeroMetrics__metric):
     wrapper: padding:1px · radius:16px · linear-gradient(268.24deg,
              rgba(255,255,255,.6) -39.21%, rgba(28,17,131,.6) 87.23%)
     interior: #131328 · padding:20px 25px · gap:0 · radius:16px
   Antes era un solo elemento con border:1px solid #fff y un relleno translúcido
   (146deg blanco 10%→5%): la línea salía blanca y plana en vez de degradada, y el
   fondo translúcido dejaba ver el hero en vez del azul sólido del diseño.
   El gap va en 0, no en 2px: las tres líneas se apoyan en su line-height.
   (Sin backticks en los comentarios: este archivo es UN template literal y un
   backtick lo parte — ya pasó tres veces, ver product-page-css.test.ts.) */
.pxsite .hstat{padding:1px;border-radius:16px;background-image:linear-gradient(268.24deg,rgba(255,255,255,.6) -39.21%,rgba(28,17,131,.6) 87.23%);}
.pxsite .hstat-inner{display:flex;flex-direction:column;gap:0;justify-content:center;height:100%;min-height:112px;padding:20px 25px;border-radius:16px;background:#131328;}
.pxsite .hstat-v{display:inline-flex;align-items:center;gap:8px;font-size:30px;line-height:36px;font-weight:700;color:#fff;}
.pxsite .hstat-l{font-size:14px;line-height:20px;color:rgba(255,255,255,.6);}
.pxsite .hstat-f{font-size:14px;line-height:20px;font-weight:500;color:var(--page-acc,#00B1ED);}
/* La card ancha ocupa las dos columnas y centra, igual que en la publicada, donde
   la última métrica es grid-column:1/-1 con text-align:center (medido). Y parte
   el valor en tres tamaños: USD a 20, 150 a 30 y /mes a 20. */
.pxsite .hstat--wide .hstat-inner{align-items:center;text-align:center;}
.pxsite .hstat--wide .hstat-v em{font-style:normal;font-size:20px;font-weight:400;}

/* El menú va DENTRO del marco del hero: el header es sticky y ocupa lugar en el
   flujo, así que se lo sube dentro de la tarjeta y se le devuelve el espacio
   como padding-top del frame. */
.pxsite .hero--card .hdr,.pxsite--dark .hero--card .hdr{background:transparent;}

/* ── 2. El contexto del mercado ────────────────────────────────────────────
   Mockup a la izquierda y 4 cards a la derecha; en mobile el mockup va arriba
   y las cards se apilan debajo (así está en el frame mobile 2014:6795). */
/* Valores del módulo publicado (px-shContextDelMercado), verificados con estilos
   computados sobre www.pxsol.com/es/producto/hotel-ads:
     sección  SIN FONDO. Sus tres --gradient-color vienen VACÍOS, así que el
              linear-gradient() del módulo es inválido y el navegador lo descarta:
              backgroundColor computa rgba(0,0,0,0). radius 20, padding 48px 0,
              margin-bottom 120. La nativa le había puesto un degradado celeste
              (180deg #EAF3FD -> #F5FAFF) que NO existe en el diseño.
     grilla   dos col-lg-6 IGUALES de 660px (imagen izquierda, cards derecha) con
              el gutter de 24px de Bootstrap, y margin-top 48 (el mt-5 del row).
              La nativa las tenía desiguales (.85fr / 1.15fr) y con gap 48.
     imagen   se renderiza a 636x686 (el archivo es 857x924, el mismo que ya
              estaba en el repo con otro nombre). La nativa la limitaba a 430.
     cards    gap 24 (no 20); #fff, radius 30 (no 20), padding 24px 48px (no
              24/28) y sombra propia -2px -2px 12px rgba(1,14,61,.1) en vez de la
              genérica del repo.
   Ver spec/FIDELIDAD-hotel-ads.md. */
.pxsite .mkt{border-radius:20px;padding:48px 0;margin-bottom:120px;}
.pxsite .mkt .wrap{text-align:center;}
/* El subtítulo va en DOS líneas: en la publicada hay un <br> explícito entre las
   dos frases. El H2 es compartido, así que el salto se resuelve scopeado acá. */
.pxsite .mkt .h2 .acc{display:block;}
.pxsite .mkt .h2{font-size:46px;line-height:52px;font-weight:600;margin-bottom:28px;}
.pxsite .mkt .chip{min-height:44px;padding:0 16px;margin-bottom:28px;font-size:16px;line-height:18px;}
.pxsite .mkt .lead{font-size:24px;line-height:34px;font-weight:500;}
.pxsite .mkt-grid{margin-top:48px;display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center;text-align:left;}
.pxsite .mkt-shot{width:100%;height:auto;max-width:636px;justify-self:center;}
.pxsite .mkt-cards{display:grid;gap:24px;}
.pxsite .mkt-card{background:#fff;border-radius:30px;padding:24px 48px;box-shadow:-2px -2px 12px 0 rgba(1,14,61,.1);}
.pxsite .mkt-card h3{margin:0 0 16px;font-size:24px;line-height:34px;font-weight:500;color:var(--title);}
.pxsite .mkt-card h3 strong{font-weight:700;}
.pxsite .mkt-card p{margin:0;font-size:16px;line-height:24px;color:var(--body);}

/* ── 3. Los pilares del servicio ───────────────────────────────────────────
   Valores del módulo publicado (px-shPillarsOfService), verificados con estilos
   computados sobre www.pxsol.com/es/producto/hotel-ads:
     sección  negro PURO #000 + la imagen vector.png (auto 100%, a la izquierda),
              radius 20, padding 100px 0 56px, margin-bottom 120
     grilla   tres columnas de 416px, gap 24, margin-top 80, centrada
     card     linear-gradient(74.79deg, from 11.38%, to 119.35%), border 1px
              rgba(255,255,255,.2), radius 20, padding 48,
              box-shadow -2px -2px 12px rgba(1,14,61,.1)
     tag      24/32 w700 sobre rgba(0,177,237,.1), min-height 44, padding 0 20, mb 48
     título   46/62 w600; su acento va con el degradado 90deg #F7738B -> #6CA9FF
   Lo que había antes y NO era del diseño: #000017 con un radial-gradient en lugar
   del arte, radius 26, el degradado del título en VIOLETA (#C9B6E4 -> #9C7FD0), el
   tag a 15px, las cards con padding 28/26 y un degradado de 160deg inventado.
   Las paradas del degradado son por card: las de los costados translúcidas (dejan
   ver el arte del fondo) y la del medio opaca. Ver spec/FIDELIDAD-hotel-ads.md. */
.pxsite .pil{padding:0;}
.pxsite .pil-panel{max-width:var(--wrap);background-color:#000;background-image:var(--pil-bg,none);background-repeat:no-repeat;background-size:auto 100%;background-position:0 0;border-radius:20px;padding:100px 0 56px;margin-bottom:120px;color:#fff;position:relative;overflow:hidden;}
.pxsite .pil-h2{position:relative;margin:20px 0 0;font-size:46px;line-height:62px;font-weight:600;color:#fff;}
.pxsite .pil-grad{background:linear-gradient(90deg,#F7738B 0%,#6CA9FF 100%);-webkit-background-clip:text;background-clip:text;color:transparent;}
.pxsite .pil-lead{position:relative;margin:24px 0 0;font-size:16px;line-height:24px;color:#fff;}
.pxsite .pil-cards{position:relative;margin-top:80px;display:grid;grid-template-columns:repeat(auto-fit,minmax(356px,1fr));gap:24px;justify-content:center;}
.pxsite .pil-card{border:1px solid rgba(255,255,255,.2);border-radius:20px;padding:48px;box-shadow:-2px -2px 12px 0 rgba(1,14,61,.1);background-image:linear-gradient(74.79deg,var(--pil-from,rgba(28,31,55,.3)) 11.38%,var(--pil-to,rgba(32,33,54,.5)) 119.35%);}
/* El separador de 48px es el margin-bottom del TAG en la publicada, no un
   margin-top del título: se respeta de ese lado para que el orden de los
   márgenes sea el mismo si mañana el título se vuelve opcional. */
.pxsite .pil-chip{display:inline-flex;align-items:center;min-height:44px;margin-bottom:48px;padding:0 20px;border-radius:100px;background:rgba(0,177,237,.1);color:var(--page-acc,#00B1ED);font-size:24px;line-height:32px;font-weight:700;}
.pxsite .pil-card h3{margin:0 0 16px;font-size:24px;line-height:34px;font-weight:500;color:#fff;}
.pxsite .pil-card p{margin:0;font-size:16px;line-height:24px;color:#fff;}
.pxsite .pil-card ul{margin:16px 0 0;padding-left:18px;display:grid;gap:8px;}
.pxsite .pil-card li{font-size:16px;line-height:24px;color:#fff;}

/* ── 4. Por qué elegirnos: la RUEDA que gira ───────────────────────────────
   Portado del modulo ventajas-pxsol de la pagina publicada, que es la fuente:
   el Figma no puede expresar una animacion y el dump del CMS no trae ni una
   regla de animacion (su attachedStylesheets viene vacio). Se construyo primero
   como una grilla estatica y estaba mal.

   Tres animaciones encadenadas, todas del mismo periodo (--timing) y en linear
   infinite, que es lo que hace que el conjunto se lea como una sola rueda:
     · el aro de productos ROTA una vuelta      -> pxAdvSpinWheel
     · cada nodo CONTRA-rota la misma vuelta    -> pxAdvSpinProduct   (si no, los
       iconos y el texto quedarian cabeza abajo en la mitad del giro)
     · cada card se TRASLADA y vuelve           -> pxAdvTranslateProduct (para que
       la card no se salga del viewport cuando su nodo pasa por el costado)
   Los keyframes van prefijados pxAdv* para no chocar con los de otras secciones. */
/* La MECÁNICA ya estaba portada bien (timing, ángulos, contrarrotación, traslado,
   el calc(100% - 140px) del aro interior, los gradientes del ícono y de la card).
   Lo que faltaba, medido con estilos computados sobre la publicada:
     sección  background-color rgb(244,239,242) — una banda rosa muy clara que la
              separa de lo de arriba y abajo; la nativa no tenía fondo y se fundía
              con la página. padding-bottom 120 y margin-bottom 120 (50 en ≤768).
              NO lleva border-radius ni padding arriba.
     rueda    el --bg-image del módulo (ads-img3.png) centrado y al 90%. Faltaba.
     aros     3px dashed BLANCO (las dos circunferencias). La nativa los tenía de
              1px y en un azulado rgba(120,140,180,.42) que no está en el diseño.
     bordes   del ícono y de la card: 1px solid BLANCO, mismo origen (el
              --border-color de la sección), no el azulado.
     títulos  46/52 w600 y la bajada 18/24 w500. */
.pxsite .adv{overflow:hidden;background-color:#F4EFF2;padding-bottom:120px;margin-bottom:120px;}
.pxsite .adv .wrap{text-align:center;}
.pxsite .adv .h2{font-size:46px;line-height:52px;font-weight:600;margin-bottom:24px;}
.pxsite .adv .lead{font-size:18px;line-height:24px;font-weight:500;}
.pxsite .adv-wheel{
  --timing:35s;--size:min(80vw,650px);--separation:40deg;
  --adv-line:#fff;
  position:relative;width:var(--size);aspect-ratio:1;height:auto;border-radius:50%;
  margin:90px auto 0;
  background-image:var(--adv-bg,none);background-position:50%;background-repeat:no-repeat;background-size:90%;
}
.pxsite .adv-products,.pxsite .adv-wheel-circle{position:absolute;inset:0;border-radius:50%;}
/* Dos circunferencias punteadas concéntricas: la de afuera es el borde del aro y
   la de adentro se dibuja con el ::before, 140px mas chica. */
.pxsite .adv-wheel-circle{display:flex;align-items:center;justify-content:center;border:3px dashed var(--adv-line);}
.pxsite .adv-wheel-circle::before{content:"";position:absolute;width:calc(100% - 140px);height:calc(100% - 140px);border-radius:50%;border:3px dashed var(--adv-line);}
.pxsite .adv-wheel-title{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-width:233px;margin:0;font-size:46px;line-height:48px;font-weight:600;text-align:center;color:var(--title);}
.pxsite .adv-wheel-title img{display:block;margin:0 auto 7px;width:33px;height:auto;}
.pxsite .adv-products{z-index:10;animation:pxAdvSpinWheel var(--timing) linear infinite;}
.pxsite .adv-product{
  --radius:calc(var(--size)/2);--icon-size:60px;--card-size:410px;
  position:absolute;left:50%;top:50%;width:var(--icon-size);height:var(--icon-size);border-radius:50%;
  transform:translate(-50%,-50%) rotate(var(--angle)) translateY(calc(var(--radius)*-1));
  animation:pxAdvSpinProduct var(--timing) linear infinite;
}
.pxsite .adv-product--1{--angle:calc(var(--separation)*-1);}
.pxsite .adv-product--2{--angle:var(--separation);}
.pxsite .adv-product--3{--angle:calc(180deg - var(--separation));}
.pxsite .adv-product--4{--angle:calc(180deg + var(--separation));}
.pxsite .adv-product--1>div{--rotate-angle:var(--separation);}
.pxsite .adv-product--2>div{--rotate-angle:calc(var(--separation)*-1);}
.pxsite .adv-product--3>div{--rotate-angle:calc(var(--separation) + 180deg);}
.pxsite .adv-product--4>div{--rotate-angle:calc(180deg - var(--separation));}
/* Este rotate NO es decorativo: CANCELA el --angle con el que se posiciona el
   nodo sobre el aro. El rotate(--angle) ubica al nodo, pero tambien le rota el
   contenido, asi que --rotate-angle lo deshace y el texto queda derecho. La
   cuenta cierra en 0 para los cuatro: -40+40, +40-40, 140+220=360, 220+140=360.
   Sacarlo dejaba las cuatro cards inclinadas justo su --angle. */
.pxsite .adv-product>div{position:relative;transform:rotate(var(--rotate-angle));}
.pxsite .adv-product-icon{
  position:relative;display:flex;align-items:center;justify-content:center;
  width:var(--icon-size);height:var(--icon-size);margin-bottom:13px;border-radius:50%;
  border:1px solid var(--adv-line);backdrop-filter:blur(4px);
  background:linear-gradient(74.79deg,rgba(255,255,255,.3) 11.38%,rgba(231,241,250,.5) 119.35%);
}
.pxsite .adv-product-icon img{max-width:27px;max-height:27px;}
.pxsite .adv-product-card{
  position:absolute;width:var(--card-size);padding:24px;border-radius:20px;text-align:center;
  border:1px solid var(--adv-line);
  background:linear-gradient(74.79deg,rgba(255,255,255,.3) 11.38%,rgba(231,241,250,.5) 119.35%);
  animation:pxAdvTranslateProduct var(--timing) linear infinite;
}
.pxsite .adv-product-card h3{margin:0 0 12px;font-size:18px;line-height:22px;font-weight:700;color:var(--title);}
.pxsite .adv-product-card p{margin:0;font-size:16px;line-height:24px;color:var(--body);}
/* Cada nodo entra a la rueda por un lado distinto, asi que su card arranca y
   termina el traslado en un punto propio. Son los valores del modulo. */
.pxsite .adv-product--1 .adv-product-card{--start-x:calc(var(--card-size)/-2 + 60px);--end-x:calc(var(--card-size)/2 - 60px);--pos-y:var(--icon-size);left:calc(var(--card-size)/-2);top:0;}
.pxsite .adv-product--2 .adv-product-card{--start-x:18px;--end-x:calc(var(--card-size)/-2 - var(--icon-size));--pos-y:calc(var(--icon-size) + 18px);bottom:0;left:calc(var(--icon-size)*-1);}
.pxsite .adv-product--3 .adv-product-card{--start-x:calc(var(--card-size) - var(--icon-size) - 35px);--end-x:18px;--pos-y:calc(var(--icon-size)/2);left:15px;top:0;}
.pxsite .adv-product--4 .adv-product-card{--start-x:calc(var(--card-size)*-1 + var(--icon-size)*2);--end-x:-30px;--pos-y:calc(var(--icon-size)/2 + 10px);right:0;top:0;}
@keyframes pxAdvSpinWheel{from{transform:rotate(0deg)}to{transform:rotate(1turn)}}
@keyframes pxAdvSpinProduct{
  from{transform:translate(-50%,-50%) rotate(var(--angle)) translateY(calc(var(--radius)*-1)) rotate(0deg)}
  to{transform:translate(-50%,-50%) rotate(var(--angle)) translateY(calc(var(--radius)*-1)) rotate(-1turn)}
}
/* La card SOLO se traslada: sin rotate. El modulo original encadena dos rotate
   (uno en el div y otro en la card) que en esta estructura terminan inclinando el
   texto; y lo que hay que replicar es lo que la publicada MUESTRA, que son cards
   DERECHAS mientras el aro gira. Se probaron las dos variantes (sumando y
   negando el angulo) y las dos dejaban el texto torcido: se compararon las
   capturas propias contra la viva. */
@keyframes pxAdvTranslateProduct{
  0%{transform:translateX(var(--start-x)) translateY(var(--pos-y))}
  50%{transform:translateX(var(--end-x)) translateY(var(--pos-y))}
  100%{transform:translateX(var(--start-x)) translateY(var(--pos-y))}
}
/* La publicada no lo trae, pero una rueda que gira 35s sin parar es exactamente
   lo que prefers-reduced-motion existe para apagar. Se detiene, no se esconde:
   el contenido sigue completo y legible. */
@media (prefers-reduced-motion:reduce){
  .pxsite .adv-products,.pxsite .adv-product,.pxsite .adv-product-card{animation:none;}
}
@media (max-width:768px){
  /* La publicada baja el margin-bottom de la sección de 120 a 50 acá. */
  .pxsite .adv{margin-bottom:50px;}
  .pxsite .adv-wheel-title{font-size:36px;line-height:35px;max-width:200px;}
}
@media (max-width:425px){
  .pxsite .adv-wheel-title{font-size:30px;line-height:30px;max-width:180px;}
  .pxsite .adv-wheel-circle::before{width:calc(100% - 100px);height:calc(100% - 100px);}
  .pxsite .adv-product{--icon-size:50px;}
  .pxsite .adv-product-icon img{max-width:22px;max-height:22px;}
}

/* ── 5. Pagás cuando ganás (modelo de negocio) ─────────────────────────────
   Panel celeste: a la izquierda título, bajada, 4 datos en grilla 2x2 y la nota
   ancha; a la derecha las 3 condiciones numeradas, con el círculo del número
   montado sobre el borde de arriba de cada card. */
.pxsite .pri{padding:0;}
.pxsite .pri-panel{max-width:var(--wrap);background:linear-gradient(140deg,#CFEAF8 0%,#DFF1FB 55%,#CDE9F7 100%);border-radius:26px;padding:72px 56px;display:grid;grid-template-columns:1fr 1.05fr;gap:56px;align-items:center;}
.pxsite .pri-lead{margin:14px 0 0;font-size:16px;line-height:1.6;color:var(--body);max-width:44ch;}
.pxsite .pri-facts{margin-top:28px;display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
.pxsite .pri-fact{background:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.8);border-radius:16px;padding:18px 22px;display:grid;gap:4px;}
.pxsite .pri-fact-l{font-size:13px;line-height:1.35;color:var(--body);}
.pxsite .pri-fact-v{font-size:22px;font-weight:700;color:var(--page-acc,#00B1ED);letter-spacing:-.01em;}
.pxsite .pri-fact-f{font-size:13px;color:var(--body);}
.pxsite .pri-note{margin:20px 0 0;background:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.8);border-radius:16px;padding:16px 22px;font-size:14px;line-height:1.5;color:var(--body);text-align:center;}
.pxsite .pri-rules{list-style:none;margin:0;padding:0;display:grid;gap:36px;}
.pxsite .pri-rules li{position:relative;background:rgba(255,255,255,.55);border:1px solid rgba(255,255,255,.85);border-radius:18px;padding:34px 30px 24px;text-align:center;font-size:14px;line-height:1.6;color:var(--body);}
.pxsite .pri-rules strong{color:var(--title);font-weight:700;}
.pxsite .pri-n{position:absolute;left:50%;top:0;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:var(--page-acc,#00B1ED);color:#fff;font-size:16px;font-weight:700;display:grid;place-items:center;}

/* ── 6. Lo que medimos ─────────────────────────────────────────────────────
   Bento oscuro: a la izquierda el encabezado y a la derecha un mosaico con tres
   cards y la foto del especialista. La card de Interacción es la violeta. */
.pxsite .mea{padding:0;}
.pxsite .mea-panel{max-width:var(--wrap);background:#000017;border-radius:26px;padding:64px 48px;color:#fff;display:grid;grid-template-columns:minmax(260px,.8fr) 1.2fr;gap:48px;align-items:start;}
.pxsite .mea-head h2{margin:20px 0 0;font-size:clamp(28px,3.2vw,44px);line-height:1.14;font-weight:600;letter-spacing:-.02em;color:#fff;}
.pxsite .mea-head p{margin:16px 0 0;font-size:15px;line-height:1.65;color:rgba(255,255,255,.72);}
.pxsite .mea-bento{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.pxsite .mea-card{border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:24px;background-image:linear-gradient(160deg,var(--tint,rgba(255,255,255,.04)) 0%,rgba(255,255,255,.02) 100%);}
.pxsite .mea-chip{display:inline-flex;align-items:center;gap:10px;padding:6px 16px 6px 6px;border-radius:100px;background:rgba(255,255,255,.08);font-size:15px;font-weight:500;color:#fff;}
.pxsite .mea-chip img{width:28px;height:28px;}
.pxsite .mea-card p{margin:18px 0 0;font-size:14px;line-height:1.6;color:rgba(255,255,255,.82);}
.pxsite .mea-card p strong{color:#fff;font-weight:600;}
.pxsite .mea-shot{grid-column:2;grid-row:1 / span 2;width:100%;height:100%;object-fit:cover;border-radius:20px;}

/* ── 7. Hoteles que ya lo están haciendo (carrusel de casos) ───────────────
   Flechas a los DOS costados y dots debajo (así está en el frame). La foto se
   monta sobre la card y las métricas van ENCIMA de la foto. */
.pxsite .cas .wrap{text-align:center;}
.pxsite .cas-stage{margin-top:44px;display:grid;grid-template-columns:auto 1fr auto auto;gap:0 24px;align-items:center;text-align:left;}
.pxsite .cas-card{grid-column:2;background:#fff;border-radius:22px;box-shadow:var(--sh-card);padding:34px 36px;}
.pxsite .cas-card h3{margin:0;font-size:18px;font-weight:400;color:var(--title);}
.pxsite .cas-card h3 strong{font-weight:700;}
.pxsite .cas-cols{margin-top:24px;display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.pxsite .cas-col{background:#E8F2FC;border-radius:16px;padding:20px 22px;}
.pxsite .cas-col-t{display:block;font-size:14px;font-weight:700;color:var(--title);}
.pxsite .cas-col ul{margin:10px 0 0;padding-left:18px;display:grid;gap:8px;}
.pxsite .cas-col li{font-size:14px;line-height:1.5;color:var(--body);}
.pxsite .cas-photo{grid-column:3;position:relative;border-radius:22px;overflow:hidden;}
.pxsite .cas-photo img{display:block;width:100%;height:100%;object-fit:cover;}
.pxsite .cas-metrics{position:absolute;right:20px;top:50%;transform:translateY(-50%);list-style:none;margin:0;padding:0;display:grid;gap:14px;}
.pxsite .cas-metrics li{display:flex;align-items:baseline;gap:10px;background:rgba(255,255,255,.16);backdrop-filter:blur(8px);border-radius:12px;padding:10px 16px;color:#fff;}
.pxsite .cas-metrics b{font-size:24px;font-weight:700;color:var(--page-acc,#00B1ED);}
.pxsite .cas-metrics span{font-size:13px;}
.pxsite .cas-arrow{width:44px;height:44px;border-radius:50%;background:#fff;border:1px solid var(--stroke);cursor:pointer;display:grid;place-items:center;color:var(--ink);}
.pxsite .cas-arrow svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
.pxsite .cas-arrow--prev{grid-column:1;}
.pxsite .cas-arrow--next{grid-column:4;}
@media (hover:hover) and (pointer:fine){.pxsite .cas-arrow:hover{border-color:var(--ink);}}
.pxsite .cas-dots{margin-top:26px;display:flex;gap:8px;justify-content:center;}
.pxsite .cas-dots .dot{width:9px;height:9px;border-radius:50%;border:0;background:var(--stroke);cursor:pointer;}
.pxsite .cas-dots .dot.on{background:var(--muted);}

/* ── 8. El proceso ─────────────────────────────────────────────────────────
   Cuatro cards en grilla 2x2, también en mobile (en el frame mobile NO se
   apilan a una columna: quedan 2x2 más chicas). */
.pxsite .pro .wrap{text-align:center;}
.pxsite .pro-cards{margin-top:44px;display:grid;grid-template-columns:repeat(2,1fr);gap:28px;text-align:left;}
.pxsite .pro-card{background:linear-gradient(160deg,#FFFFFF 0%,#F4F8FC 100%);border-radius:22px;box-shadow:var(--sh-card);padding:30px 32px;min-height:190px;}
.pxsite .pro-card h3{margin:0;font-size:20px;font-weight:700;color:var(--title);}
.pxsite .pro-card p{margin:12px 0 0;font-size:14px;line-height:1.6;color:var(--body);}

/* ── Hotel Ads: mobile ─────────────────────────────────────────────────────
   Del frame mobile 2014:6795. Lo que NO cambia: las 4 cards del proceso siguen
   en 2x2, y los tres pilares se apilan en el orden 1-2-3. */
@media (max-width:1080px){
  .pxsite .hero--card-frame{padding:120px 0 40px;}
  .pxsite .hero--card-grid{grid-template-columns:minmax(0,1fr);max-width:560px;gap:32px;}
  .pxsite .mkt-grid,.pxsite .pri-panel,.pxsite .mea-panel{grid-template-columns:minmax(0,1fr);gap:32px;}
  /* Los valores mobile del módulo publicado (≤768): el panel casi sin padding
     vertical, el título a 40/42, las cards a margin-top 38 y padding 24, y el tag
     con 30 de separación en vez de 48. */
  .pxsite .pil-panel{padding:16px 0;margin-bottom:50px;}
  .pxsite .pil-h2{font-size:40px;line-height:42px;}
  .pxsite .pil-cards{grid-template-columns:minmax(0,1fr);margin-top:38px;}
  .pxsite .pil-card{padding:24px;}
  .pxsite .pil-chip{margin-bottom:30px;}
