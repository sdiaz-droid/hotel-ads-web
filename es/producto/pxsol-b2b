.pxsite .usecase{display:grid;grid-template-columns:1fr 1fr;column-gap:24px;align-items:center;padding:0 70px;}
.pxsite .usecase--flip > div{order:2;}
.pxsite .usecase--flip > img,.pxsite .usecase--flip >picture>img{order:1;}
.pxsite .usecase__kicker{display:inline-block;padding:8px 24px;border-radius:12px;font-size:16px;line-height:24px;font-weight:400;text-align:center;margin-bottom:56px;}
/* Sin tracking: el modulo no lo declara y la regla de encabezado del repo le
   metia -0,6px. */
.pxsite .usecase h2{font-size:30px;line-height:38px;font-weight:500;letter-spacing:normal;margin:0 0 48px;}
.pxsite .usecase p{font-size:18px;line-height:140%;margin:0;}
.pxsite .usecase img{width:100%;border-radius:20px;}
@media (max-width:768px){
  .pxsite .usecase{grid-template-columns:1fr;gap:0;padding:0;}
