.pxsite .featlist__desc{font-size:16px;line-height:24px;text-align:center;margin:0 0 90px;}
/* Las dos columnas son un row de Bootstrap SIN canaleta, y cada una se mete 48px
   hacia adentro (pe-lg-5 / ps-lg-5): el hueco efectivo es 96, no 56. A 1440 eso
   es 590px por columna contra los 522 que daba la grilla del sistema. */
.pxsite .featlist__cols{display:grid;grid-template-columns:1fr 1fr;column-gap:96px;align-items:center;}
.pxsite .featlist__cols img{width:100%;height:auto;}
.pxsite .featlist__items{display:flex;flex-direction:column;gap:32px;padding:24px;border:1px solid #383f4f;border-radius:20px;}
.pxsite .featlist__item{position:relative;padding-left:36px;}
.pxsite .featlist__item:before{content:"";position:absolute;inset:0;width:24px;height:24px;background-image:var(--icon);background-position:50%;background-repeat:no-repeat;background-size:18px;}
.pxsite .featlist__item h3{font-size:18px;line-height:140%;font-weight:700;margin:0 0 12px;}
.pxsite .featlist__item p{font-size:16px;line-height:24px;margin:0;}
@media (max-width:768px){
  .pxsite .featlist{padding:54px 16px 23px;}
  .pxsite .featlist__title{font-size:40px;line-height:120%;}
  .pxsite .featlist__title,.pxsite .featlist__desc,.pxsite .featlist__kicker{margin-bottom:20px;}
  .pxsite .featlist__cols{grid-template-columns:1fr;column-gap:0;}
  /* Apiladas, el aire entre la ilustracion y la lista lo pone el margin-top de
     los items (la regla del modulo en el corte), no un gap de la grilla. */
  .pxsite .featlist__items{margin-top:30px;}
}

/* Como funciona: 4 cards blancas numeradas sobre el degradado. */
.pxsite .howsteps{background:linear-gradient(74.03deg,var(--g1) 24.52%,var(--g2) 54.83%,var(--g3) 88.41%);border-radius:20px;padding:26px 24px;}
.pxsite .howsteps__title{font-size:46px;line-height:52px;font-weight:600;letter-spacing:-.02em;text-align:center;margin:0 0 28px;}
.pxsite .howsteps__desc{font-size:24px;line-height:34px;font-weight:500;text-align:center;margin:0 0 33px;}
.pxsite .howsteps__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:36px;}
.pxsite .howsteps__step{display:flex;flex-direction:column;gap:16px;padding:48px;background:#fff;color:#000;border-radius:20px;box-shadow:0 20px 25px -5px rgba(0,0,0,.1);}
.pxsite .howsteps__top{font-size:14px;line-height:14px;font-weight:600;}
.pxsite .howsteps__n{display:inline-flex;align-items:center;justify-content:center;max-width:56px;min-height:56px;border-radius:16px;background:#4d76b1;color:#fff;font-size:24px;line-height:24px;font-weight:700;}
.pxsite .howsteps__step h3{font-size:24px;line-height:34px;font-weight:700;margin:0;}
.pxsite .howsteps__step p{font-size:16px;line-height:24px;margin:0;}
@media (max-width:1200px){ .pxsite .howsteps__grid{grid-template-columns:repeat(2,1fr);} }
@media (max-width:768px){
  .pxsite .howsteps__title{font-size:40px;line-height:42px;margin-bottom:20px;}
  .pxsite .howsteps__desc{font-size:16px;line-height:24px;margin-bottom:20px;}
}
@media (max-width:425px){
  .pxsite .howsteps__grid{grid-template-columns:1fr;gap:24px;}
  .pxsite .howsteps__step{padding:24px;}
}

/* Tres bloques blancos con icono. */
.pxsite .benblocks__title{font-size:46px;line-height:52px;font-weight:600;letter-spacing:-.02em;text-align:center;margin:0 0 90px;}
.pxsite .benblocks__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.pxsite .benblocks__block{background:#fff;border-radius:20px;box-shadow:-2px -2px 12px 0 rgba(1,14,61,.1);padding:48px;}
.pxsite .benblocks__icon{display:flex;align-items:center;justify-content:center;width:48px;height:48px;margin-bottom:16px;}
.pxsite .benblocks__icon img{max-width:42px;max-height:42px;}
.pxsite .benblocks__block h3{font-size:18px;line-height:140%;font-weight:700;margin:0 0 16px;}
.pxsite .benblocks__block p{font-size:16px;line-height:24px;margin:0;}
@media (max-width:1024px){
  .pxsite .benblocks__grid{grid-template-columns:repeat(2,1fr);}
  .pxsite .benblocks__block{padding:24px;}
}
@media (max-width:768px){
  .pxsite .benblocks__title{font-size:40px;line-height:42px;margin-bottom:40px;}
  .pxsite .benblocks__grid{grid-template-columns:1fr;}
}

/* Banda de CTA intermedia: logo, titulo 52/62, bajada, dos botones y el pie.
   Es el UNICO modulo de la pagina que se sale de la caja: le pone -9px de margen
   a cada lado, asi que queda a 3px del borde de la ventana (12 - 9) y mide 18px
   mas que los demas. Y su contenido va en un container de Bootstrap (el
   pdp-cont), no a lo ancho: el titulo mide 1296 y no los 1434 de la banda. */
.pxsite .ctaband{background:linear-gradient(187.07deg,var(--g1) 11.65%,var(--g2) 55.88%,var(--g3) 88.39%);border-radius:20px;box-shadow:-2px -2px 12px 0 rgba(1,14,61,.1);padding:90px 0;text-align:center;}
/* La doble clase es necesaria: .pdp-box se declara mas abajo con un margin
   shorthand, y con la misma especificidad le gana por orden de fuente. */
.pxsite .pdp-box.ctaband{margin-left:3px;margin-right:3px;}
.pxsite .ctaband__logo{display:block;margin:0 auto 24px;max-width:74px;height:auto;}
/* Peso 500 (el del h2 del tema), no 600: el modulo no declara font-weight. */
.pxsite .ctaband h2{font-size:52px;line-height:62px;font-weight:500;letter-spacing:-.02em;margin:0 0 24px;}
.pxsite .ctaband__desc{font-size:16px;line-height:24px;margin:0;}
.pxsite .ctaband__ctas{display:flex;gap:24px;justify-content:center;margin-top:34px;}
.pxsite .ctaband__bottom{font-size:16px;line-height:24px;padding:34px 0 0;margin:0;}
@media (max-width:767px){
  /* El iso blanco pegado arriba a la derecha: solo en este corte, y a 285px de
     ancho. Va en un :before para no tapar el degradado. */
  .pxsite .ctaband{position:relative;}
  .pxsite .ctaband:before{content:"";position:absolute;inset:0;width:100%;height:100%;background-image:var(--ctaband-bg);background-position:100% 0;background-repeat:no-repeat;background-size:285px auto;z-index:1;}
  .pxsite .ctaband > *{position:relative;z-index:2;}
  .pxsite .ctaband h2{font-size:28px;line-height:30px;}
  .pxsite .ctaband__ctas{flex-direction:column;gap:16px;}
}
@media (max-width:425px){ .pxsite .ctaband{padding:16px 0;} }

/* ── B2B: lo que faltaba de fidelidad (06/08/2026) ──────────────────────────
   Medido contra https://www.pxsol.com/es/producto/pxsol-b2b a 1440, 768 y 390,
   caja y valor computado selector por selector. La pagina estaba migrada desde
   julio con los valores correctos DENTRO de cada modulo, pero servida con la
   anatomia del sistema: la caja daba 1240 contra los 1416 del origen y el ritmo
   entre modulos no era el px-module-mb. Detalle en spec/producto-b2b.md §8.

   Lo de arriba (los seis kinds) ya quedo corregido en sus propias reglas. Lo de
   aca abajo son los bloques COMPARTIDOS, que van scopeados para no mover a las
   otras once paginas. */

/* El cuerpo de Bootstrap va a 1.5, y el del shell a 1.6: 1,6px de mas por linea
   en TODOS los parrafos de la pagina. Es global (moverlo mueve las doce), asi que
   va scopeado a la pagina que se midio. */
.pxsite[data-page="pxsol-b2b"]{line-height:1.5;}

/* COLOR. El cuerpo de la publicada es el #212529 de Bootstrap; el del sitio es
   #4a4f57. Y de ahi cada modulo declara el suyo: el hero #001701, la definicion
   y los pasos #000, las funcionalidades blanco sobre negro.

   Los ENCABEZADOS van explicitos porque en tema claro traen su propio color de
   titulo (#212529) y heredar no alcanza: la regla del encabezado gana. Es la
   misma trampa que ERP §8.3 y Pagina web, y no la canta ninguna medida de alto
   (pero en featlist eran titulares #212529 sobre #020618, contraste 1,3:1,
   practicamente invisibles, y asi estaba en produccion desde julio. */
.pxsite[data-page="pxsol-b2b"]{color:#212529;}
.pxsite[data-page="pxsol-b2b"] .usecase h2,.pxsite[data-page="pxsol-b2b"] .benblocks__title,
.pxsite[data-page="pxsol-b2b"] .benblocks__block h3,.pxsite[data-page="pxsol-b2b"] .ctaband h2{color:inherit;}
.pxsite .featlist,.pxsite .featlist__title,.pxsite .featlist__item h3{color:#fff;}
.pxsite .howsteps,.pxsite .howsteps__title,.pxsite .howsteps__step h3{color:#000;}
.pxsite[data-page="pxsol-b2b"] .whatis .h2{color:inherit;}

/* TRACKING. Los cuatro titulos de SECCION llevan letter-spacing:-2% en el modulo
   (que Chrome resuelve igual que el -.02em que ya tenian): medido con un Range
   sobre el nodo de texto, el titular de los pasos da 341,19px de ancho de los dos
   lados, asi que ahi no hay desvio (el "-2%" que reporta getComputedStyle es
   ruido, no una diferencia).
   Lo que NO lleva tracking en el origen es todo lo demas: los titulos de CARD, la
   bajada de los pasos y el pie de la banda. Y no es solo tipografia: el cuarto
   titulo de la lista de funcionalidades entraba en UNA linea donde la publicada
   usa DOS, porque los 0,36px que come el tracking por caracter alcanzaban para
   que quepa. Son 25px de alto de la seccion. */
.pxsite[data-page="pxsol-b2b"] .featlist__item h3,.pxsite[data-page="pxsol-b2b"] .howsteps__step h3,
.pxsite[data-page="pxsol-b2b"] .howsteps__desc,.pxsite[data-page="pxsol-b2b"] .benblocks__block h3,
.pxsite[data-page="pxsol-b2b"] .featlist__kicker,.pxsite[data-page="pxsol-b2b"] .usecase__kicker{letter-spacing:normal;}

/* seccion-definicion. Tres cosas que el porte no tenia:
   · La columna de texto es una CARD BLANCA (radio 20, padding 33/48). Sin ella
     el bloque medía 417px de alto contra los 630 del origen.
   · Las dos columnas son un row de Bootstrap de 650px, no la grilla 1fr/420 del
     sistema: la imagen quedaba en 420 contra 634.
   · El titular es 46/62 con 48px abajo, sin el tracking negativo del repo.
   El padding es 58 y no los 70 del modulo porque los 12 que faltan los pone la
   canaleta del row, que aca son los paddings de las dos columnas. */
.pxsite[data-page="pxsol-b2b"] .wrap.whatis{max-width:none;margin:0 12px;padding:0 58px;grid-template-columns:1fr 1fr;gap:0;color:#000;border-radius:20px;}
/* La canaleta va como MARGEN y no como padding: con padding, el rect de la
   imagen sigue midiendo los 650 de la columna (box-sizing:border-box) y la foto
   arranca 12px antes que en el origen. */
.pxsite[data-page="pxsol-b2b"] .whatis > img,.whatis >picture>img{margin:0 4px 0 12px;width:calc(100% - 16px);border-radius:0;}
.pxsite[data-page="pxsol-b2b"] .whatis > div{background:#fff;border-radius:20px;padding:33px 48px;margin-right:12px;}
/* La volanta va en el negro del bloque, sin el velo del .75: el modulo no lo
   tiene y el texto quedaba dos tonos mas claro que el origen. */
.pxsite[data-page="pxsol-b2b"] .whatis .h2{font-size:46px;line-height:62px;font-weight:600;letter-spacing:normal;margin:0 0 48px;}
.pxsite[data-page="pxsol-b2b"] .whatis p{font-size:16px;line-height:24px;max-width:none;margin:0 0 24px;color:inherit;}
/* Va DESPUES de la regla de p: empata en especificidad y gana por orden. */
.pxsite[data-page="pxsol-b2b"] p.whatis-eyebrow{opacity:1;margin-bottom:10px;}
/* El titular NO lleva resalte: el "__headline" del modulo es un texto plano y el
   renderer le pintaba "canales corporativos." en el menta del tema. Se ve
   mirando; ninguna medida cambia de valor por un color. */
.pxsite[data-page="pxsol-b2b"] .whatis .acc{color:inherit;}
/* Y el CTA de la card va en el "px-btn" pelado del tema (pastilla blanca con
   borde y texto negro), no en el btn--light, que es el boton claro pensado para
   ir SOBRE FONDO OSCURO: dentro de la card blanca quedaba texto blanco sobre
   blanco, ilegible. Estaba asi en produccion desde julio. */
.pxsite[data-page="pxsol-b2b"] .whatis .btn--light{background-image:none;background:#fff;color:var(--ink);border-color:var(--stroke);box-shadow:none;}
@media (hover:hover) and (pointer:fine){
  .pxsite[data-page="pxsol-b2b"] .whatis .btn--light:hover{border-color:var(--ink);box-shadow:none;}
}
@media (max-width:991px){
  /* El corte del modulo es 991 (col-lg), no 768: arriba de ahi ya esta apilado y
     la card se despega 48px de la imagen. */
  .pxsite[data-page="pxsol-b2b"] .wrap.whatis{grid-template-columns:1fr;}
  .pxsite[data-page="pxsol-b2b"] .whatis > img,.whatis >picture>img{margin:0;width:100%;}
  .pxsite[data-page="pxsol-b2b"] .whatis > div{margin-right:0;margin-bottom:48px;}
}
@media (max-width:768px){
  .pxsite[data-page="pxsol-b2b"] .wrap.whatis{padding:20px;}
  .pxsite[data-page="pxsol-b2b"] .whatis .h2{font-size:28px;line-height:30px;margin-bottom:24px;}
}

/* ── ERP ────────────────────────────────────────────────────────────────────
   Pagina clara con DOS bloques negros (featgrid y reasons). Su tinte no es un
   color de marca: es un gris calido rgba(129,97,97,...). Valores del .css de
   cada modulo (pdp/feature-highlights, pdp/beneficios, pdp/erp-features,
   pdp/beneficios-destacados, pdp/reasons-grid) MAS los "default" de cada
   fields.json —- media paleta no esta en los params del editable, y ademas hay
   campos que vienen VACIOS y por eso el degradado del hero y el del panel de
   beneficios quedan invalidos (o sea: no hay degradado, hay imagen o nada).

   Medido contra https://7398646.hs-sites.com/erp, que desde el 04/08/2026 esta
   publicada: ya no hace falta el preview.

   ── ANATOMIA (lo que el porte de julio no tenia) ──
   Los modulos del CMS NO usan el ".sec > .wrap" del sistema. Son tres cajas:

     pdp-sec  → sin padding. El ritmo vertical lo pone el margen del modulo
                (px-module-mb: 120px, 50 en mobile), no el .sec. Con el padding
                del .sec sumado a los 120 los saltos daban 147..268px.
     pdp-box  → la CAJA de color, a 12px de cada borde de la ventana: es el
                container-fluid del layout de HubSpot, y es lo que hace ver el
                radio (regla de Sofi del 02/08/2026 — el hero nunca a sangre).
     pdp-cont → el CONTENIDO, en un container-lg de Bootstrap: 1296px utiles a
                partir de 1400 de viewport. El .wrap del repo da 1160, y con
                136px menos cambian los cortes de linea de TODA la pagina (es la
                misma causa raiz que Sofi reporto en Pagina web el 04/08).

   Los cinco kinds son exclusivos de ERP (verificado con grep en content/*.ts),
   asi que las reglas van sin variante.

   La anatomia y lo que sigue NO son de ERP: son de cualquier pagina que ya paso
   el pase de fidelidad, y por eso el scope es la clase ".pxsite--hs" y no el
   data-page. Hoy la llevan ERP y B2B (ver PAGINAS_HS_FIEL en ProductPage.tsx).
   Es opt-in a proposito: prenderla en una pagina sin medir le cambia el
   contenedor de 1160 a 1296 y le mueve los cortes de linea de toda la pagina. */
/* text-wrap:wrap en TODOS los titulares de la pagina. El reset del shell le pone
   "balance" a h1..h4 (site-shell-css.ts) y el origen usa el "wrap" de Bootstrap.
   Balance NO cambia la cantidad de lineas, solo las iguala en largo: por eso las
   162 medidas de alto daban iguales y aun asi el titulo del hero y la bajada
   cortaban en otras palabras que la publicada. Se ve MIRANDO, no midiendo. */
.pxsite.pxsite--hs h1,.pxsite.pxsite--hs h2,
.pxsite.pxsite--hs h3,.pxsite.pxsite--hs h4{text-wrap:wrap;}

.pxsite .pdp-sec{padding:0;}
.pxsite .pdp-box{margin:0 12px 120px;}
.pxsite .pdp-cont{width:100%;margin-left:auto;margin-right:auto;padding:0 12px;}
/* Los cinco cortes del container de Bootstrap, no tres: sin los de 576 y 768 el
   contenido se iba a lo ancho de la caja en tablet (a 768 la banda de CTA medía
   738 contra los 696 del origen) y el bloque quedaba 21px corrido a la izquierda. */
@media (min-width:576px){ .pxsite .pdp-cont{max-width:540px;} }
@media (min-width:768px){ .pxsite .pdp-cont{max-width:720px;} }
@media (min-width:992px){ .pxsite .pdp-cont{max-width:960px;} }
@media (min-width:1200px){ .pxsite .pdp-cont{max-width:1140px;} }
@media (min-width:1400px){ .pxsite .pdp-cont{max-width:1320px;} }
@media (max-width:768px){ .pxsite .pdp-box{margin-bottom:50px;} }

/* Los TITULOS de los dos bloques negros y de los que declaran color van
   explicitos. La pagina es de tema claro y ahi los h2/h3/h4 traen su propio
   color de titulo (#212529): heredar del contenedor NO alcanza, la regla del
   encabezado gana. Sin esto los titulares de featgrid y reasons quedaban
   #212529 sobre #000 —- contraste 1,2:1, practicamente invisibles— y ninguna
   medida de layout lo canta, porque un color no cambia una altura.
   Es la misma trampa que ya habia aparecido en Pagina web. */
.pxsite .featgrid,.pxsite .featgrid h2,.pxsite .featgrid h3,
.pxsite .reasons,.pxsite .reasons h2,.pxsite .reasons h3{color:#fff;}
/* highlights y modben declaran #000 en el editable; benpanel no declara nada y
   se queda con el #212529 del body de Bootstrap, no con el gris del sitio. */
.pxsite .highlights,.pxsite .highlights h2{color:#000;}
.pxsite .modben,.pxsite .modben h2,.pxsite .modben h3,.pxsite .modben h4{color:#000;}
.pxsite .benpanel,.pxsite .benpanel h2{color:#212529;}
/* Las cards del panel traen su propio color (#000 por default del campo) y el h3
   lo tiene que heredar, por lo mismo de arriba. */
.pxsite .benpanel__card h3{color:inherit;}

/* TRACKING. Los cinco titulos de seccion llevan letter-spacing:-2% en el modulo,
   que Chrome resuelve al mismo -0,02em que ya tenian. Lo que NO lleva tracking en
   el origen es todo lo demas —- los titulos de card, los intros, la bajada del
   hero—- y ahi las reglas globales de encabezado del repo metian de -0,32 a
   -0,6px. No mueve alturas, pero es tipografia distinta. */
.pxsite .benpanel__card h3,.pxsite .featgrid__card h3,
.pxsite .modben__intro,.pxsite .modben__feature h4,
.pxsite .reasons__card h3{letter-spacing:normal;}

/* El problema antes de la solucion. Dos columnas de Bootstrap (col-lg-6 = 636px
   utiles con la canaleta de 24), no una grilla de 456 + resto. */
.pxsite .highlights{background:linear-gradient(251.37deg,var(--g1) 14.84%,var(--g2) 41.91%,var(--g3) 86.04%);border-radius:5px;padding:110px 0;position:relative;overflow:hidden;}
.pxsite .highlights:before{content:"";position:absolute;inset:0;width:100%;height:100%;background-image:var(--hl-bg);background-position:0 100%;background-repeat:no-repeat;z-index:1;}
.pxsite .highlights > *{position:relative;z-index:2;}
/* Dos columnas con la canaleta de 24 de Bootstrap. Este div ES el pdp-cont (el
   modulo no tiene un row aparte del container), asi que la canaleta va como gap y
   NO como el par margen negativo / padding: un margin-left aca le pisa el
   margin:auto del container y descentra la seccion entera. El resultado es el
   mismo —636px utiles por columna a 1440, 720 a 768—. */
.pxsite .highlights__row{display:grid;grid-template-columns:1fr 1fr;column-gap:24px;align-items:center;}
.pxsite .highlights__content{max-width:456px;}
.pxsite .highlights__title{font-size:46px;line-height:62px;font-weight:600;letter-spacing:-.02em;margin:0 0 24px;}
.pxsite .highlights__desc{font-size:18px;line-height:140%;margin:0 0 24px;}
.pxsite .highlights__bottom{font-size:30px;line-height:38px;font-weight:500;margin:0;}
.pxsite .highlights__cards{display:flex;flex-direction:column;gap:60px;}
.pxsite .highlights__card{display:flex;align-items:center;gap:12px;max-width:586px;padding:40px 36px;background:linear-gradient(74.79deg,var(--hl-card-from) 11.38%,var(--hl-card-to) 119.35%);border:1px solid #fff;border-radius:20px;box-shadow:-2px -2px 12px 0 rgba(1,14,61,.1);font-size:24px;line-height:34px;}
.pxsite .highlights__card img{width:53px;height:53px;flex:none;}
/* El corte del modulo es 992, y ahi baja a 90px de padding y se recorta el
   margen a 50 (su regla gana al px-module-mb global por orden de fuente). */
@media (max-width:992px){
  .pxsite .highlights{padding:90px 0;margin-bottom:50px;}
  .pxsite .highlights__row{grid-template-columns:1fr;}
  /* El tope de 456px del bloque de texto NO se suelta en el corte: el modulo no
     lo toca, y sin el tope el titulo, la bajada y el pie ocupaban los 720px
     enteros (78px menos de alto en el bloque). */
  .pxsite .highlights__title{font-size:28px;line-height:30px;}
  .pxsite .highlights__desc{font-size:16px;line-height:24px;}
  .pxsite .highlights__bottom{font-size:24px;line-height:30px;}
  .pxsite .highlights__cards{gap:16px;margin-top:44px;}
  .pxsite .highlights__card{max-width:unset;}
}
@media (max-width:425px){
  .pxsite .highlights{padding:15px 0;}
  .pxsite .highlights__card{font-size:18px;line-height:26px;padding:16px;}
}

/* Beneficios de ERP: NO es el icon-features de POS/GDS (imagen central + icono
   en pastilla). Sus cuatro paradas de degradado vienen VACIAS en el editable, asi
   que el bloque no tiene fondo ni radio: son 48px de aire arriba y abajo sobre el
   fondo del sitio ("with_padding_top_bottom" es true por default). El radio de 20
   lo declara igual, aunque sin fondo no se vea. */
.pxsite .benpanel{border-radius:20px;padding:48px 0;}
.pxsite .benpanel__kickerRow{text-align:center;margin:0 0 28px;}
.pxsite .benpanel__kicker{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 16px;border-radius:100px;font-size:16px;line-height:24px;font-weight:400;text-align:center;}
.pxsite .benpanel__title{font-size:46px;line-height:52px;font-weight:600;letter-spacing:-.02em;text-align:center;margin:0 0 48px;}
.pxsite .benpanel__desc{font-size:18px;line-height:140%;text-align:center;max-width:776px;margin:0 auto 48px;}
/* Sin radio: la sirve con img-fluid a tamano natural (1024x524). */
.pxsite .benpanel__img{display:block;margin:0 auto 48px;max-width:100%;height:auto;}
/* Flex con tope por card, no grilla de tres iguales: el modulo pone
   "max-width: calc(100%/3 - 24px)", asi que la fila queda 24px corta y cada card
   mide 8px menos que un tercio limpio. */
.pxsite .benpanel__cards{display:flex;flex-wrap:wrap;gap:24px;}
.pxsite .benpanel__card{background:#fff;color:#000;border-radius:20px;box-shadow:-2px -2px 12px 0 rgba(1,14,61,.1);padding:48px;max-width:calc(100% / 3 - 24px);}
/* La pastilla del icono NO es un cuadrado de 82: es inline-flex con 20px de
   padding y TOPE de 82, asi que se ajusta a cada icono (75x77 / 76x75 / 70x70). */
.pxsite .benpanel__icon{display:inline-flex;align-items:center;justify-content:center;max-width:82px;max-height:82px;padding:20px;border-radius:10px;box-shadow:-2px -2px 12px 0 rgba(1,14,61,.1);margin-bottom:24px;}
.pxsite .benpanel__icon img{max-width:38px;height:auto;}
.pxsite .benpanel__card h3{font-size:24px;line-height:34px;font-weight:500;margin:0 0 24px;}
.pxsite .benpanel__card p{font-size:16px;line-height:140%;margin:0;}
@media (max-width:991px){ .pxsite .benpanel__card{max-width:calc(100% / 2 - 24px);} }
@media (max-width:768px){ .pxsite .benpanel__card{max-width:none;} }
@media (max-width:425px){
  .pxsite .benpanel{padding:24px 0;}
  .pxsite .benpanel__title{font-size:28px;line-height:30px;margin-bottom:28px;}
  .pxsite .benpanel__card{padding:24px;}
  .pxsite .benpanel__card h3{margin-bottom:16px;}
  .pxsite .benpanel__icon{max-width:58px;max-height:58px;margin-bottom:18px;}
  .pxsite .benpanel__icon img{max-width:32px;max-height:32px;}
}

/* Grilla oscura: 4 columnas y las cards wide ocupan DOS. */
.pxsite .featgrid{background:var(--fg-bg);border-radius:50px;padding:50px 0;}
.pxsite .featgrid__title{font-size:46px;line-height:52px;font-weight:600;letter-spacing:-.02em;text-align:center;max-width:776px;margin:0 auto 28px;}
.pxsite .featgrid__desc{font-size:18px;line-height:140%;text-align:center;max-width:776px;margin:0 auto 48px;}
.pxsite .featgrid__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:48px;}
/* Dos filas, como la publicada: las dos cards --wide ocupan 2 columnas cada una
   (y llenan la fila 1 con 292px de alto), y las otras cuatro van de a 1 con
   468px. Sin esto salen 3 filas de 2 y la composicion es otra. */
.pxsite .featgrid__card{display:flex;flex-direction:column;justify-content:center;gap:24px;padding:48px;background-color:var(--fg-card);background-image:var(--card-bg-image);background-position:100% 0;background-repeat:no-repeat;border-radius:20px;min-height:468px;grid-column:span 1;}
.pxsite .featgrid__card--wide{grid-column:span 2;min-height:292px;}
.pxsite .featgrid__card h3{font-size:24px;line-height:34px;font-weight:700;margin:0;}
.pxsite .featgrid__card p{font-size:16px;line-height:24px;margin:0;}
/* Los cortes son los del modulo: 1200 (dos columnas), 768 (radio y padding) y
   568 (una columna). Con 1024 y 640 la grilla pasaba a 2 columnas 176px tarde. */
@media (max-width:1200px){
  .pxsite .featgrid__grid{grid-template-columns:repeat(2,1fr);gap:24px;}
  .pxsite .featgrid__card,.pxsite .featgrid__card--wide{grid-column:span 1;min-height:0;}
}
@media (max-width:768px){ .pxsite .featgrid{border-radius:20px;padding:24px 0;} }
@media (max-width:568px){
  .pxsite .featgrid__title{font-size:28px;line-height:30px;}
  .pxsite .featgrid__grid{grid-template-columns:1fr;}
}

/* Un modulo contado en detalle. Se usa 3 veces y ALTERNA el lado del texto.
   Los tres traen "with_margin_bottom: false", asi que su separacion es solo la
   del px-module-mb que ya pone .pdp-box: sin esto se sumaban 120 de mas y los
   saltos daban 267. */
.pxsite .modben{background:var(--mb-bg);border-radius:20px;padding:76px 0 24px;}
.pxsite .modben__title{font-size:46px;line-height:52px;font-weight:600;letter-spacing:-.02em;text-align:center;margin:0 0 80px;}
/* Row de Bootstrap, igual que en highlights. */
.pxsite .modben__cols{display:grid;grid-template-columns:1fr 1fr;align-items:center;margin-left:-12px;margin-right:-12px;}
.pxsite .modben__cols > *{padding-left:12px;padding-right:12px;}
.pxsite .modben__cols--flip .modben__txt{order:2;}
.pxsite .modben__cols--flip .modben__art{order:1;}
.pxsite .modben__intro{font-size:30px;line-height:38px;font-weight:500;margin:0 0 24px;}
.pxsite .modben__desc{font-size:16px;line-height:24px;margin:0 0 24px;}
.pxsite .modben__features{display:flex;flex-direction:column;gap:24px;}
.pxsite .modben__feature{background:#fff;border-radius:20px;box-shadow:-2px -2px 12px 0 rgba(1,14,61,.1);padding:24px 48px;}
.pxsite .modben__feature h4{font-size:24px;line-height:34px;font-weight:700;margin:0 0 12px;}
.pxsite .modben__feature p{font-size:16px;line-height:24px;margin:0;}
/* Sin radio: la captura va tal cual (img-fluid). */
.pxsite .modben__art img{width:100%;height:auto;border-radius:0;}
/* El CTA esta DOS veces en el markup y se muestra uno por corte: arriba de las
   cards abajo de 992 ("my-4"), y debajo de 992 para arriba ("mt-4"). */
/* Van en BLOQUE con ancho al contenido, no inline-flex: un boton inline dentro de
   un bloque arma una caja de linea y le suma el hueco del descendente (5px por
   bloque, y son tres). En el origen el <a> vive dentro de un div con my-4/mt-4. */
.pxsite .modben__cta{display:block;width:-moz-fit-content;width:fit-content;}
.pxsite .modben__cta--lg{display:none;}
.pxsite .modben__cta--sm{margin:24px 0;}
@media (min-width:992px){
  .pxsite .modben__cta--sm{display:none;}
  .pxsite .modben__cta--lg{display:block;margin-top:24px;}
}
@media (max-width:991px){ .pxsite .modben__art img{margin-top:53px;} }
@media (max-width:768px){
  .pxsite .modben{padding:24px 0;}
  .pxsite .modben__title{font-size:40px;line-height:120%;margin-bottom:20px;text-align:center;}
  .pxsite .modben__cols{grid-template-columns:1fr;}
  /* Las columnas pasan de 12 a 15px de padding en el corte (es lo unico que el
     modulo cambia ahi), y las cards de feature NO bajan a 24: siguen en 24/48 en
     todos los anchos. Con 24 planos la columna medía 720 en vez de 714 y cada
     card entraba 24px mas angosta, lo que le sumaba una linea a cada titulo. */
  .pxsite .modben__cols > *{padding-left:15px;padding-right:15px;}
  .pxsite .modben__cols--flip .modben__txt,.pxsite .modben__cols--flip .modben__art{order:unset;}
  .pxsite .modben__intro{text-align:center;margin-bottom:20px;}
  .pxsite .modben__desc{text-align:center;}
}

/* Tres razones numeradas, en cards oscuras. Flex con tope de 33,33% y flex:1,
