 $$(\"[data-pxnav-close]\").forEach(function (el) {\n    el.addEventListener(\"click\", function () { abierto = null; pintar() })\n  })\n\n  document.addEventListener(\"keydown\", function (e) {\n    if (e.key === \"Escape\" \u0026\u0026 abierto !== null) {\n      abierto = null\n      pintar()\n    }\n  })\n\n  // ── Segmento del panel de productos (Hoteles / Vacation Rentals) ───────────\n  // La esquina de unión del bloque de listas sigue a la tarjeta activa, así el\n  // panel se lee como una sola pieza con la tarjeta elegida.\n  $$(\"[data-pxnav-seg]\").forEach(function (card) {\n    card.addEventListener(\"click\", function (e) {\n      e.stopPropagation()\n      var seg = card.getAttribute(\"data-pxnav-seg\")\n      $$(\"[data-pxnav-seg]\").forEach(function (c) {\n        var on = c.getAttribute(\"data-pxnav-seg\") === seg\n        c.classList.toggle(\"--on\", on)\n        c.classList.toggle(\"--off\", !on)\n        c.setAttribute(\"aria-pressed\", on ? \"true\" : \"false\")\n      })\n      $$(\"[data-pxnav-list]\").forEach(function (l) {\n        l.hidden = l.getAttribute(\"data-pxnav-list\") !== seg\n      })\n      var caja = raiz.querySelector(\"[data-pxnav-join]\")\n      if (caja) caja.classList.toggle(\"--join-bottom\", seg === \"vr\")\n    })\n  })\n\n  // ── Estados de la barra ────────────────────────────────────────────────────\n  var claros = []\n  function releerClaros() {\n    // `[data-nav=\"light\"]` es el contrato explícito del handoff: si una página marca\n    // sus secciones, mandan ellas. Es solo un OVERRIDE — el caso normal lo resuelve\n    // la detección automática de abajo.\n    claros = [].slice.call(document.querySelectorAll('[data-nav=\"light\"]'))\n  }\n\n  /**\n   * ¿Qué tan claro es lo que se ve DETRÁS de la barra?\n   *\n   * No se puede depender de que la página marque sus secciones: ninguna lo hace, y\n   * el resultado fue un navbar blanco sobre el fondo blanco de las páginas de\n   * producto — ilegible, reportado por Sofi