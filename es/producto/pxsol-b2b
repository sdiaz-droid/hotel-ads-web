.pxsite .mega .plist{display:grid;grid-template-columns:1fr 1fr;gap:4px;}
.pxsite .mega .pitem{display:flex;align-items:center;gap:11px;padding:9px 11px;border-radius:12px;font-size:14.5px;color:var(--title);transition:background .15s var(--ease);}
