ol-global=\"header\"] .px-headerMenuMobile__cardContent{flex: 1;}\n[data-pxsol-global=\"header\"] .px-headerMenuMobile__banner{align-items: center;\n    background-position: 0;\n    background-repeat: no-repeat;\n    background-size: auto 100%;\n    border-radius: 20px;\n    display: flex;\n    gap: 10px;\n    justify-content: space-between;\n    padding: 10px;\n\tmargin: 15px 0;\n\tflex-direction: column;}\n[data-pxsol-global=\"header\"] .px-headerMenuMobile__bannerTitle{font-size: 16px;\n    font-weight: 500;\n    line-height: 18px;}\n[data-pxsol-global=\"header\"] .px-headerMenuMobile__banner .px-btn span{font-size: 14px;\n\tmin-height: 34px;\n\tline-height: 34px;}\n[data-pxsol-global=\"header\"] .px-header__btnLangs{background-color: transparent;\n\tborder: none;\n\tpadding: 0;\n\tmargin: 0;\n\tcursor: pointer;}\n[data-pxsol-global=\"header\"] .px-header.--home .px-header__btnLangs::after{border-top-color: #fff;\n\tborder-bottom-color: #fff;}\n[data-pxsol-global=\"header\"] .px-header__langsList li a{color: var(--gray-dark) !important;}\n[data-pxsol-global=\"header\"] .px-header__langsList li a:hover{background-color: var(--gray) !important;}\n@media (max-width: 1200px){\n[data-pxsol-global=\"header\"] .px-header__column-right, [data-pxsol-global=\"header\"] .px-header__menu{display: none;}\n[data-pxsol-global=\"header\"] .px-btn-menu{display: flex;}\n[data-pxsol-global=\"header\"] .px-header{padding: 0 16px;}\n}\n[data-pxsol-global=\"header\"] .pxs-integ-strip{grid-column: 1 / -1;\n\tbox-sizing: border-box;\n\tmax-width: 100%;\n\tmin-width: 0;\n\tmargin-top: 13px;\n\tbackground: linear-gradient(119.2deg, var(--gradient-start-color) 7.36%, var(--gradient-end-color) 97.75%);\n\tborder-radius: 16px;\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 14px;\n\tpadding: 11px 18px;\n\twhite-space: nowrap;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip__lead{display: flex; align-items: center; gap: 11px; flex-shrink: 0;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip__icon{width: 20px; height: 20px; color: #fff; flex-shrink: 0;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip__title{font-family: \"Work Sans\", sans-serif; font-weight: 600; font-size: 16px; color: #fff;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip__count{font-family: \"Inter\", sans-serif; font-size: 10px; font-weight: 700;\n\tletter-spacing: .06em; text-transform: uppercase; color: #CFE2FF;\n\tbackground: rgba(42,111,219,.18); border: 1px solid rgba(42,111,219,.4);\n\tpadding: 2px 8px; border-radius: 100px;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip__divider{width: 1px; height: 20px; background: rgba(255,255,255,.14); flex-shrink: 0;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip__desc{font-family: \"Inter\", sans-serif; font-size: 13px; color: #AEB2C0;\n\tflex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip__partners{display: flex; align-items: center; gap: 8px; flex: 0 1 auto; min-width: 0; overflow: hidden;\n\tfont-family: \"Work Sans\", sans-serif; font-weight: 500; font-size: 14px; color: #C2C6D2;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip__partners .dot{color: #525870;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip__partners .more{color: #6B7186;}\n[data-pxsol-global=\"header\"] .px-headerSectionGroup .pxs-integ-strip__cta, [data-pxsol-global=\"header\"] .px-headerSectionGroup .pxs-integ-strip__cta:hover, [data-pxsol-global=\"header\"] .px-headerSectionGroup .pxs-integ-strip__cta:visited{display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0;\n\tfont-family: \"Work Sans\", sans-serif; font-weight: 600; font-size: 13px;\n\tcolor: #fff !important;\n\tpadding: 7px 14px; border-radius: 100px; background: rgba(255,255,255,.08);\n\ttext-decoration: none; margin-left: auto; transition: background .15s cubic-bezier(.22,.61,.36,1);}\n[data-pxsol-global=\"header\"] .px-headerSectionGroup .pxs-integ-strip__cta:hover{background: rgba(255,255,255,.14);}\n[data-pxsol-global=\"header\"] .px-headerSectionGroup .pxs-integ-strip__cta svg{color: #fff !important;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip__cta svg{width: 14px; height: 14px;}\n@media (max-width: 1099px){\n[data-pxsol-global=\"header\"] .pxs-integ-strip__partners{display: none;}\n}\n@media (min-width: 1100px){\n[data-pxsol-global=\"header\"] .pxs-integ-strip__desc{display: none;}\n}\n[data-pxsol-global=\"header\"] .pxs-integ-strip-m{display: flex;\n\talign-items: center;\n\tgap: 14px;\n\tbackground: linear-gradient(119.2deg, rgba(48,49,68,1) 7.36%, rgba(48,50,69,.7) 97.75%);\n\tborder: 1px solid rgba(255,255,255,.12);\n\tborder-radius: 20px;\n\tpadding: 16px;\n\tmargin-bottom: 15px;\n\ttext-decoration: none;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip-m, [data-pxsol-global=\"header\"] .pxs-integ-strip-m *{color: #fff !important;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip-m__icon{width: 44px; height: 44px; flex-shrink: 0;\n\tdisplay: grid; place-items: center;\n\tbackground: rgba(255,255,255,.06);\n\tborder: 1px solid rgba(255,255,255,.1);\n\tborder-radius: 12px;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip-m__body{flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip-m__title{font-family: \"Work Sans\", sans-serif; font-weight: 700; font-size: 16px;\n\tdisplay: flex; align-items: center; gap: 8px;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip-m__desc{font-family: \"Inter\", sans-serif; font-size: 14px; line-height: 1.5;\n\tcolor: rgba(244,246,255,.72) !important;}\n[data-pxsol-global=\"header\"] .pxs-integ-strip-m__arrow{flex-shrink: 0; display: grid; place-items: center; opacity: .8;}\n[data-pxsol-global=\"header\"] .pxs-badge{display: inline-block;\n\tflex-shrink: 0;\n\tfont-family: \"Inter\", sans-serif;\n\tfont-weight: 800;\n\tfont-size: 11px;\n\tline-height: 1;\n\tletter-spacing: .08em;\n\ttext-transform: uppercase;\n\tcolor: #fff;\n\tbackground: #1F8A5B;\n\tpadding: 5px 10px;\n\tborder-radius: 100px;\n\twhite-space: nowrap;}\n[data-pxsol-global=\"header\"] .px-headerSectionGroup__item.--menu ul a.--badged{position: relative;}\n[data-pxsol-global=\"header\"] .px-headerSectionGroup__item.--menu ul a.--badged \u003e span.pxs-badge{position: absolute;\n\tright: 15px;\n\ttop: 50%;\n\ttransform: translateY(-50%);\n\tmax-width: none;\n\tpadding: 5px 10px;}\n[data-pxsol-global=\"header\"] .px-headerSectionGroup__item.--menu ul a.--badged:hover \u003e span.pxs-badge{text-decoration: none;}\n[data-pxsol-global=\"header\"] .px-headerMenuMobile__listItemLink .pxs-badge{margin-left: auto; align-self: center;}\n\n/* ══ Overrides del porte a Nexus (no vienen del tema de HubSpot) ══════════════ */\n\n/* 1. EL HEADER OCUPA SU LUGAR, no se superpone.\n *    En HubSpot `.px-header` es `position:absolute; inset:0 0 auto`: flota sobre\n *    el hero, porque las plantillas del tema le reservan el espacio arriba. Las\n *    páginas de Nexus son de contenido libre y NO reservan nada, así que un\n *    header absoluto les taparía los primeros ~90px. Decisión de Sofi (02/08/2026):\n *    que ocupe su lugar y empuje el contenido.\n *    Si alguna vez se quiere el comportamiento original en UNA página, el camino\n *    es agregarle la clase `--transparent` al \u003cheader\u003e y devolverle el absolute\n *    ahí — no cambiar este default. */\n[data-pxsol-global=\"header\"] .px-header {\n  position: relative;\n  inset: auto;\n}\n\n/* 2. La barra opaca necesita fondo propio.\n *    En el original el fondo se lo da el hero que tiene debajo (o el modificador\n *    `--home`). Al pasar a barra que ocupa lugar, sin fondo quedaría sobre el\n *    color de la página, con el logo claro invisible. */\n[data-pxsol-global=\"header\"] .px-header:not(.--transparent) {\n  background-color: var(--white, #f7f7f7);\n}\n\n/* 2b. EL MENÚ SE DESPLIEGA SOBRE LA PÁGINA, NO LA EMPUJA.\n *     Consecuencia directa del override 1, y hay que arreglarla acá.\n *\n *     El header tiene cinco hijos: la barra (`px-header__wrapperMenu`), los TRES\n *     paneles del mega-menú (`px-headerSection`) y el panel mobile\n *     (`px-headerMenuMobile`). El tema NO les pone posición: son bloques en el\n *     flujo. En HubSpot eso no molesta porque el header entero es `absolute`, así\n *     que al abrir un panel crece una caja que ya estaba fuera del flujo y la\n *     página no se mueve un píxel.\n *\n *     Con el header en `relative` (override 1), abrir un panel agrandaba el header\n *     y EMPUJABA toda la página hacia abajo — reportado por Sofi el 03/08/2026\n *     comparando contra www.pxsol.com: \"toda la página se corre para abajo y se ve\n *     muy raro\".\n *\n *     Se saca del flujo a los paneles, no al header: la barra sigue reservando su\n *     lugar (que es lo que se decidió) y los paneles cuelgan de su borde inferior\n *     flotando sobre el contenido, igual que en HubSpot. `top:100%` es el alto de\n *     la barra sin números mágicos, y el `z-index:9999` del tema en `.px-header`\n *     los deja por encima de la página. */\n[data-pxsol-global=\"header\"] .px-header \u003e .px-headerSection,\n[data-pxsol-global=\"header\"] .px-header \u003e .px-headerMenuMobile {\n  position: absolute;\n  top: 100%;\n  left: 0;\n  right: 0;\n}\n\n/* 2c. La variante TRANSPARENTE vuelve a flotar.\n *     El override 1 pasa el header a `relative` para que la barra ocupe su lugar, y\n *     eso vale para la enorme mayoría de las páginas. Pero la home del sitio tiene un\n *     hero de video a sangre completa y ahí el header va ENCIMA, transparente, como en\n *     la publicada (`px-header --transparent --home`). Para esas páginas se le pone\n *     `--transparent` al header y con esta regla recupera el comportamiento original\n *     del tema. Sin esto, agregar `--transparent` dejaba la barra en el flujo igual y\n *     el hero arrancaba 90px más abajo. */\n[data-pxsol-global=\"header\"] .px-header.--transparent {\n  position: absolute;\n  inset: 0 0 auto;\n}\n\n/* 3. Dropdowns sin Bootstrap JS.\n *    Los selectores de idioma usan `data-bs-toggle=\"dropdown\"`, que en HubSpot lo\n *    maneja Bootstrap + Popper. En Nexus no existe ninguno de los dos: el JS del\n *    módulo abre/cierra a mano con la clase `.show` (que es la misma que usa\n *    Bootstrap), y el posicionamiento lo resuelve este CSS en vez de Popper.\n *\n *    Alineado a la IZQUIERDA del toggle (`left:0`), que es donde lo pone Popper en\n *    HubSpot: su placement default es `bottom-start` y el markup NO trae\n *    `dropdown-menu-end` (la clase con la que Bootstrap lo alinearía a la derecha).\n *    La primera versión del porte lo alineaba a la derecha y el menú de idiomas\n *    aparecía 126px corrido respecto del sitio. */\n[data-pxsol-global=\"header\"] .dropdown { position: relative; }\n[data-pxsol-global=\"header\"] .dropdown-menu {\n  position: absolute;\n  top: 100%;\n  left: 0;\n  right: auto;\n  display: none;\n  z-index: 1000;\n}\n[data-pxsol-global=\"header\"] .dropdown-menu.show { display: block; }\n\n/* 4. El wrapper que emite Nexus es un div suelto: sin esto hereda el\n *    `font-family` de la app (Open Sans) en vez de la del sitio público. */\n[data-pxsol-global=\"header\"] {\n  font-family: var(--typography, \"Work Sans\", sans-serif);\n}\n[data-pxsol-global=\"header\"] *, [data-pxsol-global=\"header\"] *::before, [data-pxsol-global=\"header\"] *::after {\n  box-sizing: border-box;\n}\n\n\n/* ─────────────────────────────────────────────────────────────────────────────\n   NAVBAR GLOBAL DE PXSOL — rediseño 08/2026 (handoff \"Rediseño menú Pxsol\")\n\n   Se AGREGA al final del CSS que ya tiene el WebModule HEADER; no lo reemplaza.\n   Motivo: ese CSS trae el baseline del tema de HubSpot y los estilos de las piezas\n   que el rediseño NO toca (los paneles de Recursos y Nosotros, y todo el menú\n   mobile). Recortarlo para sacar la barra vieja era el camino corto a romper esas\n   tres cosas sin darse cuenta. Las reglas de `.px-header` quedan huérfanas —su\n   markup ya no existe— y no le pegan a nada.\n\n   Todo va scopeado bajo [data-pxsol-global=\"header\"], igual que el resto del\n   módulo: es el atributo del wrapper que emite GlobalChromeBlock y del que cuelga\n   la resolución de raíz del JS.\n   ───────────────────────────────────────────────────────────────────────────── */\n\n/* Tokens del handoff. Viven en el wrapper y no en :root para no filtrarse a la\n   página que hospeda el módulo. */\n[data-pxsol-global=\"header\"] {\n  --pxnav-ink: #000017;\n  --pxnav-card: #12121C;\n  --pxnav-card2: #1B1B26;\n  --pxnav-fg: #FAFAFA;\n  --pxnav-sub: #B9B9CB;\n  --pxnav-desc: #A6A6B4;\n  --pxnav-mut: #84849B;\n  --pxnav-link: #7FB2FF;\n  --pxnav-ease: cubic-bezier(.4, 0, .2, 1);\n  --pxnav-ease-menu: cubic-bezier(.23, 1, .32, 1);\n  /* 200ms, no 320. Con 320 la barra seguía moviéndose bastante después de que el\n     dedo paró de scrollear, y se leía como lentitud. Es el mismo valor que usa la\n     referencia que aprobó Sofi (invgate.com: `transition-[max-width] duration-200`). */\n  --pxnav-dur: .2s;\n}\n\n/* ── La barra ────────────────────────────────────────────────────────────────\n   FIXED, no sticky. El handoff la describe sticky, pero acá no sirve por dos\n   razones que solo se ven en producción: las páginas nativas envuelven todo en\n   `.pxsite`, que lleva `overflow-x` y mata cualquier sticky de adentro; y sus\n   heros ya reservan el espacio del header con padding-top, contando con que NO\n   ocupe lugar en el flujo. Con fixed el resultado visual es el mismo —la barra\n   queda arriba y la píldora aparece al scrollear— sin tocar 14 heros. */\n[data-pxsol-global=\"header\"] .pxnav-wrap {\n  position: fixed;\n  inset: 0 0 auto;\n  z-index: 9999;\n  /* 24px SIEMPRE. Antes bajaba a 12 al recogerse, y era una de las cuatro cosas\n     que se movían a la vez. En la referencia el `top` no cambia nunca. */\n  padding-top: 24px;\n}\n\n[data-pxsol-global=\"header\"] .pxnav {\n  width: 100%;\n  /* NUNCA pegada a los bordes. Ese era el \"se sale del ancho de la página\" que\n     Sofi reportó tres veces: arriba la barra era una franja a todo lo ancho con\n     las esquinas cuadradas, y al recogerse se volvía una píldora. En la\n     referencia (invgate.com) es SIEMPRE una caja flotante con márgenes —medido a\n     1512: 1312 de ancho con 100px de aire a cada lado—, y lo único que cambia es\n     cuánto mide. Los 48px de acá son ese mismo aire.\n     El `max(...)` es un PISO y no es opcional: sin él, en una pantalla de 1200 los\n     96px de margen dejan la caja en 1104 y el contenido mide 1101 — medido, se\n     desbordaba 2px, y a 1101 de viewport se desbordaba 101px. El piso es el ancho\n     de la píldora de ese mismo breakpoint, que ya está calculado para que el\n     contenido entre. */\n  max-width: min(1728px, max(1364px, calc(100% - 96px)));\n  min-height: 64px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 0 46px;\n  /* El radio tampoco cambia: la barra ya nace redondeada. Animar 0 → 999 era otra\n     de las cuatro simultáneas, y la que hacía que se leyera como que la franja\n     \"se transformaba\" en vez de encogerse. */\n  border-radius: 999px;\n  background: transparent;\n  border: 1px solid transparent;\n  position: relative;\n  z-index: 40;\n  /* ── EL CONTRATO DE LA ANIMACIÓN ──────────────────────────────────────────\n     SÓLO SE ANIMA LA CAJA. Estas seis propiedades, más el `padding-top` del\n     wrap, son las ÚNICAS transiciones del navbar al recogerse: todo lo de\n     adentro —logo, gap del nav, padding de los ítems, tamaño del chevron y del\n     globo, alto del botón— cambia de golpe y se re-maqueta dentro de la caja que\n     se mueve. Si volvés a animar algo de un hijo, rompés esto.\n\n     La versión anterior animaba 18 declaraciones repartidas en 8 elementos, todas\n     a la vez: cada pieza se deslizaba por su cuenta y con su propio recorrido, así\n     que la barra no se leía como UNA cosa que se encoge sino como un montón de\n     cosas acomodándose. Reportado por Sofi el 28/08/2026 con video, contra\n     invgate.com — que anima exactamente dos propiedades, `max-width` de la caja y\n     `top` del wrapper, ambas en 200ms. */\n  /* ── UNA SOLA PROPIEDAD ANIMADA ───────────────────────────────────────────\n     Sólo el ancho. Ni alto, ni padding, ni radio, ni fondo, ni el top del wrap:\n     todo eso es igual en los dos estados o cambia de golpe, exactamente como en\n     invgate.com, cuyo `\u003cheader\u003e` lleva literalmente `transition: all 0s` y sólo\n     su contenedor anima `max-width` en 200ms.\n\n     Se llegó acá después de tres intentos que movían de más. Medido a 1512, el\n     nuestro cambiaba CUATRO cosas al mismo tiempo —ancho 1512→1260, radio 0→999,\n     alto 64→56 y top 24→12— contra UNA de la referencia. Por eso \"no se parecía\n     en nada\", aunque el contenido ya fuera el mismo. */\n  transition: max-width var(--pxnav-dur) var(--pxnav-ease);\n}\n[data-pxsol-global=\"header\"] .pxnav-wrap.--stuck .pxnav {\n  /* ── EL ANCHO DE LA PÍLDORA NO ES DECORATIVO ──────────────────────────────\n     Tiene que caber el contenido en su caso MÁS ANCHO, que es con el logotipo\n     entero y el padding sin recoger. Medido: 1339px acá, 1235 abajo de 1728 y\n     1101 abajo de 1500 — por eso hay tres valores, uno por breakpoint, y cada\n     uno es el contenido + 24px de aire.\n\n     Que la caja nunca sea más chica que su contenido es lo que permite que el\n     contenido NO cambie entre estados, y eso es lo que hace que el \"durante\" no\n     tenga ni un frame desacomodado. **Achicar cualquiera de estos tres números\n     trae de vuelta el desborde.** */\n  max-width: 1364px;\n  background: rgba(255, 255, 255, .07);\n  border-color: rgba(255, 255, 255, .14);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n}\n\n/* ── Logo ────────────────────────────────────────────────────────────────────\n   Dos cajas que se turnan con max-width y overflow hidden, y el intercambio es\n   INSTANTÁNEO: sólo se anima la caja de afuera (`.pxnav`), nunca el contenido.\n   Animarlo era lo que dejaba los DOS logos a la vista durante la transición\n   —a mitad de camino ninguna de las dos cajas estaba en cero—, reportado por Sofi\n   el 28/08/2026. El isotipo oficial de Pxsol es la P con la X cruzada (no la X\n   sola) y comparte el sistema de coordenadas del logotipo: el salto no se ve.\n\n   ⚠️ NO se puede reemplazar esto por \"recortar el logotipo hasta el isotipo\".\n   Parece que sí —el isotipo son los mismos dos trazos que abren y cierran el\n   logotipo, con el mismo sistema de coordenadas— pero NO hay ningún corte\n   vertical que lo deje entero sin que asome la \"s\". Medido con getBBox() sobre\n   el SVG real, que es la única forma: el `M` con el que arranca un path NO es su\n   borde izquierdo, y creer que sí es exactamente la trampa.\n\n       P    357,4 → 437,2          s    554,9 → 632,1\n       ✕    416,8 → 603,2          o    636,9 → 749,9\n                                   l    763,1 → 833,8\n\n   La \"s\" arranca en 554,9: CUARENTA Y OCHO unidades antes de que termine la X.\n   Se superponen. Probado en producción el 28/08/2026 recortando en 32px —el\n   número salió de leer `M632.131` como si fuera el borde de la \"s\"— y se veía\n   \"P✕s\". Por eso el isotipo es un SVG aparte y por eso son dos cajas.\n\n   Lo que SÍ queda pendiente: durante los 320ms de la transición se ven las dos\n   marcas juntas. Se arregla superponiéndolas y cruzándolas por opacidad, pero\n   eso toca el TAMAÑO del isotipo de la píldora (la misma marca mide 32px suelta\n   y 39px dentro del logotipo), así que es una decisión de diseño, no un fix. */\n[data-pxsol-global=\"header\"] .pxnav__logo {\n  display: block;\n  overflow: hidden;\n  flex: none;\n}\n[data-pxsol-global=\"header\"] .pxnav__logo--full { max-width: 120px; }\n[data-pxsol-global=\"header\"] .pxnav__logo--iso { max-width: 0; }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--stuck .pxnav__logo--full { max-width: 0; }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--stuck .pxnav__logo--iso { max-width: 40px; }\n/* `display:block` explícito: el reset del preflight de Tailwind que emite\n   GlobalChromeBlock pasa todo img/svg del módulo a `inline`, y en línea el SVG\n   arrastra el espacio del renglón y descuadra la barra. Esta regla pesa más. */\n[data-pxsol-global=\"header\"] .pxnav__logo svg { display: block; }\n[data-pxsol-global=\"header\"] .pxnav__logo--full svg { width: 74px; height: 36px; }\n[data-pxsol-global=\"header\"] .pxnav__logo--iso svg { width: 32px; height: 32px; }\n/* La variante clara del logo se dibuja con el mismo SVG: solo cambia el color de\n   las letras (la X va siempre roja). Así no hay dos archivos que mantener. */\n[data-pxsol-global=\"header\"] .pxnav__logo .pxnav__letra { fill: #FFFFFF; transition: fill var(--pxnav-dur) var(--pxnav-ease); }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__logo .pxnav__letra { fill: #000017; }\n\n/* ── Links ───────────────────────────────────────────────────────────────────\n   16px SIEMPRE: el cuerpo no cambia en ningún estado. Lo que se acorta son los\n   textos (\"Software para Hoteles\" → \"Alojamientos\"), que es lo que hace que las\n   cinco entradas entren en una píldora de 1040. */\n[data-pxsol-global=\"header\"] .pxnav__nav {\n  display: flex;\n  align-items: center;\n  gap: 40px;\n  margin-left: 36px;\n  margin-right: auto;\n}\n\n[data-pxsol-global=\"header\"] .pxnav__item {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 14px 24px 14px 16px;\n  border: 0;\n  border-radius: 999px;\n  background: none;\n  font-family: \"Work Sans\", sans-serif;\n  font-size: 16px;\n  font-weight: 400;\n  line-height: 20px;\n  color: var(--pxnav-fg);\n  white-space: nowrap;\n  cursor: pointer;\n  text-decoration: none;\n  transition: background .2s var(--pxnav-ease-menu), color var(--pxnav-dur) var(--pxnav-ease);\n}\n[data-pxsol-global=\"header\"] .pxnav__item:hover { background: rgba(255, 255, 255, .10); color: var(--pxnav-fg); }\n[data-pxsol-global=\"header\"] .pxnav__item.--on { background: rgba(255, 255, 255, .20); }\n[data-pxsol-global=\"header\"] .pxnav__item:focus-visible { outline: 2px solid #D20A11; outline-offset: 2px; }\n\n[data-pxsol-global=\"header\"] .pxnav__chev {\n  display: block;\n  width: 20px;\n  height: 20px;\n  flex: none;\n  color: #71717B;\n  transition: transform .3s var(--pxnav-ease-menu), color .2s;\n}\n[data-pxsol-global=\"header\"] .pxnav__item.--on .pxnav__chev { transform: rotate(180deg); color: #D4D4D8; }\n\n/* Un solo label visible a la vez, con `display`.\n   Animar el ancho de los dos fue peor: durante los 450ms se leían SUPERPUESTOS\n   (\"Software para Hoteles Hot\", \"Recursos Rec\", \"Nosotros Nos\") — reportado por\n   Sofi el 07/08/2026 con video. El swap tiene que ser instantáneo; lo que se anima\n   es la CAJA, y de eso se encarga la barra. */\n/* ── LOS DOS ESTADOS DICEN LO MISMO ──────────────────────────────────────────\n   Los textos del menú NO cambian: \"Hoteles / Agencias / Recursos / Precios /\n   Nosotros\", arriba y en la píldora. El markup sigue trayendo las dos versiones\n   (viene de la base y no se toca), así que la larga se apaga acá y listo.\n\n   Es la decisión que hace que el movimiento sea limpio, y la tomó Sofi el\n   29/08/2026 pidiendo copiar el \"durante\" de invgate.com. El razonamiento:\n   mientras la caja se anima 200ms, contenido y caja no pueden coincidir si los\n   dos estados tienen contenidos distintos. O el contenido va largo en la caja\n   chica —y desborda: se midió 1691px adentro de 1040, con \"Cotizar\" 179px fuera\n   de la pantalla— o va corto en la caja grande, y se despatarra de lado a lado.\n   No hay una tercera opción. Se probaron las dos y las dos se ven mal.\n\n   Con el mismo contenido en los dos estados el problema desaparece de raíz: lo\n   único que cambia es el logo (logotipo ↔ isotipo, 74px ↔ 32px, instantáneo) y\n   el ancho de la caja. Un solo movimiento, como invgate — que puede hacerlo\n   justamente porque sus labels tampoco cambian. Y no hace falta ninguna\n   coreografía en el JS: no hay timers ni clases de contenido que sincronizar. */\n[data-pxsol-global=\"header\"] .pxnav__lab-l { display: none; }\n[data-pxsol-global=\"header\"] .pxnav__lab-s { display: inline; }\n\n/* ── Acciones de la derecha ──────────────────────────────────────────────── */\n[data-pxsol-global=\"header\"] .pxnav__cta {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex: none;\n}\n\n[data-pxsol-global=\"header\"] .pxnav__globe {\n  width: 32px;\n  height: 32px;\n  border-radius: 999px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 0;\n  border: 0;\n  background: rgba(255, 255, 255, .06);\n  color: #D4D4D8;\n  cursor: pointer;\n  transition: background .2s;\n}\n[data-pxsol-global=\"header\"] .pxnav__globe:hover { background: rgba(255, 255, 255, .14); }\n/* Bootstrap le dibuja un caret con ::after a todo `.dropdown-toggle`. En la píldora\n   ese piquito queda apretado contra el globo y se ve sucio: acá manda el ícono solo. */\n[data-pxsol-global=\"header\"] .pxnav__globe::after { display: none !important; }\n[data-pxsol-global=\"header\"] .pxnav__globe svg { display: block; width: 18px; height: 18px; }\n\n[data-pxsol-global=\"header\"] .pxnav__btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  height: 50px;\n  padding: 0 24px;\n  border-radius: 50px;\n  font-family: \"Work Sans\", sans-serif;\n  font-size: 16px;\n  font-weight: 500;\n  line-height: 20px;\n  white-space: nowrap;\n  text-decoration: none;\n  transition:\n    background .2s var(--pxnav-ease-menu),\n    color var(--pxnav-dur) var(--pxnav-ease),\n    border-color var(--pxnav-dur) var(--pxnav-ease),\n    transform .12s var(--pxnav-ease-menu);\n}\n[data-pxsol-global=\"header\"] .pxnav__btn:active { transform: scale(.97); }\n\n[data-pxsol-global=\"header\"] .pxnav__btn--ghost {\n  background: var(--pxnav-ink);\n  border: 1px solid rgba(255, 255, 255, .18);\n  color: #fff;\n}\n[data-pxsol-global=\"header\"] .pxnav__btn--ghost:hover { background: var(--pxnav-card); color: #fff; }\n\n/* \"Cotizar\" lleva un halo detrás. Sobre oscuro va rojo/azul de marca; sobre claro\n   cambia a celeste/lavanda.\n\n   El botón NO puede crear stacking context (nada de `isolation` ni `z-index`): los\n   halos van con `z-index:-1` para quedar por debajo del fondo del botón, y eso solo\n   funciona si el contexto de apilamiento es un ancestro. Con `isolation:isolate` el\n   fondo blanco se pinta primero y el halo le queda ENCIMA — el botón se ve rosado. */\n[data-pxsol-global=\"header\"] .pxnav__btn--solid {\n  position: relative;\n  background: #fff;\n  border: 1px solid transparent;\n  color: #262728;\n}\n[data-pxsol-global=\"header\"] .pxnav__glow {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  border-radius: 999px;\n  z-index: -1;\n  pointer-events: none;\n  transition: opacity var(--pxnav-dur) var(--pxnav-ease);\n}\n[data-pxsol-global=\"header\"] .pxnav__glow--near { width: 60%; height: 80%; filter: blur(16px); opacity: .8; }\n[data-pxsol-global=\"header\"] .pxnav__glow--far { width: 70%; height: 90%; filter: blur(18px); opacity: 0; }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--stuck .pxnav__glow--near { opacity: 0; }\n\n/* ── Estado claro: la barra sobre una sección clara ───────────────────────── */\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__item { color: rgba(0, 0, 23, .8); }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__item:hover { background: rgba(0, 0, 23, .06); color: var(--pxnav-ink); }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__globe svg { color: rgba(0, 0, 23, .8); }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__item.--on { background: rgba(0, 0, 23, .08); }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__chev { color: #6E6E85; }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__globe { background: rgba(0, 0, 23, .06); color: var(--pxnav-ink); }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__btn--ghost { background: #fff; border-color: rgba(0, 0, 23, .14); color: var(--pxnav-ink); }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__btn--ghost:hover { background: rgba(0, 0, 23, .06); color: var(--pxnav-ink); }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__btn--solid { background: var(--pxnav-ink); color: #fff; }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__glow--near { opacity: 0; }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__glow--far { opacity: .75; }\n/* La píldora sobre fondo claro va del MISMO color que el cuerpo del sitio\n   (#F7F8F8), no blanca: blanca sobre el gris del cuerpo se recortaba como un\n   parche más claro pegado encima. Y va OPACA a propósito — con alfa, el color\n   de la barra cambiaba según lo que pasara por debajo al scrollear, que es\n   justo lo que no tiene que pasar si el punto es que se lea igual que el\n   cuerpo. La sigue despegando el borde y la sombra, no el color.\n   Pedido de Sofi, 28/08/2026. */\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light.--stuck .pxnav {\n  background: #F7F8F8;\n  border-color: rgba(0, 0, 23, .08);\n  box-shadow: 0 10px 30px rgba(0, 0, 23, .10);\n}\n\n/* ── Paneles ─────────────────────────────────────────────────────────────────\n   El scrim va DETRÁS de los paneles y por delante de la página: cierra al hacer\n   click afuera sin robarle el click a los links del panel. */\n[data-pxsol-global=\"header\"] .pxnav-scrim {\n  position: fixed;\n  inset: 0;\n  z-index: 20;\n  display: none;\n}\n[data-pxsol-global=\"header\"] .pxnav-wrap.--open .pxnav-scrim { display: block; }\n\n[data-pxsol-global=\"header\"] .pxnav-drops {\n  position: absolute;\n  top: calc(100% + 8px);\n  left: 0;\n  right: 0;\n  z-index: 30;\n  pointer-events: none;\n}\n[data-pxsol-global=\"header\"] .pxnav-drop {\n  position: absolute;\n  top: 0;\n  /* El panel se mide por SU contenido, no por la barra.\n     `.pxnav-drops` va de borde a borde de la barra, y en píldora eso son 1040px:\n     los paneles conservados, que son `display:block`, se achicaban a ese ancho y\n     quedaban amontonados —títulos partidos en dos, una palabra por renglón, el\n     \"Ver más\" cortado— (Sofi, 07/08/2026). Con `max-content` conservan su ancho en\n     los dos estados; de que no se salgan de la pantalla ya se ocupa `ubicar()`. */\n\n  opacity: 0;\n  transform: translateY(-8px);\n  pointer-events: none;\n  transition: opacity .18s var(--pxnav-ease-menu), transform .22s var(--pxnav-ease-menu);\n}\n[data-pxsol-global=\"header\"] .pxnav-drop.--open {\n  opacity: 1;\n  transform: none;\n  pointer-events: auto;\n}\n\n/* ── Panel de productos ──────────────────────────────────────────────────── */\n[data-pxsol-global=\"header\"] .pxpanel {\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 14px;\n  background: var(--pxnav-ink);\n  border: 1px solid var(--pxnav-card);\n  border-radius: 16px;\n  box-shadow: 0 24px 60px rgba(0, 0, 23, .55);\n  font-family: \"Work Sans\", sans-serif;\n  overflow: hidden;\n  position: relative;\n}\n[data-pxsol-global=\"header\"] .pxpanel__top { display: flex; align-items: stretch; }\n\n/* Columna izquierda: las dos tarjetas que eligen el segmento. Las filas son\n   FIJAS en 185px a propósito — así el panel mide lo mismo con Hoteles (14 ítems)\n   que con Vacation Rentals (5), y no da un salto al cambiar de segmento. */\n[data-pxsol-global=\"header\"] .pxpanel__cards {\n  /* Ancho flexible: con el panel más angosto (termina en la mitad de \"Nosotros\"),\n     un 400px fijo dejaba el bloque de listas sin llegar al borde y se veía un\n     margen de más contra el gradiente (Sofi, 07/08/2026). */\n  flex: 0 1 400px;\n  min-width: 0;\n  display: grid;\n  grid-template-rows: 185px 185px;\n  gap: 14px;\n}\n[data-pxsol-global=\"header\"] .pxcard {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  width: 100%;\n  padding: 0;\n  border: 0;\n  border-radius: 8px 0 0 8px;\n  background: transparent;\n  overflow: hidden;\n  position: relative;\n  cursor: pointer;\n  text-align: left;\n  transition: background .18s var(--pxnav-ease-menu);\n}\n[data-pxsol-global=\"header\"] .pxcard.--on { background: var(--pxnav-card); }\n[data-pxsol-global=\"header\"] .pxcard:focus-visible { outline: 2px solid #D20A11; outline-offset: -2px; }\n[data-pxsol-global=\"header\"] .pxcard__thumb {\n  width: 196px;\n  flex: none;\n  align-self: stretch;\n  overflow: hidden;\n  border-radius: 12px 0 0 12px;\n}\n[data-pxsol-global=\"header\"] .pxcard__thumb img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform .5s var(--pxnav-ease-menu);\n}\n[data-pxsol-global=\"header\"] .pxcard:hover .pxcard__thumb img { transform: scale(1.04); }\n[data-pxsol-global=\"header\"] .pxcard__body {\n  width: 204px;\n  padding: 14px 16px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  transition: opacity .18s var(--pxnav-ease-menu);\n}\n[data-pxsol-global=\"header\"] .pxcard.--off .pxcard__body { opacity: .6; }\n[data-pxsol-global=\"header\"] .pxcard__ttl {\n  margin: 0 0 12px;\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 19px;\n  letter-spacing: -.01em;\n  color: var(--pxnav-fg);\n}\n[data-pxsol-global=\"header\"] .pxcard__desc {\n  margin: 0;\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 19px;\n  color: var(--pxnav-desc);\n  text-wrap: pretty;\n}\n\n/* Columna derecha: la esquina de unión sigue a la tarjeta activa, así el bloque\n   se lee como una sola pieza con la tarjeta seleccionada. */\n[data-pxsol-global=\"header\"] .pxpanel__lists {\n  flex: 1 1 auto;\n  min-width: 0;\n  padding: 14px;\n  background: var(--pxnav-card);\n  border-radius: 0 12px 12px 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  position: relative;\n  overflow: hidden;\n  transition: border-radius .3s var(--pxnav-ease-menu);\n}\n[data-pxsol-global=\"header\"] .pxpanel__lists.--join-bottom { border-radius: 12px 12px 12px 0; }\n[data-pxsol-global=\"header\"] .pxpanel__blob {\n  position: absolute;\n  width: 262px;\n  height: 262px;\n  top: 66px;\n  right: -130px;\n  border-radius: 999px;\n  background: #2B7FFF;\n  opacity: .14;\n  filter: blur(37px);\n  pointer-events: none;\n}\n[data-pxsol-global=\"header\"] .pxlist { display: flex; gap: 16px; align-items: flex-start; position: relative; z-index: 1; }\n[data-pxsol-global=\"header\"] .pxlist[hidden] { display: none; }\n[data-pxsol-global=\"header\"] .pxlist ul { list-style: none; margin: 0; padding: 0; width: 200px; }\n[data-pxsol-global=\"header\"] .pxlist a {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  height: 34px;\n  padding: 0 8px;\n  border-radius: 8px;\n  white-space: nowrap;\n  font-size: 14.5px;\n  font-weight: 500;\n  line-height: 20px;\n  color: var(--pxnav-fg);\n  text-decoration: none;\n  transition: background .18s var(--pxnav-ease-menu);\n}\n[data-pxsol-global=\"header\"] .pxlist a:hover { background: rgba(255, 255, 255, .08); color: #fff; }\n[data-pxsol-global=\"header\"] .pxlist .pxlist__cap {\n  padding: 12px 10px 4px;\n  font-size: 10.5px;\n  font-weight: 600;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  color: var(--pxnav-mut);\n}\n[data-pxsol-global=\"header\"] .pxlist ul \u003e li:first-child .pxlist__cap { padding-top: 0; }\n/* El único lugar del header donde se usa Inter; todo el resto es Work Sans. */\n[data-pxsol-global=\"header\"] .pxbadge {\n  margin-left: 2px;\n  padding: 0 8px;\n  border-radius: 999px;\n  background: #1F8A5B;\n  font-family: Inter, \"Work Sans\", sans-serif;\n  font-size: 9.5px;\n  font-weight: 600;\n  line-height: 18px;\n  letter-spacing: .08em;\n  color: #fff;\n}\n\n/* ── Banda de Pagos e Integraciones ──────────────────────────────────────── */\n[data-pxsol-global=\"header\"] .pxband { display: flex; gap: 10px; }\n[data-pxsol-global=\"header\"] .pxband__bar {\n  flex: 1;\n  min-width: 0;\n  height: 44px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 0 18px;\n  border-radius: 12px;\n  background: var(--pxnav-card);\n  text-decoration: none;\n  transition: background .18s var(--pxnav-ease-menu);\n}\n[data-pxsol-global=\"header\"] .pxband__bar--wide { flex: 1.35; }\n[data-pxsol-global=\"header\"] .pxband__bar:hover { background: var(--pxnav-card2); }\n[data-pxsol-global=\"header\"] .pxband__bar svg { display: block; flex: none; }\n[data-pxsol-global=\"header\"] .pxband__ico { width: 17px; height: 17px; color: var(--pxnav-mut); }\n[data-pxsol-global=\"header\"] .pxband__ttl { font-size: 14px; font-weight: 600; color: var(--pxnav-fg); white-space: nowrap; }\n[data-pxsol-global=\"header\"] .pxband__lst {\n  font-size: 12.5px;\n  color: var(--pxnav-mut);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  min-width: 0;\n}\n[data-pxsol-global=\"header\"] .pxband__go { margin-left: auto; display: inline-flex; align-items: center; color: var(--pxnav-fg); }\n[data-pxsol-global=\"header\"] .pxband__go svg { width: 16px; height: 16px; }\n\n\n\n/* ── Mobile ──────────────────────────────────────────────────────────────────\n   El handoff es de escritorio (1728px) y no cubre mobile, así que abajo de\n   1100px sigue mandando el menú mobile que ya existía: se esconden los links y\n   las acciones, y queda logo + hamburguesa. */\n[data-pxsol-global=\"header\"] .pxnav__burger {\n  display: none;\n  flex: none;\n  width: 40px;\n  height: 40px;\n  margin-left: auto;\n  padding: 11px 9px;\n  border: 0;\n  background: none;\n  cursor: pointer;\n}\n[data-pxsol-global=\"header\"] .pxnav__burger span {\n  display: block;\n  height: 2px;\n  margin-bottom: 5px;\n  border-radius: 2px;\n  background: #fff;\n  transition: background var(--pxnav-dur) var(--pxnav-ease);\n}\n[data-pxsol-global=\"header\"] .pxnav__burger span:last-child { margin-bottom: 0; }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav__burger span { background: var(--pxnav-ink); }\n\n/* El diseño se dibujó sobre 1728px de ancho. Abajo de eso el contenido no entra:\n   medido en producción a 1512, ocupaba 1417,8 contra 1392 útiles y los botones\n   quedaban 62,8px FUERA de la pantalla. Se recupera en dos pasos —primero gap y\n   padding, después los labels cortos— antes de caer en la hamburguesa. */\n@media (max-width: 1727px) {\n  [data-pxsol-global=\"header\"] .pxnav { padding: 0 40px; max-width: min(1728px, max(1260px, calc(100% - 96px))); }\n  /* Acá el contenido mide 1235px: la píldora baja en la misma proporción. */\n  [data-pxsol-global=\"header\"] .pxnav-wrap.--stuck .pxnav { max-width: 1260px; }\n  [data-pxsol-global=\"header\"] .pxnav__nav { gap: 24px; margin-left: 28px; }\n}\n@media (max-width: 1500px) {\n  [data-pxsol-global=\"header\"] .pxnav { padding: 0 28px; max-width: min(1728px, max(1128px, calc(100% - 96px))); }\n  /* Y acá 1101px. */\n  [data-pxsol-global=\"header\"] .pxnav-wrap.--stuck .pxnav { max-width: 1128px; }\n  [data-pxsol-global=\"header\"] .pxnav__nav { gap: 14px; margin-left: 20px; }\n  /* Los labels cortos también sin scrollear: son los que hacen entrar las cinco\n     entradas, y es preferible a apretar la tipografía. El corte va en 1500 y no\n     en 1400 porque, medido, con los labels largos el contenido ocupa 1383,8px y\n     necesita 1464 de viewport: a 1440 los botones se salían 52,8px. */\n  [data-pxsol-global=\"header\"] .pxnav__lab-l { display: none; }\n  [data-pxsol-global=\"header\"] .pxnav__lab-s { display: inline; }\n  [data-pxsol-global=\"header\"] .pxnav__item { padding: 10px 14px 10px 12px; }\n}\n\n/* El último tramo antes de la hamburguesa. Acá el contenido casi llena la\n   pantalla, y como el padding ya NO se achica al recogerse (antes bajaba a 20px\n   y liberaba 36), a 1101px de viewport se desbordaba 5px. Medido. */\n@media (max-width: 1250px) {\n  [data-pxsol-global=\"header\"] .pxnav { padding: 0 14px; }\n}\n\n@media (max-width: 1100px) {\n  [data-pxsol-global=\"header\"] .pxnav { padding: 0 16px; }\n  [data-pxsol-global=\"header\"] .pxnav__nav,\n  [data-pxsol-global=\"header\"] .pxnav__cta { display: none; }\n  [data-pxsol-global=\"header\"] .pxnav__burger { display: block; }\n  /* En mobile el logotipo completo se queda: no hay links que recentrar. */\n  [data-pxsol-global=\"header\"] .pxnav-wrap.--stuck .pxnav__logo--full { max-width: 120px; }\n  [data-pxsol-global=\"header\"] .pxnav-wrap.--stuck .pxnav__logo--iso { max-width: 0; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  [data-pxsol-global=\"header\"] .pxnav-wrap,\n  [data-pxsol-global=\"header\"] .pxnav,\n  [data-pxsol-global=\"header\"] .pxnav__logo,\n  [data-pxsol-global=\"header\"] .pxnav__nav,\n  [data-pxsol-global=\"header\"] .pxnav__item,\n  [data-pxsol-global=\"header\"] .pxnav__btn,\n  [data-pxsol-global=\"header\"] .pxnav__chev,\n  [data-pxsol-global=\"header\"] .pxnav-drop,\n  [data-pxsol-global=\"header\"] .pxcard__thumb img { transition-duration: 1ms; }\n}\n\n/* ── Los paneles, en claro ───────────────────────────────────────────────────\n   El desplegable tiene que ser del mismo color que la barra: con el header en\n   claro, un panel negro se lee como de otra página (Sofi, 07/08/2026). */\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxpanel,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav-drop .px-headerSection {\n  background: #FFFFFF !important;\n  border-color: rgba(0, 0, 23, .10);\n  box-shadow: 0 24px 60px rgba(0, 0, 23, .18);\n}\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxpanel__lists,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxcard.--on,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxband__bar,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav-drop .px-headerSectionCards__card {\n  background: #F4F5F8 !important;\n}\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxband__bar:hover { background: #EAECF2 !important; }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxcard__ttl,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxlist a,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxband__ttl,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav-drop .px-headerSectionCards__cardTitle,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav-drop .px-headerSectionCards__cardButton {\n  color: var(--pxnav-ink) !important;\n}\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxcard__desc,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxlist__cap,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxband__lst,\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav-drop .px-headerSectionCards__cardDesc {\n  color: #5A5A6E !important;\n}\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxlist a:hover { background: rgba(0, 0, 23, .06); }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxband__go { color: var(--pxnav-ink); }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxpanel__blob { opacity: .07; }\n[data-pxsol-global=\"header\"] .pxnav-wrap.--light .pxnav-drop .px-headerSectionCards__cardButton {\n  border-color: rgba(0, 0, 23, .18) !important;\n}\n\n\n\n/* Solo la primera tarjeta se estira a las dos filas; el resto ocupa una. */\n/* `grid-column: auto` es la pieza que faltaba: alguna tarjeta trae su columna\n   declarada por el tema y eso creaba una QUINTA columna implícita, por más que la\n   plantilla dijera cuatro (medido: el wrapper devolvía cinco anchos distintos). */\n[data-pxsol-global=\"header\"] .pxnav-drop .px-headerSectionCards__card {\n  grid-row: auto !important;\n  grid-column: auto !important;\n}\n[data-pxsol-global=\"header\"] .pxnav-drop .px-headerSectionCards__card:first-child { grid-row: 1 / 3 !important; }\n\n\n\n/* ── Paneles de Recursos y Nosotros ──────────────────────────────────────────\n   Markup y estilos PROPIOS: ni una clase del tema de HubSpot. Antes heredaban su\n   CSS y cada ajuste era pelearle a reglas ajenas — el ancho de la primera columna\n   no se pudo arreglar por eso (las 4 columnas sumaban 746px dentro de 929).\n\n   La primera tarjeta ocupa las dos filas y se lleva más ancho: es la que más texto\n   tiene. El resto llena las columnas que quedan, de a dos. */\n[data-pxsol-global=\"header\"] .pxsec {\n  display: grid;\n  gap: 10px;\n  align-items: stretch;\n}\n[data-pxsol-global=\"header\"] .pxsec[data-cols=\"3\"] { grid-template-columns: 1.15fr 1fr 1fr; }\n[data-pxsol-global=\"header\"] .pxsec[data-cols=\"4\"] { grid-template-columns: 1.15fr 1fr 1fr 1fr; }\n[data-pxsol-global=\"header\"] .pxsec__card {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 14px 16px;\n  border-radius: 14px;\n  background: var(--pxnav-card);\n  text-decoration: none;\n  transition: background .18s var(--pxnav-ease-menu);\n}\n[data-pxsol-global=\"header\"] .pxsec__card:hover { background: var(--pxnav-card2); }\n[data-pxsol-global=\"header\"] .pxsec__card--alta {\n  grid-row: 1 / 3;\n  background: var(--pxnav-card);\n}\n[data-pxsol-global=\"header\"] .pxsec__ttl {\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 20px;\n  letter-spacing: -.01em;\n  color: var(--pxnav-fg);\n}\n[data-pxsol-global=\"header\"] .pxsec__desc {\n  font-size: 14px;\n  line-height: 20px;\n  color: var(--pxnav-desc);\n  text-wrap: pretty;\n}\n/* El pie: el ícono al lado del botón, en la misma línea. */\n[data-pxsol-global=\"header\"] .pxsec__pie {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-top: auto;\n  padding-top: 10px;\n}\n[data-pxsol-global=\"header\"] .pxsec__ico { width: 26px; height: 26px; flex: none; object-fit: contain; }\n[data-pxsol-global=\"header\"] .pxsec__cta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 8px 18px;\n  border: 1px solid rgba(255, 255, 255, .22);\n  border-radius: 999px;\n  font-size: 14px;\n  font-weight: 500;\n  color: var(--pxnav-fg);\n  white-space: nowrap;\n  transition: background .18s var(--pxnav-ease-menu), border-color .18s var(--pxnav-ease-menu);\n}\n[data-pxsol-global=\"header\"] .pxsec__card:hover .pxsec__cta {\n  background: rgba(255, 255, 255, .10);\n  border-color: rgba(255, 255, 255, .38);\n}\n\n/* La banda de ayuda, al pie del panel. */\n[data-pxsol-global=\"header\"] .pxsec-wrap { display: flex; flex-direction: column; gap: 12px; }\n[data-pxsol-global=\"header\"] .pxsec__banda {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 10px 12px 10px 20px;\n  border-radius: 14px;\n  background: rgba(42, 111, 219, .10);\n}\n[data-pxsol-global=\"header\"] .pxsec__bandaTxt { font-size: 15px; font-weight: 500; color: var(--pxnav-fg); }\n[data-pxsol-global=\"header\"] .pxsec__bandaCta {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  padding: 9px 20px;\n  border-radius: 999px;\n  background: var(--pxnav-ink);\n  border: 1px solid rgba(255, 255, 255, .16);\n  font-size: 14px;\n  font-weight: 500;\n  color: #fff;\n  text-decoration: none;\n  white-space: nowrap;\n}\n[data-pxsol-global=\"header\"] .pxsec__waIco { width: 20px; height: 20px; flex: none; object-fit: contain; }\n[data-pxsol-global=\"header\"] .pxsec__bandaCta:hover { background: var(--pxnav-card2); color: #fff; }\n[data-pxsol-global=\"header\"] .pxsec__foto { margin-top: auto; padding-top: 12px; }\n[data-pxsol-global=\"header\"] .pxsec__foto img {\n  display: block;\n  width: 100%;\n  height: 96px;\n  object-fit: cover;\n  border-radius: 12px;\n}\n[data-pxsol-global=\"header\"] .pxsec__links {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  margin-top: auto;\n  padding-top: 12px;\n}\n[data-pxsol-global=\"header\"] .pxsec__card--alta:has(.pxsec__foto) .pxsec__links { margin-top: 0; }\n/* Los links del pie tienen que LEERSE como cliqueables: sin caja ni respuesta al\n