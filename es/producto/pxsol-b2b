  .pxsite .integ__cta{margin-top:32px;}
  /* Diagrama del PMS: núcleo arriba, áreas en una columna y sin conectores. */
  .pxsite .whub__grid{grid-template-columns:1fr;gap:18px;margin-top:32px;}
  .pxsite .whub__core{order:-1;max-width:420px;width:100%;margin:0 auto 6px;}
  .pxsite .whub__area::after{display:none;}
  .pxsite .whub__lead,.pxsite .whub__closing{font-size:16px;}
  .pxsite .whub__closing{margin-top:32px;}
  /* La foto va arriba de la lista: al tocar una tarjeta se ve el cambio sin scrollear. */
  .pxsite .sshow{padding-bottom:52px;}
  .pxsite .sshow__body{grid-template-columns:1fr;gap:20px;margin-top:32px;}
  .pxsite .sshow__media{order:-1;min-height:0;aspect-ratio:1/1;}
  .pxsite .sshow__metrics{margin-top:32px;}
  .pxsite .sgrid__body{grid-template-columns:1fr;}
  .pxsite .sgrid__panel{padding:48px 24px 24px;}
  .pxsite .sgrid__buttons{grid-template-columns:1fr;}
  .pxsite .sgrid__btn{padding:24px;}
  .pxsite .sgrid__btn--first{grid-column:auto;}
  .pxsite .band--bg .inner{padding:52px 26px;}
  /* Reseñas: la reseña arriba y la foto abajo, pegadas, como una sola tarjeta.
     Se apila desde 1080px y no desde los 768px del origen: acá el carrusel está
     capado a 1400px y con 88px de padding para las flechas, así que entre 769 y
     1080 la columna de texto quedaba apretada contra la foto de 519px fija (y a
     768 justo desbordaba). Es el mismo layout, aplicado un poco antes.
     La tarjeta flotante pasa a centrada arriba de la foto y las flechas quedan
     sobre la imagen (top calc(100% - 288px) en el origen), con fondo translúcido. */
  .pxsite .hcar__stage{padding:0 18px;}
  .pxsite .hcar__item{flex-direction:column;align-items:stretch;}
  .pxsite .hcar__info{max-width:100%;padding:48px 16px;border-radius:20px 20px 0 0;gap:24px;}
  .pxsite .hcar__imageWrapper,.pxsite .hcar__image{width:100%;height:270px;border-radius:0 0 20px 20px;}
  .pxsite .hcar__card{top:22px;left:50%;right:auto;transform:translateX(-50%);width:calc(100% - 52px);padding:16px;}
  .pxsite .hcar__nav{top:calc(100% - 135px);width:48px;height:48px;background:rgba(255,255,255,.2);backdrop-filter:blur(10px);}
  .pxsite .hcar__nav--prev{left:6px;}
  .pxsite .hcar__nav--next{right:6px;}
  .pxsite .band--bg .inner>div:first-child,.pxsite .band__image{flex:1 1 auto;}
  /* El texto del paso arriba y su carrusel abajo, sin importar el lado. */
  .pxsite .step{grid-template-columns:1fr;gap:32px;}
  .pxsite .step--left .step-txt,.pxsite .step--left .step-car{order:0;}
  .pxsite .dir-filters{grid-template-columns:1fr 1fr;}
  .pxsite .dir-count{grid-column:1/-1;}
  .pxsite .dir-grid{grid-template-columns:repeat(3,1fr);gap:24px;}
}
@media (max-width:600px){
  .pxsite .sec{padding:48px 0;}
  .pxsite .hero{padding:30px 0 10px;}
  /* Los 30px de arriba de la regla anterior NO le alcanzan al hero--bg: es el
     unico de los claros que arranca con el badge pegado al borde, y el header
     flota encima. Doble clase para ganarle a .pxsite .hero (empata en
     especificidad y viene despues) — era el solape de 46px del PMS. */
  .pxsite .hero.hero--bg{padding-top:calc(var(--px-header-h, 88px) + 16px);}
  .pxsite .hero .panel{grid-template-columns:1fr;padding:20px 20px 0;min-height:0;}
  .pxsite .hero .panel .shot{border-radius:12px 12px 0 0;margin-top:6px;}
  .pxsite .hero .stats{grid-template-columns:1fr;gap:10px;}
  .pxsite .hero .stat{display:flex;align-items:center;gap:12px;padding:12px 14px;}
  .pxsite .hero .stat .v{margin:0;font-size:19px;}
  .pxsite .hero .stat .l{margin:0;}
  .pxsite .feats,.pxsite .posts{grid-template-columns:1fr;gap:14px;}
  /* Sin la marca de agua la card puede apretarse mas: 24 de padding y el titulo
     a 18/20, que es lo que sirve la publicada en el corte chico. */
