  /* Directorio: dos columnas y los tres filtros apilados. */
  .pxsite .dir-filters{grid-template-columns:1fr;gap:12px;margin-top:32px;}
  .pxsite .dir-count{width:auto;text-align:left;}
  .pxsite .dir-h3{margin-top:32px;}
  .pxsite .dir-grid{grid-template-columns:repeat(2,1fr);gap:14px;margin-top:32px;}
  .pxsite .dircard{gap:14px;padding:16px;}
  .pxsite .dircard .logo{height:40px;}
  .pxsite .dircard .logo--mono{width:40px;}
  .pxsite .dircard .tx{gap:6px;}
