.pxsite .featlist__kickerRow{text-align:center;margin:0;}
.pxsite .featlist__kicker{display:inline-flex;align-items:center;justify-content:center;min-height:42px;min-width:169px;padding:0 16px;border:1px solid;border-radius:100px;font-size:14px;line-height:20px;font-weight:500;text-align:center;margin-bottom:16px;}
