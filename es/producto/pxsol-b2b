.pxsite .reasons__card p{font-size:16px;line-height:24px;margin:0;}
@media (max-width:768px){
  /* 24px en los CUATRO lados de la caja, mas los 12 del container de adentro. */
  .pxsite .reasons{border-radius:20px;padding:24px;}
  .pxsite .reasons__title{font-size:28px;line-height:30px;}
  .pxsite .reasons__desc{font-size:24px;line-height:34px;}
