/* ── CSS propio del blog (verbatim de HubSpot) ── */
/* ── reset de scoping: main.css del tema aplica letter-spacing global; lo neutralizamos dentro del blog ── */
.blogroot, .blogroot *{ letter-spacing:normal; }
.blogroot{ font-family:"Inter","Work Sans",sans-serif; }
main#main-content .blogroot{ max-width:none; }

/* ── botones design system Pxsol (.pxs-btn*) ── */
.pxs-btn{ display:inline-flex; align-items:center; justify-content:center; gap:8px;
  font-family:"Work Sans",sans-serif; font-weight:500; font-size:15px; line-height:1;
  padding:13px 22px; border-radius:100px; border:1.5px solid transparent; cursor:pointer;
  text-decoration:none; white-space:nowrap;
  transition:transform .15s cubic-bezier(.22,.61,.36,1), background .15s, color .15s, border-color .15s, box-shadow .15s; }
.pxs-btn:active{ transform:scale(.97); }
.pxs-btn--primary{ background:#000017; color:#fff; }
.pxs-btn--primary:hover{ background:#1b1b33; }
.pxs-btn--red{ background:#D20A11; color:#fff; }
.pxs-btn--red:hover{ background:#b3090f; }
.pxs-btn--sky{ background:#E8F2FF; color:#000017; }
.pxs-btn--sky:hover{ background:#d6e8ff; }
.pxs-btn--ghost-light{ background:transparent; color:#fff; border-color:rgba(255,255,255,.32); }
.pxs-btn--ghost-light:hover{ background:rgba(255,255,255,.10); border-color:rgba(255,255,255,.55); }
.pxs-btn--sm{ font-size:13.5px; padding:9px 16px; }
.pxs-btn--lg{ font-size:16px; padding:16px 28px; }


/* ════════════ blogapp (componentes: masthead, cards, meta, newsletter, pager, footer) ════════════ */
.blogroot{ font-family:"Inter","Work Sans",sans-serif; color:#000017; background:#fff; }
  .blogroot *{ box-sizing:border-box; }
  .wrap{ max-width:1240px; margin:0 auto; padding:0 48px; }
  .ws{ font-family:"Work Sans",sans-serif; }

  /* ── masthead del blog (categorías + buscador) ─────────────── */
  .bmast{ position:sticky; top:0; z-index:60; background:rgba(255,255,255,.9);
    backdrop-filter:blur(14px); border-bottom:1px solid rgba(0,0,0,.07); }
  .bmast__row{ height:64px; display:flex; align-items:center; gap:26px; }
  .bmast__brand{ display:flex; align-items:center; gap:11px; text-decoration:none; flex:0 0 auto; }
  .bmast__brandtag{ font-family:"Work Sans",sans-serif; font-weight:500; font-size:15px; color:#000017;
    letter-spacing:-.01em; padding-left:11px; border-left:1px solid rgba(0,0,0,.14); }
  .bmast__cats{ display:flex; align-items:center; gap:4px; overflow-x:auto; scrollbar-width:none;
    -ms-overflow-style:none; flex:1; }
  .bmast__cats::-webkit-scrollbar{ display:none; }
  .bmast__cat{ font-family:"Work Sans",sans-serif; font-weight:500; font-size:14.5px; color:#555;
    text-decoration:none; padding:8px 13px; border-radius:100px; white-space:nowrap;
    transition:background .15s,color .15s; }
  .bmast__cat:hover{ color:#000017; background:rgba(0,0,23,.05); }
  .bmast__cat.is-active{ color:#fff; background:#000017; }
  .bmast__search{ flex:0 0 auto; display:flex; align-items:center; gap:8px; height:40px;
    padding:0 14px; border-radius:100px; background:#F4F4F5; min-width:230px;
    transition:box-shadow .15s,background .15s; }
  .bmast__search:focus-within{ background:#fff; box-shadow:inset 0 0 0 1.5px #000017; }
  .bmast__search input{ border:0; background:transparent; outline:none; font:14.5px "Inter",sans-serif;
    color:#000017; width:100%; }
  .bmast__search svg{ color:#999; flex:0 0 auto; }
  .bmast__menubtn{ display:none; }

  /* ── category tag / overline ───────────────────────────────── */
  .cattag{ display:inline-flex; align-items:center; gap:7px; font-family:"Inter",sans-serif;
    font-size:11.5px; font-weight:600; letter-spacing:.06em; text-transform:uppercase;
    color:#666; text-decoration:none; transition:color .15s; }
  .cattag::before{ content:""; width:6px; height:6px; border-radius:50%; background:#D20A11; flex:0 0 auto; }
  a.cattag:hover{ color:#D20A11; }

  /* ── avatar + meta ─────────────────────────────────────────── */
  .avatar{ width:28px; height:28px; border-radius:50%; flex:0 0 auto; display:flex;
    align-items:center; justify-content:center; color:#fff; font-family:"Work Sans",sans-serif;
    font-weight:600; font-size:11px; letter-spacing:.01em; }
  .meta{ display:flex; align-items:center; gap:9px; font-family:"Inter",sans-serif;
    font-size:13px; color:#666; }
  .meta a.nm{ font-weight:500; color:#333; text-decoration:none; transition:color .15s; }
  .meta a.nm:hover{ color:#D20A11; }
  .meta .dot{ width:3px; height:3px; border-radius:50%; background:#C9C9CF; flex:0 0 auto; }

  /* ── post card (image) ─────────────────────────────────────── */
  .pcard{ display:flex; flex-direction:column; gap:14px; text-decoration:none; cursor:pointer; }
  .pcard__imgwrap{ position:relative; border-radius:14px; overflow:hidden; aspect-ratio:16/10;
    background:linear-gradient(135deg,#F1F1F3,#E6E9F0); box-shadow:0 0 11px rgba(34,34,34,.10); }
  .pcard__img{ width:100%; height:100%; object-fit:cover; display:block;
    transition:transform .5s cubic-bezier(.22,.61,.36,1); }
  .pcard:hover .pcard__img{ transform:scale(1.04); }
  .pcard__title{ font-family:"Work Sans",sans-serif; font-weight:500; letter-spacing:-.015em;
    color:#000017; margin:0; line-height:1.25; transition:color .15s;
    display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
  .pcard:hover .pcard__title{ color:#D20A11; }
  .pcard--md .pcard__title{ font-size:19px; }
  .pcard--sm .pcard__title{ font-size:16.5px; -webkit-line-clamp:2; }
  .pcard--lg .pcard__title{ font-size:23px; }
  .pcard__exc{ font-family:"Inter",sans-serif; font-size:14px; line-height:1.55; color:#666; margin:0;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }

  /* ── wide / horizontal card ────────────────────────────────── */
  .wcard{ display:grid; grid-template-columns:148px 1fr; gap:18px; align-items:center;
    text-decoration:none; cursor:pointer; padding:14px; border-radius:14px; transition:background .15s; }
  .wcard:hover{ background:#F9F9F9; }
  .wcard__imgwrap{ border-radius:10px; overflow:hidden; aspect-ratio:16/11;
    background:linear-gradient(135deg,#F1F1F3,#E6E9F0); }
  .wcard__img{ width:100%; height:100%; object-fit:cover; display:block; transition:transform .5s; }
  .wcard:hover .wcard__img{ transform:scale(1.04); }
  .wcard__title{ font-family:"Work Sans",sans-serif; font-weight:500; font-size:17px;
    letter-spacing:-.01em; color:#000017; margin:7px 0 9px; line-height:1.28;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; transition:color .15s; }
  .wcard:hover .wcard__title{ color:#D20A11; }

  /* ── section heading ───────────────────────────────────────── */
  .sechead{ display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin-bottom:34px; }
  .sechead__t{ font-family:"Work Sans",sans-serif; font-weight:500; font-size:34px;
    letter-spacing:-.025em; color:#000017; margin:0; line-height:1.05; }
  .sechead__t .accent{ color:#D20A11; }
  .viewall{ display:inline-flex; align-items:center; gap:7px; flex:0 0 auto;
    font-family:"Work Sans",sans-serif; font-weight:500; font-size:14.5px; color:#000017;
    text-decoration:none; padding:9px 16px; border-radius:100px;
    box-shadow:inset 0 0 0 1px #E4E4E7; transition:all .18s cubic-bezier(.22,.61,.36,1); }
  .viewall:hover{ box-shadow:inset 0 0 0 1px #000017; transform:translateX(2px); }
  .viewall svg{ transition:transform .18s; }
  .viewall:hover svg{ transform:translateX(3px); }

  /* ── text link w/ arrow (dark) ─────────────────────────────── */
  .tlink{ display:inline-flex; align-items:center; gap:7px; font-family:"Work Sans",sans-serif;
    font-weight:500; font-size:14.5px; color:#000017; text-decoration:none; transition:gap .18s; }
  .tlink:hover{ gap:11px; }
  .tlink.on-dark{ color:#fff; }

  /* ── dark updates panel ────────────────────────────────────── */
  .upanel{ background:#000017; border-radius:20px; padding:30px 30px 22px; align-self:stretch; }
  .upanel__h{ font-family:"Work Sans",sans-serif; font-weight:500; font-size:21px;
