    // fallback la página se contaba como "sin dato" y el estado claro no se
    // activaba: es el caso de /precios, que no tiene ningún contenedor opaco arriba.
    var delBody = luminanciaDe(getComputedStyle(document.body).backgroundColor)
    return delBody === null ? 1 : delBody
