  /** Luminancia relativa aproximada de un color CSS; null si no pinta (translúcido). */
  function luminanciaDe(col) {
    var m = /rgba?\(([^)]+)\)/.exec(col)
    if (!m) return null
    var p = m[1].split(",")
    var a = p.length > 3 ? parseFloat(p[3]) : 1
    if (!(a > 0.5)) return null // translúcido: deja ver lo de atrás, no decide
    return (0.2126 * +p[0] + 0.7152 * +p[1] + 0.0722 * +p[2]) / 255
  }

