</footer><script>/* Módulo global "footer" — JS del porte de HubSpot a Nexus.
 *
 * En HubSpot el footer no tiene JS propio: sus dos selectores ("Cambiar país" y
 * "Cambiar moneda") son dropdowns de **Bootstrap**, que el tema carga aparte. En
 * una página de Nexus no hay Bootstrap JS ni Popper, así que sin este archivo los
 * dos botones no abren nada — se ven, se clickean y no pasa nada. (El porte de
 * julio no incluía JS para el footer: los selectores habrían quedado muertos.)
 *
 * Se reimplementa el dropdown en JS plano usando la MISMA clase `.show` que usa
 * Bootstrap, así el CSS del tema sirve sin tocarlo, y se replica el auto-flip de
 * Popper: el footer está al final de la página, así que el menú abre HACIA ARRIBA
 * salvo que no haya lugar, y ahí cae hacia abajo.
 *
 * Todo queda acotado al wrapper del módulo (`<div data-pxsol-global="footer">`).
 */
;(function () {
  "use strict"

  var script = document.currentScript
  var raiz = script && script.closest ? script.closest("[data-pxsol-global]") : null
  if (!raiz) return
  if (raiz.dataset.pxFooterListo === "1") return
  raiz.dataset.pxFooterListo = "1"

  var toggles = Array.prototype.slice.call(raiz.querySelectorAll('[data-bs-toggle="dropdown"]'))
  if (!toggles.length) return

  function menuDe(toggle) {
    return toggle.parentElement && toggle.parentElement.querySelector(".dropdown-menu")
  }

  function cerrar(excepto) {
    toggles.forEach(function (t) {
      if (t === excepto) return
      t.classList.remove("show")
      t.setAttribute("aria-expanded", "false")
      var m = menuDe(t)
      if (m) m.classList.remove("show", "--hacia-abajo")
    })
  }

  /**
   * Auto-flip: por CSS el menú abre hacia arriba (`bottom:100%`). Si arriba no
   * entra pero abajo sí, se le pone `--hacia-abajo`, que lo invierte.
   */
  function acomodar(toggle, menu) {
    menu.classList.remove("--hacia-abajo")
    var caja = toggle.getBoundingClientRect()
    var alto = menu.offsetHeight
    var entraArriba = caja.top >= alto
    var entraAbajo = window.innerHeight - caja.bottom >= alto
    if (!entraArriba && entraAbajo) menu.classList.add("--hacia-abajo")
  }

  toggles.forEach(function (toggle) {
    var menu = menuDe(toggle)
    if (!menu) return
    toggle.setAttribute("aria-expanded", "false")
    toggle.addEventListener("click", function (e) {
      e.preventDefault()
      e.stopPropagation()
      var abierto = menu.classList.contains("show")
      cerrar(toggle)
      if (abierto) {
        menu.classList.remove("show", "--hacia-abajo")
        toggle.classList.remove("show")
        toggle.setAttribute("aria-expanded", "false")
      } else {
        menu.classList.add("show")
        toggle.classList.add("show")
        toggle.setAttribute("aria-expanded", "true")
        acomodar(toggle, menu)
      }
    })
  })

  document.addEventListener("click", function (e) {
    if (e.target instanceof Element && e.target.closest(".dropdown")) return
    cerrar(null)
  })
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") cerrar(null)
  })
})()

/* ── Acordeón de las columnas de links, en mobile ─────────────────────────────
 *
 * Abajo de 768px el CSS del tema esconde las listas (`.px-footer__list{display:
 * none}`) y deja sólo los títulos con su chevron: cada columna —Productos,
 * Recursos, Equipo, Legales— se abre tocándola. En HubSpot eso lo hacía el
 * framework del tema con jQuery (`slideDown`), y en el porte a Nexus NO vino:
 * el resultado es que en un teléfono los links del pie NO EXISTEN. Están en el
 * HTML, escondidos, y tocar el título no hace nada. Lo reportó Sofi el
 * 14/08/2026 ("no puedo clickear y ver qué hay en Recursos") y afecta a TODAS
 * las páginas del sitio, porque el pie es un módulo global.
 *
 * Se reimplementa en JS plano, sin jQuery, reusando las clases que el CSS del
 * tema ya trae (`--rotate` para girar el chevron).
 *
 * El control es un `<button>` DENTRO del `<h3>`, no el `<h3>` con `role=
 * "button"`. Es el patrón de acordeón de WAI-ARIA (encabezado que envuelve al
 * botón) y no es un detalle: un encabezado no puede llevar `role="button"` — la
 * primera versión (14/08 → 16/09/2026) lo hacía, y PageSpeed lo marcaba en
 * «Navegación con agentes» («ARIA role should be appropriate for the element»),
 * además de sacarle el encabezado a la columna para el lector de pantalla. El
 * botón se arma acá porque el markup del módulo vive en la base y es más viejo
 * que el del repo (ver footer-links.sql): envolver los hijos del título en
 * runtime funciona con cualquier versión del HTML. Como es un botón de verdad,
 * Enter y Espacio vienen gratis y el foco se ve con el anillo del navegador.
 *
 * Arriba de 768px no hay acordeón: las listas se ven siempre, así que el JS
 * desarma el botón y se saca de encima los atributos de ARIA — un
 * `aria-expanded="false"` sobre una lista que SÍ se ve le miente al lector de
 * pantalla, y un botón que no hace nada, también.
 */
;(function () {
  "use strict"

  var script = document.currentScript
  var raiz = script && script.closest ? script.closest("[data-pxsol-global]") : null
  if (!raiz) return
  if (raiz.dataset.pxFooterAcordeon === "1") return
  raiz.dataset.pxFooterAcordeon = "1"

  var titulos = Array.prototype.slice.call(raiz.querySelectorAll(".js-accordion"))
  if (!titulos.length) return

  /* El mismo corte que usa el CSS del tema. Si cambia allá, cambia acá.
     El fallback no es para navegadores viejos (matchMedia está en todos): es
     para jsdom, donde corre `probar.mjs` y donde no existe. */
  var mql = window.matchMedia
    ? window.matchMedia("(max-width: 768px)")
    : { matches: window.innerWidth <= 768 }

  var CLASE_BOTON = "px-footer__toggle"

  /* El botón hereda la tipografía del título y ocupa todo su ancho, así se ve
     EXACTAMENTE como se veía el título solo: texto a la izquierda, chevron a la
     derecha (el h3 ya es flex + space-between en mobile por el CSS del tema). Va
     por CSSOM y no en una hoja porque el CSS del módulo también vive en la base;
     así el arreglo viaja entero en el `js`. No se toca el outline: el anillo de
     foco del navegador es justamente lo que un `<h3 role="button">` no tenía. */
  var ESTILO_BOTON =
    "display:flex;align-items:center;justify-content:space-between;width:100%;" +
    "margin:0;padding:0;border:0;background:none;font:inherit;color:inherit;" +
    "letter-spacing:inherit;text-align:inherit;cursor:pointer"

  function listaDe(titulo) {
    var id = titulo.getAttribute("data-id")
    return id ? raiz.querySelector('[id="' + id + '"]') : null
  }

  function botonDe(titulo) {
    return titulo.querySelector("button." + CLASE_BOTON)
  }

  function chevronDe(titulo) {
    return titulo.querySelector(".js-button")
  }

  function estaAbierta(lista) {
    return lista.style.display === "block"
  }

  function pintar(titulo, lista, abierta) {
    lista.style.display = abierta ? "block" : ""
    var boton = botonDe(titulo)
    if (boton) boton.setAttribute("aria-expanded", abierta ? "true" : "false")
    var chevron = chevronDe(titulo)
    if (chevron) chevron.classList.toggle("--rotate", abierta)
  }

  function alternar(titulo) {
    if (!mql.matches) return
    var lista = listaDe(titulo)
    if (!lista) return
    var abrir = !estaAbierta(lista)

    /* Una sola columna abierta por bloque, como en el tema. */
    var bloque = titulo.closest(".px-footer__groups")
    if (bloque) {
      titulos.forEach(function (otro) {
        if (otro === titulo || otro.closest(".px-footer__groups") !== bloque) return
        var suLista = listaDe(otro)
        if (suLista) pintar(otro, suLista, false)
      })
    }

    pintar(titulo, lista, abrir)
  }

  /* Envuelve TODO lo que tiene el título (texto + chevron) en un botón. */
  function armarBoton(titulo, lista) {
    if (botonDe(titulo)) return
    var boton = document.createElement("button")
    boton.type = "button"
    boton.className = CLASE_BOTON
    boton.style.cssText = ESTILO_BOTON
    if (lista.id) boton.setAttribute("aria-controls", lista.id)
    boton.setAttribute("aria-expanded", estaAbierta(lista) ? "true" : "false")
    while (titulo.firstChild) boton.appendChild(titulo.firstChild)
    titulo.appendChild(boton)
    boton.addEventListener("click", function () {
      alternar(titulo)
    })
  }

  /* Deshace armarBoton: los hijos vuelven al título y el botón desaparece. */
  function desarmarBoton(titulo) {
    var boton = botonDe(titulo)
    if (!boton) return
    while (boton.firstChild) titulo.insertBefore(boton.firstChild, boton)
    titulo.removeChild(boton)
  }

  /* El botón y sus atributos de ARIA sólo existen mientras haya acordeón. */
  function sincronizar() {
    titulos.forEach(function (titulo) {
      var lista = listaDe(titulo)
      if (!lista) return
      if (mql.matches) {
        armarBoton(titulo, lista)
      } else {
        pintar(titulo, lista, false)
        desarmarBoton(titulo)
      }
    })
  }

  sincronizar()
  if (mql.addEventListener) mql.addEventListener("change", sincronizar)
  else if (mql.addListener) mql.addListener(sincronizar)
})()
